meta {
  name: 00b Find Demo PG by Name
  type: http
  seq: 2
}

get {
  url: {{nifiBaseUrl}}/nifi-api/process-groups/{{rootPgId}}/process-groups
  auth: inherit
}

script:pre-request {
  bru.setVar('demoPgId', null);
}

script:post-response {
  if (res.status === 200) {
    const groupName = bru.getEnvVar('groupName');
    const pg = (res.body.processGroups || []).find(
      g => g.component && g.component.name === groupName
    );
    if (pg) {
      bru.setVar('demoPgId', pg.id);
    } else {
      console.log(`No PG named "${groupName}" — nothing to clean up. Stopping chain.`);
      bru.setNextRequest(null);
    }
  }
}

tests {
  test("Lookup completed (cleanup is idempotent)", function() {
    expect(res.status).to.equal(200);
  });
}
