delete {
  url: {{nifiBaseUrl}}/nifi-api/process-groups/{{demoPgId}}?version={{demoPgRevision}}&clientId=bruno-demo&disconnectedNodeAcknowledged=false
  body: none
  auth: inherit
}


tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}

docs {
  Deletes the demo PG. NiFi requires the current `version` for optimistic
  locking and a `clientId` for identifying the modifier.
}
