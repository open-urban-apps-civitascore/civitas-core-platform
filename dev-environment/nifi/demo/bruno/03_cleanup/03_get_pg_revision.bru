meta {
  name: 03 Get PG Revision (for DELETE)
  type: http
  seq: 3
}

get {
  url: {{nifiBaseUrl}}/nifi-api/process-groups/{{demoPgId}}
  auth: none
}

headers {
  Authorization: Bearer {{nifiToken}}
}

script:post-response {
  if (res.status === 200) {
    bru.setVar('demoPgRevision', res.body.revision.version);
  }
}

tests {
  test("Revision saved", function() {
    expect(bru.getVar('demoPgRevision')).to.not.be.undefined;
  });
}

docs {
  Fetches the current PG revision version — required as a query param on
  the DELETE in step 04.
}
