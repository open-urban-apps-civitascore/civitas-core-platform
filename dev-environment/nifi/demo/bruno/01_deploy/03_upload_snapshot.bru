meta {
  name: 03 Upload Flow Snapshot
  type: http
  seq: 3
}

post {
  url: {{nifiBaseUrl}}/nifi-api/process-groups/{{rootPgId}}/process-groups/upload
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{nifiToken}}
}

body:multipart-form {
  id: {{rootPgId}}
  groupName: {{groupName}}
  positionX: 200
  positionY: 200
  clientId: bruno-demo
  file: @file(../MQTT_TO_POSTGIS_demo.snapshot.json)
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
    bru.setVar('demoPgId', res.body.id);
  }
}

tests {
  test("Status 200/201", function() {
    expect([200, 201]).to.include(res.status);
  });
  test("demoPgId saved", function() {
    expect(bru.getVar('demoPgId')).to.be.a('string');
  });
}

docs {
  Uploads the checked-in Versioned-Flow-Snapshot JSON as a new Process Group
  under the root. NiFi assigns a fresh id to the PG (saved as `demoPgId`).

  All three controller services are uploaded in `DISABLED` state — they're
  enabled in step 06.

  The `Password` property of the DBCPConnectionPool is **not** in the snapshot
  (NiFi strips sensitive props at export). Step 05 sets it post-upload.
}
