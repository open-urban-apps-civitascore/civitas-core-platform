meta {
  name: 05 Set DBCP Password
  type: http
  seq: 5
}

put {
  url: {{nifiBaseUrl}}/nifi-api/controller-services/{{dbcpServiceId}}
  body: json
  auth: inherit
}

body:json {
  {
    "revision": { "version": {{dbcpRevision}}, "clientId": "bruno-demo" },
    "component": {
      "id": "{{dbcpServiceId}}",
      "properties": { "Password": "{{postgisPassword}}" }
    }
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}

docs {
  Patches the PostGISConnectionPool controller service with the runtime
  password. The DBCP password is wired in here rather than in the snapshot
  so the snapshot itself stays credential-free.
}
