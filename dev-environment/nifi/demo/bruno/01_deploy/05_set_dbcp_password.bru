meta {
  name: 05 Set DBCP Password
  type: http
  seq: 5
}

put {
  url: {{nifiBaseUrl}}/nifi-api/controller-services/{{dbcpServiceId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{nifiToken}}
}

body:json {
  {
    "revision": { "version": {{dbcpRevision}}, "clientId": "bruno-demo" },
    "component": {
      "id": "{{dbcpServiceId}}",
      "properties": { "Password": "{{postgisPassword}}" }
    }
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}

docs {
  Sensitive properties are stripped from snapshot exports. This patches the
  `Password` field on the DBCPConnectionPool post-upload, before the service
  is enabled in step 06.
}
