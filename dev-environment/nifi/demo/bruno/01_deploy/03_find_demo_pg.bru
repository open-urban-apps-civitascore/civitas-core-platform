meta {
  name: 03 Find Demo Process Group
  type: http
  seq: 3
}

get {
  url: {{nifiBaseUrl}}/nifi-api/process-groups/{{rootPgId}}/process-groups
  auth: inherit
}

script:post-response {
  if (res.status === 200) {
    const groupName = bru.getEnvVar('groupName');
    const pg = (res.body.processGroups || []).find(
      g => g.component && g.component.name === groupName
    );
    if (pg) {
      bru.setVar('demoPgId', pg.id);
    }
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Demo PG found", function() {
    expect(bru.getVar('demoPgId')).to.be.a('string');
  });
}

docs {
  Looks up the demo PG by name.

  **Precondition:** the snapshot has been uploaded via
  `dev-environment/nifi/demo/scripts/upload-snapshot.sh`. Bruno 3.3.0 strips
  the `Authorization` header on multipart-form requests, so the upload
  itself lives in a shell helper; the rest of the deploy is here.

  Stashes `demoPgId` for the subsequent steps.
}
