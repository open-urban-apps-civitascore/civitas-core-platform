# Apache NiFi (dev) — OpenID Connect authentication.
# NiFi delegates login to Keycloak; the config-adapter authenticates as the 'nifi' service account
# via the OIDC client-credentials grant.
#
# This value MUST equal the 'nifi' client secret in the Keycloak realm
# (dev-environment/keycloak/realm-export.json, client "nifi" → "secret"). To use a real secret,
# change it in BOTH places (here and the realm export) — changing only .env will break NiFi auth
# because Keycloak still expects the old secret.
#
# UPGRADING AN EXISTING DEV ENVIRONMENT (see dev-environment/nifi/MIGRATION.md): Keycloak's
# --import-realm SKIPS realms that already exist, so a pre-existing Keycloak volume never gets the
# new 'nifi' client and every token request fails with `invalid_client`. Fix once by recreating the
# Keycloak volume (`docker compose ... down -v`) OR creating the 'nifi' client by hand. Existing
# .env files also need this NIFI_OIDC_CLIENT_SECRET line added, or NiFi silently uses the dev
# default and a real secret override won't match.
NIFI_OIDC_CLIENT_SECRET=nifi-dev-secret
