meta {
  name: 05 Create Style Entry (workspace-scoped)
  type: http
  seq: 5
}

// Step 1 of 2 for WMS style:
// Creates the style metadata entry in GeoServer.
// The SLD content is uploaded in the next request (06_upload_sld).
// Using workspace-scoped styles so DELETE workspace?recurse=true cleans them up.

post {
  url: {{geoserver_url}}/rest/workspaces/{{workspace_name}}/styles
  body: json
  auth: basic
}

auth:basic {
  username: {{geoserver_admin_user}}
  password: {{geoserver_admin_password}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "style": {
      "name": "{{style_point}}",
      "filename": "{{style_point}}.sld"
    }
  }
}

tests {
  test("Style entry created", function() {
    expect(res.status).to.equal(201);
  });
}
