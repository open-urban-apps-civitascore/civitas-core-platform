meta {
  name: 03 Create FeatureType (Point — sensor_locations)
  type: http
  seq: 3
}

post {
  url: {{geoserver_url}}/rest/workspaces/{{workspace_name}}/datastores/{{datastore_name}}/featuretypes
  body: json
  auth: basic
}

auth:basic {
  username: {{geoserver_admin_user}}
  password: {{geoserver_admin_password}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "featureType": {
      "name": "{{featuretype_point}}",
      "nativeName": "{{featuretype_point}}",
      "title": "Sensor Locations",
      "abstract": "Air quality sensors across the city",
      "srs": "EPSG:4326",
      "nativeCRS": "EPSG:4326",
      "recalculate": "",
      "store": {
        "@class": "dataStore",
        "name": "{{workspace_name}}:{{datastore_name}}"
      }
    }
  }
}

tests {
  test("FeatureType created", function() {
    expect(res.status).to.equal(201);
  });
}
