meta {
  name: 05 WMS GetCapabilities
  type: http
  seq: 5
}

get {
  url: {{geoserver_url}}/{{workspace_name}}/ows?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetCapabilities
  body: none
  auth: none
}

tests {
  test("WMS endpoint responds", function() {
    expect(res.status).to.equal(200);
  });
  test("Response is XML", function() {
    expect(res.headers["content-type"]).to.include("xml");
  });
  test("Layer is listed in capabilities", function() {
    expect(res.body).to.include(bru.getEnvVar("featuretype_point"));
  });
}
