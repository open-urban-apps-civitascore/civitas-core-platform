meta {
  name: 04 OWS GetFeature (returns actual data)
  type: http
  seq: 4
}

get {
  url: {{geoserver_url}}/{{workspace_name}}/ows?SERVICE=WFS&VERSION=2.0.0&REQUEST=GetFeature&typeNames={{workspace_name}}:{{featuretype_point}}&count=10&outputFormat=application/json
  body: none
  auth: none
}

tests {
  test("GetFeature responds", function() {
    expect(res.status).to.equal(200);
  });
  test("Returns GeoJSON FeatureCollection", function() {
    expect(res.body.type).to.equal("FeatureCollection");
  });
  test("Has features", function() {
    expect(res.body.features.length).to.be.greaterThan(0);
  });
  test("Features have geometry", function() {
    const first = res.body.features[0];
    expect(first.geometry).to.not.be.null;
    expect(first.geometry.type).to.equal("Point");
  });
}
