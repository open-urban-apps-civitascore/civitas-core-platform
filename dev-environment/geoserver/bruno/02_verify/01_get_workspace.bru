meta {
  name: 01 Get Workspace
  type: http
  seq: 1
}

get {
  url: {{geoserver_url}}/rest/workspaces/{{workspace_name}}
  body: none
  auth: basic
}

auth:basic {
  username: {{geoserver_admin_user}}
  password: {{geoserver_admin_password}}
}

headers {
  Accept: application/json
}

tests {
  test("Workspace exists", function() {
    expect(res.status).to.equal(200);
  });
  test("Workspace name matches", function() {
    expect(res.body.workspace.name).to.equal(bru.getEnvVar("workspace_name"));
  });
}
