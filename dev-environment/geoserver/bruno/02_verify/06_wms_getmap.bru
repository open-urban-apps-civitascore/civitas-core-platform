meta {
  name: 06 WMS GetMap (renders image)
  type: http
  seq: 6
}

get {
  url: {{geoserver_url}}/{{workspace_name}}/ows?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&LAYERS={{workspace_name}}:{{featuretype_point}}&BBOX=13.1,52.4,13.6,52.6&WIDTH=512&HEIGHT=512&CRS=EPSG:4326&FORMAT=image/png&STYLES=
  body: none
  auth: none
}

tests {
  test("GetMap responds with image", function() {
    expect(res.status).to.equal(200);
    expect(res.headers["content-type"]).to.include("image/png");
  });
}
