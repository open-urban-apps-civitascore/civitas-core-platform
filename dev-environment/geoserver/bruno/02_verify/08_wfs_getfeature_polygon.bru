meta {
  name: 08 WFS GetFeature — Polygon (districts)
  type: http
  seq: 8
}

get {
  url: {{geoserver_url}}/{{workspace_name}}/wfs?SERVICE=WFS&VERSION=2.0.0&REQUEST=GetFeature&typeNames={{workspace_name}}:{{featuretype_polygon}}&outputFormat=application/json
  body: none
  auth: none
}

tests {
  test("GetFeature responds", function() {
    expect(res.status).to.equal(200);
  });
  test("Returns GeoJSON FeatureCollection", function() {
    expect(res.body.type).to.equal("FeatureCollection");
  });
  test("Features have Polygon geometry", function() {
    expect(res.body.features[0].geometry.type).to.include("Polygon");
  });
}
