meta {
  name: 01 Update FeatureType (e.g. new title)
  type: http
  seq: 1
}

// Used when a Data Steward updates WFS layer metadata (title, abstract, keywords).
// recalculate=nativebbox,latlonbbox forces GeoServer to re-read bounding box from PostGIS.

put {
  url: {{geoserver_url}}/rest/workspaces/{{workspace_name}}/datastores/{{datastore_name}}/featuretypes/{{featuretype_point}}?recalculate=nativebbox,latlonbbox
  body: json
  auth: basic
}

auth:basic {
  username: {{geoserver_admin_user}}
  password: {{geoserver_admin_password}}
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "featureType": {
      "title": "Sensor Locations (updated)",
      "abstract": "Air quality sensors — updated description"
    }
  }
}

tests {
  test("FeatureType updated", function() {
    expect(res.status).to.equal(200);
  });
}
