meta {
  name: 03 Delete single FeatureType (one layer removed)
  type: http
  seq: 3
}

delete {
  url: {{geoserver_url}}/rest/workspaces/{{workspace_name}}/datastores/{{datastore_name}}/featuretypes/{{featuretype_polygon}}?recurse=true
  body: none
  auth: basic
}

auth:basic {
  username: {{geoserver_admin_user}}
  password: {{geoserver_admin_password}}
}

tests {
  test("FeatureType deleted", function() {
    expect(res.status).to.equal(200);
  });
}
