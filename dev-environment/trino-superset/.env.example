# Public endpoints
TRINO_PORT=8446
TRINO_PUBLIC_URL=https://localhost:8446
SUPERSET_PORT=8092
SUPERSET_PUBLIC_URL=http://localhost:8092

# Base images
TRINO_IMAGE=trinodb/trino:484
# Local development builds the CIVITAS Superset layer on the Apache 7.0.0rc2 base image.

# Existing Keycloak
KEYCLOAK_INTERNAL_URL=http://civitas-keycloak:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=civitas-core
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DEFAULT_REALM_USER=dev@civitas.local

# Keycloak clients and groups
KEYCLOAK_TRINO_CLIENT_ID=civitas-trino
KEYCLOAK_TRINO_CLIENT_SECRET=dev-only-civitas-trino-secret
KEYCLOAK_TRINO_GROUP=trino-users
KEYCLOAK_SUPERSET_CLIENT_ID=civitas-superset
KEYCLOAK_SUPERSET_CLIENT_SECRET=dev-only-civitas-superset-secret

# Existing FROST database
FROST_DB_HOST=postgis-dev-env
FROST_DB_PORT=5432
FROST_DB_NAME=sensorthings
# Password for frost_trino_reader (least-privilege role scoped to frost_scoped.* views only —
# see dev-environment/frost/migrations/01-create-scoped-views.sql). Must match
# FROST_TRINO_READER_PASSWORD in dev-environment/frost's own .env.
FROST_TRINO_READER_PASSWORD=dev-only-frost-trino-reader-password

# Trino runtime and Superset service user
TRINO_INTERNAL_SHARED_SECRET=dev-only-civitas-trino-internal-secret
TRINO_TLS_KEYSTORE_PASSWORD=dev-only-civitas-trino-keystore-secret
TRINO_SUPERSET_SERVICE_USER=superset_trino
TRINO_SUPERSET_SERVICE_PASSWORD=dev-only-civitas-trino-superset-password

# Superset metadata database
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=dev-only-civitas-superset-db-password

# Superset bootstrap
SUPERSET_SECRET_KEY=dev-only-civitas-superset-secret-key
SUPERSET_ADMIN_USERNAME=civitas-config-adapter
SUPERSET_ADMIN_FIRSTNAME=CIVITAS
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@civitas.local
SUPERSET_ADMIN_PASSWORD=dev-only-civitas-superset-service-password
SUPERSET_SERVICE_USERNAME=civitas-config-adapter
SUPERSET_SERVICE_PASSWORD=dev-only-civitas-superset-service-password
SUPERSET_TRINO_DATABASE_NAME=CORE
SUPERSET_TRINO_URL=https://civitas-trino:8446
SUPERSET_TRINO_CATALOG=geodata
SUPERSET_TRINO_SCHEMA=information_schema
SUPERSET_TRINO_HTTP_SCHEME=https
SUPERSET_TRINO_TLS_VERIFY=false

# OPA (for DATASET_READ checks in can_access_datasource)
OPA_URL=http://civitas-opa:8181

# AuthZ Repository (for user dataset permissions in user_view_menu_names)
AUTHZ_URL=http://civitas-authz-repository:8091
