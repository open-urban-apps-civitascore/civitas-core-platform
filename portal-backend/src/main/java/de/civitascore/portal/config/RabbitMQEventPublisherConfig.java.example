      RabbitMQConfigProperties rabbitMQProperties) {

    log.info(
        "Initializing RabbitMQ CloudEvent publisher with exchange: {}",
        rabbitMQProperties.getExchange());

    // Configure Jackson for CloudEvents serialization
    rabbitTemplate.setMessageConverter(new Jackson2JsonMessageConverter());

    return new RabbitMQCloudEventPublisher(rabbitTemplate, rabbitMQProperties.getExchange());
  }

  @Bean
  @ConditionalOnProperty(name = "rabbitmq.enabled", havingValue = "true")
  public Exchange configEventsExchange(RabbitMQConfigProperties rabbitMQProperties) {
    return new TopicExchange(rabbitMQProperties.getExchange(), true, false);
  }

  @Bean
  @ConfigurationProperties(prefix = "rabbitmq")
  @Validated
  public RabbitMQConfigProperties rabbitMQConfigProperties() {
    return new RabbitMQConfigProperties();
  }

  public static class RabbitMQConfigProperties {
    private boolean enabled = false;
    private String exchange = "civitas.config.events";

    public boolean isEnabled() {
      return enabled;
    }

    public void setEnabled(boolean enabled) {
      this.enabled = enabled;
    }

    public String getExchange() {
      return exchange;
    }

    public void setExchange(String exchange) {
      this.exchange = exchange;
    }
  }
  */
}
