{
  "$schema": "https://civitasconnect.digital/core-dataset/v1",
  "id": "ds-mqtt-frost",
  "title": "MQTT to FROST",
  "description": "Subscribe to an MQTT topic and post each reading to FROST unchanged.",
  "dataStructures": {
    "SensorReading": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  },
  "mappings": [],
  "dataSources": [
    {
      "id": "mqtt-source",
      "label": "Sensor MQTT broker",
      "connectionType": "mqtt",
      "dataStructure": "SensorReading",
      "brokerUrl": "tcp://mosquitto:1883",
      "topic": "sensors/+/temp",
      "qos": 0
    }
  ],
  "dataSinks": [
    {
      "id": "frost-sink",
      "label": "FROST Things endpoint",
      "connectionType": "http",
      "dataStructure": "SensorReading",
      "url": "${FROST_BASE}/Things",
      "method": "POST",
      "contentType": "application/json"
    }
  ],
  "pipelines": [
    {
      "id": "mqtt-to-frost",
      "label": "MQTT → FROST",
      "nodes": [
        { "id": "n-source", "kind": "source", "sourceRef": "mqtt-source", "x-ui-position": { "x": 0, "y": 0 } },
        { "id": "n-sink", "kind": "sink", "sinkRef": "frost-sink", "x-ui-position": { "x": 320, "y": 0 } }
      ],
      "edges": [
        { "id": "e-source-sink", "source": "n-source", "target": "n-sink" }
      ]
    }
  ]
}
