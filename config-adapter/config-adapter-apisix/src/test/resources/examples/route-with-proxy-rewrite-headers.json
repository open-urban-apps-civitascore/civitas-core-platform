{
  "specversion": "1.0",
  "type": "core.civitas.api.route.created",
  "source": "civitas.api.provisioning",
  "id": "event-proxy-rewrite-headers-001",
  "datacontenttype": "application/json",
  "data": {
    "metadata": {
      "messageId": "msg-proxy-rewrite-headers-001",
      "timestamp": "2025-01-23T10:00:00Z",
      "source": "api.service",
      "correlationId": "corr-proxy-rewrite-headers-001",
      "configVersion": "1.0",
      "resultTopic": "api.results"
    },
    "payload": {
      "targetComponent": "apisix",
      "targetResource": "routes/my-proxy-rewrite-headers-route",
      "operation": "CREATE",
      "config": {
        "path": "routes/my-proxy-rewrite-headers-route",
        "value": {
          "uri": "/api/v1/data/*",
          "methods": ["GET", "POST"],
          "upstream_id": "my-backend-upstream",
          "plugins": {
            "proxy-rewrite": {
              "regex_uri": ["^/api/v1/data/(.*)", "/$1"],
              "headers": {
                "set": {
                  "X-Forwarded-Prefix": "/api/v1/data",
                  "X-Real-IP": "$remote_addr"
                },
                "add": {
                  "X-Request-ID": "$request_id",
                  "X-Request-Source": "gateway"
                },
                "remove": ["X-Internal-Token", "X-Debug-Mode"]
              }
            }
          }
        }
      }
    }
  }
}
