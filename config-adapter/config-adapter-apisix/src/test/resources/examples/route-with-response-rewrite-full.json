{
  "specversion": "1.0",
  "type": "de.civitascore.api.route.created",
  "source": "civitas.api.provisioning",
  "id": "event-response-rewrite-full-001",
  "datacontenttype": "application/json",
  "data": {
    "metadata": {
      "messageId": "msg-response-rewrite-full-001",
      "timestamp": "2025-01-23T10:00:00Z",
      "source": "api.service",
      "correlationId": "corr-response-rewrite-full-001",
      "configVersion": "1.0",
      "resultTopic": "api.results"
    },
    "payload": {
      "targetComponent": "apisix",
      "targetResource": "routes/my-full-response-rewrite-route",
      "operation": "CREATE",
      "config": {
        "path": "routes/my-full-response-rewrite-route",
        "value": {
          "uri": "/api/v1/full-response/*",
          "methods": ["GET", "POST", "PUT"],
          "upstream_id": "my-backend-upstream",
          "plugins": {
            "response-rewrite": {
              "status_code": 200,
              "headers": {
                "set": {
                  "X-Processed": "true",
                  "Content-Type": "application/json",
                  "X-Upstream-Status": "$upstream_status"
                },
                "remove": ["X-Internal", "X-Debug"]
              },
              "body": "{\"result\":\"success\",\"processed\":true}",
              "filters": [
                {
                  "regex": "old_text",
                  "replace": "new_text"
                },
                {
                  "regex": "internal_value",
                  "replace": "public_value"
                }
              ]
            }
          }
        }
      }
    }
  }
}
