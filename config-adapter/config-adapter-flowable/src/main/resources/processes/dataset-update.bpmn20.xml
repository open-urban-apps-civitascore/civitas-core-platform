<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://civitas.de/saga">

  <error id="stepFailedError" errorCode="STEP_FAILED"/>

  <process id="dataset-update" name="Dataset Update Saga" isExecutable="true">

    <startEvent id="start"/>

    <!-- Step 1: FROST - Update Project -->
    <serviceTask id="update-project" name="Update FROST Project"
                 flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate">
      <extensionElements>
        <flowable:field name="adapterName" stringValue="frost"/>
        <flowable:field name="operation" stringValue="UPDATE_PROJECT"/>
        <flowable:field name="stepId" stringValue="update-project"/>
      </extensionElements>
    </serviceTask>
    <boundaryEvent id="frost-error" attachedToRef="update-project">
      <errorEventDefinition errorRef="stepFailedError"/>
    </boundaryEvent>

    <!-- Step 2: APISIX - Update Route -->
    <serviceTask id="update-route" name="Update APISIX Route"
                 flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate">
      <extensionElements>
        <flowable:field name="adapterName" stringValue="apisix"/>
        <flowable:field name="operation" stringValue="UPDATE_ROUTE"/>
        <flowable:field name="stepId" stringValue="update-route"/>
      </extensionElements>
    </serviceTask>
    <boundaryEvent id="apisix-error" attachedToRef="update-route">
      <errorEventDefinition errorRef="stepFailedError"/>
    </boundaryEvent>

    <!-- Conditional gateway -->
    <exclusiveGateway id="pipeline-gateway" name="Has Pipelines?"/>

    <!-- Step 3: Redpanda - Update Pipelines (conditional) -->
    <serviceTask id="update-pipelines" name="Update Pipelines"
                 flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate">
      <extensionElements>
        <flowable:field name="adapterName" stringValue="redpanda"/>
        <flowable:field name="operation" stringValue="UPDATE_PIPELINES"/>
        <flowable:field name="stepId" stringValue="update-pipelines"/>
      </extensionElements>
    </serviceTask>
    <boundaryEvent id="redpanda-error" attachedToRef="update-pipelines">
      <errorEventDefinition errorRef="stepFailedError"/>
    </boundaryEvent>

    <!-- Compensation: RESTORE operations (reverse order) -->

    <!-- After step 2 failure: restore step 1 -->
    <serviceTask id="compensate-frost-after-apisix" name="Compensate: Restore FROST Project"
                 flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaCompensationDelegate">
      <extensionElements>
        <flowable:field name="adapterName" stringValue="frost"/>
        <flowable:field name="operation" stringValue="RESTORE_PROJECT"/>
        <flowable:field name="stepId" stringValue="update-project"/>
      </extensionElements>
    </serviceTask>

    <!-- After step 3 failure: restore step 2, then step 1 -->
    <serviceTask id="compensate-apisix-after-redpanda" name="Compensate: Restore APISIX Route"
                 flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaCompensationDelegate">
      <extensionElements>
        <flowable:field name="adapterName" stringValue="apisix"/>
        <flowable:field name="operation" stringValue="RESTORE_ROUTE"/>
        <flowable:field name="stepId" stringValue="update-route"/>
      </extensionElements>
    </serviceTask>
    <serviceTask id="compensate-frost-after-redpanda" name="Compensate: Restore FROST Project"
                 flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaCompensationDelegate">
      <extensionElements>
        <flowable:field name="adapterName" stringValue="frost"/>
        <flowable:field name="operation" stringValue="RESTORE_PROJECT"/>
        <flowable:field name="stepId" stringValue="update-project"/>
      </extensionElements>
    </serviceTask>

    <!-- Result publishing -->
    <serviceTask id="publish-success" flowable:async="true" name="Publish Success Result"
                 flowable:class="de.civitascore.configadapter.flowable.common.delegate.ResultPublishDelegate">
      <extensionElements>
        <flowable:field name="resultType" stringValue="success"/>
      </extensionElements>
    </serviceTask>
    <serviceTask id="publish-failure" flowable:async="true" name="Publish Failure Result"
                 flowable:class="de.civitascore.configadapter.flowable.common.delegate.ResultPublishDelegate">
      <extensionElements>
        <flowable:field name="resultType" stringValue="failure"/>
      </extensionElements>
    </serviceTask>

    <endEvent id="end"/>
    <endEvent id="error-end" name="Saga Failed"/>

    <!-- Happy path -->
    <sequenceFlow id="flow-start" sourceRef="start" targetRef="update-project"/>
    <sequenceFlow id="flow-frost-apisix" sourceRef="update-project" targetRef="update-route"/>
    <sequenceFlow id="flow-apisix-gateway" sourceRef="update-route" targetRef="pipeline-gateway"/>
    <sequenceFlow id="flow-gateway-redpanda" sourceRef="pipeline-gateway" targetRef="update-pipelines">
      <conditionExpression xsi:type="tFormalExpression">${hasPipelines == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-gateway-skip" sourceRef="pipeline-gateway" targetRef="publish-success">
      <conditionExpression xsi:type="tFormalExpression">${hasPipelines == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-redpanda-success" sourceRef="update-pipelines" targetRef="publish-success"/>
    <sequenceFlow id="flow-publish-success-end" sourceRef="publish-success" targetRef="end"/>

    <!-- Error: step 1 fails (nothing to compensate) -->
    <sequenceFlow id="flow-frost-error" sourceRef="frost-error" targetRef="publish-failure"/>

    <!-- Error: step 2 fails → restore step 1 -->
    <sequenceFlow id="flow-apisix-error" sourceRef="apisix-error" targetRef="compensate-frost-after-apisix"/>
    <sequenceFlow id="flow-comp-frost-after-apisix" sourceRef="compensate-frost-after-apisix" targetRef="publish-failure"/>

    <!-- Error: step 3 fails → restore step 2, then step 1 -->
    <sequenceFlow id="flow-redpanda-error" sourceRef="redpanda-error" targetRef="compensate-apisix-after-redpanda"/>
    <sequenceFlow id="flow-comp-apisix" sourceRef="compensate-apisix-after-redpanda" targetRef="compensate-frost-after-redpanda"/>
    <sequenceFlow id="flow-comp-frost" sourceRef="compensate-frost-after-redpanda" targetRef="publish-failure"/>

    <sequenceFlow id="flow-publish-failure-end" sourceRef="publish-failure" targetRef="error-end"/>

  </process>

</definitions>
