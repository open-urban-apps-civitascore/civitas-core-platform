<?xml version="1.0" encoding="UTF-8"?>
<!-- origin at X=0.0 Y=0.0 -->
<definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" id="Definitions_1" exporter="org.eclipse.bpmn2.modeler.core" exporterVersion="1.5.4.RC1-v20220528-0836-B1" targetNamespace="http://civitas.de/saga">
  <error id="stepFailedError" name="Step Failed" errorCode="STEP_FAILED"/>
  <process id="dataset-delete" name="Dataset Delete Saga" isExecutable="true">
    <startEvent id="start" name="Start">
      <outgoing>flow-start</outgoing>
    </startEvent>
    <exclusiveGateway id="pipeline-gateway" name="Has Pipelines?">
      <incoming>flow-start</incoming>
      <outgoing>flow-gateway-redpanda</outgoing>
      <outgoing>flow-gateway-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="delete-pipelines" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Delete Pipelines">
      <extensionElements>
        <flowable:field name="adapterName" stringValue="redpanda"/>
        <flowable:field name="operation" stringValue="DELETE_PIPELINES"/>
        <flowable:field name="stepId" stringValue="delete-pipelines"/>
      </extensionElements>
      <incoming>flow-gateway-redpanda</incoming>
      <outgoing>flow-redpanda-apisix</outgoing>
    </serviceTask>
    <boundaryEvent id="redpanda-error" name="Step Failed" attachedToRef="delete-pipelines">
      <outgoing>flow-redpanda-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_1" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="delete-route" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Delete APISIX Route">
      <extensionElements>
        <flowable:field name="adapterName" stringValue="apisix"/>
        <flowable:field name="operation" stringValue="DELETE_ROUTE"/>
        <flowable:field name="stepId" stringValue="delete-route"/>
      </extensionElements>
      <incoming>flow-gateway-skip</incoming>
      <incoming>flow-redpanda-apisix</incoming>
      <incoming>flow-redpanda-error</incoming>
      <outgoing>flow-apisix-frost</outgoing>
    </serviceTask>
    <boundaryEvent id="apisix-error" name="Step Failed" attachedToRef="delete-route">
      <outgoing>flow-apisix-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_2" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="delete-project" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Delete FROST Project">
      <extensionElements>
        <flowable:field name="adapterName" stringValue="frost"/>
        <flowable:field name="operation" stringValue="DELETE_PROJECT"/>
        <flowable:field name="stepId" stringValue="delete-project"/>
      </extensionElements>
      <incoming>flow-apisix-frost</incoming>
      <incoming>flow-apisix-error</incoming>
      <outgoing>flow-frost-result</outgoing>
    </serviceTask>
    <boundaryEvent id="frost-error" name="Step Failed" attachedToRef="delete-project">
      <outgoing>flow-frost-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_3" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="publish-success" flowable:async="true" flowable:class="de.civitascore.configadapter.flowable.common.delegate.ResultPublishDelegate" name="Publish Success">
      <extensionElements>
        <flowable:field name="resultType" stringValue="success"/>
      </extensionElements>
      <incoming>flow-result-success</incoming>
      <outgoing>flow-publish-success-end</outgoing>
    </serviceTask>
    <serviceTask id="publish-failure" flowable:async="true" flowable:class="de.civitascore.configadapter.flowable.common.delegate.ResultPublishDelegate" name="Publish Failure">
      <extensionElements>
        <flowable:field name="resultType" stringValue="failure"/>
        <flowable:field name="supportsCompensation" stringValue="false"/>
      </extensionElements>
      <incoming>flow-result-failure</incoming>
      <outgoing>flow-publish-failure-end</outgoing>
    </serviceTask>
    <exclusiveGateway id="result-merge">
      <incoming>flow-frost-result</incoming>
      <incoming>flow-frost-error</incoming>
      <outgoing>flow-merge-to-gateway</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="result-gateway" name="Has Errors?" default="flow-result-success">
      <incoming>flow-merge-to-gateway</incoming>
      <outgoing>flow-result-failure</outgoing>
      <outgoing>flow-result-success</outgoing>
    </exclusiveGateway>
    <endEvent id="end" name="Saga Completed">
      <incoming>flow-publish-success-end</incoming>
      <incoming>flow-publish-failure-end</incoming>
    </endEvent>
    <sequenceFlow id="flow-start" sourceRef="start" targetRef="pipeline-gateway"/>
    <sequenceFlow id="flow-gateway-redpanda" name="yes" sourceRef="pipeline-gateway" targetRef="delete-pipelines">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_1">${hasPipelines == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-gateway-skip" name="no" sourceRef="pipeline-gateway" targetRef="delete-route">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_2">${hasPipelines == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-redpanda-apisix" sourceRef="delete-pipelines" targetRef="delete-route"/>
    <sequenceFlow id="flow-apisix-frost" sourceRef="delete-route" targetRef="delete-project"/>
    <sequenceFlow id="flow-frost-result" sourceRef="delete-project" targetRef="result-merge"/>
    <sequenceFlow id="flow-merge-to-gateway" sourceRef="result-merge" targetRef="result-gateway"/>
    <sequenceFlow id="flow-result-failure" name="has error" sourceRef="result-gateway" targetRef="publish-failure">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_3">${execution.getVariable('sagaError') != null}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-result-success" name="ok" sourceRef="result-gateway" targetRef="publish-success"/>
    <sequenceFlow id="flow-publish-success-end" sourceRef="publish-success" targetRef="end"/>
    <sequenceFlow id="flow-publish-failure-end" sourceRef="publish-failure" targetRef="end"/>
    <sequenceFlow id="flow-redpanda-error" sourceRef="redpanda-error" targetRef="delete-route"/>
    <sequenceFlow id="flow-apisix-error" sourceRef="apisix-error" targetRef="delete-project"/>
    <sequenceFlow id="flow-frost-error" sourceRef="frost-error" targetRef="result-merge"/>
  </process>
