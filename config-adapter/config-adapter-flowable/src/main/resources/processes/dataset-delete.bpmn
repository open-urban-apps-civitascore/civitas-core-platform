<definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xs="http://www.w3.org/2001/XMLSchema" id="Definitions_1" exporter="org.eclipse.bpmn2.modeler.core" exporterVersion="1.5.4.RC1-v20220528-0836-B1" targetNamespace="http://civitas.de/saga">
  <error id="stepFailedError" errorCode="STEP_FAILED" name="Step Failed"/>
  <process id="dataset-delete" name="Dataset Delete Saga" isExecutable="true">
    <startEvent id="start" name="Start">
      <outgoing>flow-start</outgoing>
    </startEvent>
    <exclusiveGateway id="pipeline-gateway" name="Has Pipelines?" default="flow-gateway-skip">
      <incoming>flow-start</incoming>
      <outgoing>flow-gateway-redpanda</outgoing>
      <outgoing>flow-gateway-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="delete-pipelines" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Delete Pipelines">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="nifi"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DELETE_PIPELINES"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="delete-pipelines"/>
      </extensionElements>
      <incoming>flow-gateway-redpanda</incoming>
      <outgoing>flow-redpanda-apisix</outgoing>
    </serviceTask>
    <boundaryEvent id="redpanda-error" name="Step Failed" attachedToRef="delete-pipelines">
      <outgoing>flow-redpanda-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_1" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="delete-route" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Delete APISIX Route">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="apisix"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DELETE_ROUTE"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="delete-route"/>
      </extensionElements>
      <incoming>flow-gateway-skip</incoming>
      <incoming>flow-redpanda-apisix</incoming>
      <incoming>flow-redpanda-error</incoming>
      <outgoing>flow-apisix-geo</outgoing>
    </serviceTask>
    <boundaryEvent id="apisix-error" name="Step Failed" attachedToRef="delete-route">
      <outgoing>flow-apisix-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_2" errorRef="stepFailedError"/>
    </boundaryEvent>
    <exclusiveGateway id="geo-gateway" name="Has Geo Sink?" default="flow-geo-skip">
      <incoming>flow-apisix-geo</incoming>
      <incoming>flow-apisix-error</incoming>
      <outgoing>flow-geo-workspace</outgoing>
      <outgoing>flow-geo-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="delete-workspace" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Delete GeoServer Workspace">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="geoserver"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DELETE_WORKSPACE"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="delete-workspace"/>
      </extensionElements>
      <incoming>flow-geo-workspace</incoming>
      <outgoing>flow-workspace-sink</outgoing>
    </serviceTask>
    <boundaryEvent id="workspace-error" name="Step Failed" attachedToRef="delete-workspace">
      <outgoing>SequenceFlow_5</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_4" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="deprovision-sink" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Deprovision PostGIS Sink">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="postgis"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DEPROVISION_SINK"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="deprovision-sink"/>
      </extensionElements>
      <incoming>flow-workspace-sink</incoming>
      <incoming>SequenceFlow_5</incoming>
      <outgoing>flow-sink-frost</outgoing>
    </serviceTask>
    <boundaryEvent id="deprovision-sink-error" name="Step Failed" attachedToRef="deprovision-sink">
      <outgoing>flow-sink-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_5" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="delete-project" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Delete FROST Project">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="frost"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DELETE_PROJECT"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="delete-project"/>
      </extensionElements>
      <incoming>flow-geo-skip</incoming>
      <incoming>flow-sink-frost</incoming>
      <incoming>flow-sink-error</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </serviceTask>
    <boundaryEvent id="frost-error" name="Step Failed" attachedToRef="delete-project">
      <outgoing>SequenceFlow_3</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_3" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="publish-success" flowable:async="true" flowable:class="de.civitascore.configadapter.flowable.common.delegate.ResultPublishDelegate" name="Publish Success">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="resultType" stringValue="success"/>
      </extensionElements>
      <incoming>flow-result-success</incoming>
      <outgoing>flow-publish-success-end</outgoing>
    </serviceTask>
    <serviceTask id="publish-failure" flowable:async="true" flowable:class="de.civitascore.configadapter.flowable.common.delegate.ResultPublishDelegate" name="Publish Failure">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="resultType" stringValue="failure"/>
        <flowable:field xsi:type="xs:anyType" name="supportsCompensation" stringValue="false"/>
      </extensionElements>
      <incoming>flow-result-failure</incoming>
      <outgoing>flow-publish-failure-end</outgoing>
    </serviceTask>
    <exclusiveGateway id="result-gateway" name="Has Errors?" default="flow-result-success">
      <incoming>SequenceFlow_3</incoming>
      <incoming>SequenceFlow_4</incoming>
      <outgoing>flow-result-failure</outgoing>
      <outgoing>flow-result-success</outgoing>
    </exclusiveGateway>
    <endEvent id="end" name="Saga Completed">
      <incoming>flow-publish-success-end</incoming>
      <incoming>flow-publish-failure-end</incoming>
    </endEvent>
    <sequenceFlow id="flow-start" sourceRef="start" targetRef="pipeline-gateway"/>
    <sequenceFlow id="flow-gateway-redpanda" name="yes" sourceRef="pipeline-gateway" targetRef="delete-pipelines">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_1">${hasPipelines == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-gateway-skip" name="no" sourceRef="pipeline-gateway" targetRef="delete-route"/>
    <sequenceFlow id="flow-redpanda-apisix" sourceRef="delete-pipelines" targetRef="delete-route"/>
    <sequenceFlow id="flow-apisix-geo" sourceRef="delete-route" targetRef="geo-gateway"/>
    <sequenceFlow id="flow-geo-workspace" name="yes" sourceRef="geo-gateway" targetRef="delete-workspace">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_2">${execution.getVariable('hasGeoSink') == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-geo-skip" name="no" sourceRef="geo-gateway" targetRef="delete-project"/>
    <sequenceFlow id="flow-workspace-sink" sourceRef="delete-workspace" targetRef="deprovision-sink"/>
    <sequenceFlow id="flow-sink-frost" sourceRef="deprovision-sink" targetRef="delete-project"/>
    <sequenceFlow id="flow-sink-error" sourceRef="deprovision-sink-error" targetRef="delete-project"/>
    <sequenceFlow id="flow-result-failure" name="has error" sourceRef="result-gateway" targetRef="publish-failure">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_3">${execution.getVariable('sagaError') != null}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-result-success" name="ok" sourceRef="result-gateway" targetRef="publish-success"/>
    <sequenceFlow id="flow-publish-success-end" sourceRef="publish-success" targetRef="end"/>
    <sequenceFlow id="flow-publish-failure-end" sourceRef="publish-failure" targetRef="end"/>
    <sequenceFlow id="flow-redpanda-error" sourceRef="redpanda-error" targetRef="delete-route"/>
    <sequenceFlow id="flow-apisix-error" sourceRef="apisix-error" targetRef="geo-gateway"/>
    <sequenceFlow id="SequenceFlow_3" sourceRef="frost-error" targetRef="result-gateway"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="delete-project" targetRef="result-gateway"/>
    <sequenceFlow id="SequenceFlow_5" sourceRef="workspace-error" targetRef="deprovision-sink"/>
  </process>
