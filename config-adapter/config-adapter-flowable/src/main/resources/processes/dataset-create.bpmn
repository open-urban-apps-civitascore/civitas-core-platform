<?xml version="1.0" encoding="UTF-8"?>
<!-- origin at X=-10.0 Y=0.0 -->
<definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xs="http://www.w3.org/2001/XMLSchema" id="Definitions_1" exporter="org.eclipse.bpmn2.modeler.core" exporterVersion="1.5.4.RC1-v20220528-0836-B1" targetNamespace="http://civitas.de/saga">
  <error id="stepFailedError" errorCode="STEP_FAILED" name="Step Failed"/>
  <process id="dataset-create" name="Dataset Create Saga" isExecutable="true">
    <startEvent id="start" name="Start">
      <outgoing>flow-start</outgoing>
    </startEvent>
    <serviceTask id="create-project" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Create FROST Project">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="frost"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="CREATE_PROJECT"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-project"/>
      </extensionElements>
      <incoming>flow-start</incoming>
      <outgoing>flow-frost-apisix</outgoing>
    </serviceTask>
    <boundaryEvent id="frost-error" name="Step Failed" attachedToRef="create-project">
      <outgoing>flow-frost-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_1" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="create-route" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Create APISIX Route">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="apisix"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="CREATE_ROUTE"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-route"/>
      </extensionElements>
      <incoming>flow-frost-apisix</incoming>
      <outgoing>flow-apisix-geo</outgoing>
    </serviceTask>
    <boundaryEvent id="apisix-error" name="Step Failed" attachedToRef="create-route">
      <outgoing>flow-apisix-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_2" errorRef="stepFailedError"/>
    </boundaryEvent>
    <exclusiveGateway id="geo-gateway" name="Has Geo Sink?" default="flow-geo-skip">
      <incoming>flow-apisix-geo</incoming>
      <outgoing>flow-geo-workspace</outgoing>
      <outgoing>flow-geo-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="create-workspace" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Create GeoServer Workspace">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="geoserver"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="CREATE_WORKSPACE"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-workspace"/>
      </extensionElements>
      <incoming>flow-geo-workspace</incoming>
      <outgoing>flow-workspace-datastore</outgoing>
    </serviceTask>
    <boundaryEvent id="workspace-error" name="Step Failed" attachedToRef="create-workspace">
      <outgoing>flow-workspace-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_4" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="create-datastore" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Create GeoServer Datastore">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="geoserver"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="CREATE_DATASTORE"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-datastore"/>
      </extensionElements>
      <incoming>flow-workspace-datastore</incoming>
      <outgoing>flow-datastore-layers-gateway</outgoing>
    </serviceTask>
    <boundaryEvent id="datastore-error" name="Step Failed" attachedToRef="create-datastore">
      <outgoing>flow-datastore-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_5" errorRef="stepFailedError"/>
    </boundaryEvent>
    <exclusiveGateway id="layers-gateway" name="Has Layers?" default="flow-layers-skip">
      <incoming>flow-datastore-layers-gateway</incoming>
      <outgoing>flow-layers-provision</outgoing>
      <outgoing>flow-layers-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="provision-layers" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Provision GeoServer Layers">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="geoserver"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="PROVISION_LAYERS"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="provision-layers"/>
      </extensionElements>
      <incoming>flow-layers-provision</incoming>
      <outgoing>flow-layers-pipeline</outgoing>
    </serviceTask>
    <boundaryEvent id="layers-error" name="Step Failed" attachedToRef="provision-layers">
      <outgoing>flow-layers-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_6" errorRef="stepFailedError"/>
    </boundaryEvent>
    <exclusiveGateway id="pipeline-gateway" name="Has Pipelines?" default="flow-gateway-skip">
      <incoming>flow-geo-skip</incoming>
      <incoming>flow-layers-skip</incoming>
      <incoming>flow-layers-pipeline</incoming>
      <outgoing>flow-gateway-redpanda</outgoing>
      <outgoing>flow-gateway-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="deploy-pipelines" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Deploy Pipelines">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="redpanda"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DEPLOY_PIPELINES"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="deploy-pipelines"/>
      </extensionElements>
      <incoming>flow-gateway-redpanda</incoming>
      <outgoing>flow-redpanda-success</outgoing>
    </serviceTask>
    <boundaryEvent id="redpanda-error" name="Step Failed" attachedToRef="deploy-pipelines">
      <outgoing>flow-redpanda-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_3" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="compensate-geoserver" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaCompensationDelegate" name="Compensate: Delete GeoServer Workspace">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="geoserver"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DELETE_WORKSPACE"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-workspace"/>
      </extensionElements>
      <incoming>flow-workspace-error</incoming>
      <incoming>flow-datastore-error</incoming>
      <incoming>flow-layers-error</incoming>
      <incoming>flow-redpanda-error</incoming>
      <outgoing>flow-comp-geoserver-apisix</outgoing>
    </serviceTask>
    <serviceTask id="compensate-apisix" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaCompensationDelegate" name="Compensate: Delete APISIX Route">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="apisix"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DELETE_ROUTE"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-route"/>
      </extensionElements>
      <incoming>flow-comp-geoserver-apisix</incoming>
      <outgoing>flow-comp-apisix-frost</outgoing>
    </serviceTask>
    <serviceTask id="compensate-frost" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaCompensationDelegate" name="Compensate: Delete FROST Project">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="frost"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DELETE_PROJECT"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-project"/>
      </extensionElements>
      <incoming>flow-apisix-error</incoming>
      <incoming>flow-comp-apisix-frost</incoming>
      <outgoing>flow-comp-frost-fail</outgoing>
    </serviceTask>
    <serviceTask id="publish-success" flowable:async="true" flowable:class="de.civitascore.configadapter.flowable.common.delegate.ResultPublishDelegate" name="Publish Success Result">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="resultType" stringValue="success"/>
      </extensionElements>
      <incoming>flow-gateway-skip</incoming>
      <incoming>flow-redpanda-success</incoming>
      <outgoing>flow-publish-success-end</outgoing>
    </serviceTask>
    <serviceTask id="publish-failure" flowable:async="true" flowable:class="de.civitascore.configadapter.flowable.common.delegate.ResultPublishDelegate" name="Publish Failure Result">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="resultType" stringValue="failure"/>
      </extensionElements>
      <incoming>flow-frost-error</incoming>
      <incoming>flow-comp-frost-fail</incoming>
      <outgoing>flow-publish-failure-end</outgoing>
    </serviceTask>
    <endEvent id="end" name="Saga Completed">
      <incoming>flow-publish-success-end</incoming>
    </endEvent>
    <endEvent id="error-end" name="Saga Failed">
      <incoming>flow-publish-failure-end</incoming>
    </endEvent>
    <sequenceFlow id="flow-start" sourceRef="start" targetRef="create-project"/>
    <sequenceFlow id="flow-frost-apisix" sourceRef="create-project" targetRef="create-route"/>
    <sequenceFlow id="flow-apisix-geo" sourceRef="create-route" targetRef="geo-gateway"/>
    <sequenceFlow id="flow-geo-workspace" name="yes" sourceRef="geo-gateway" targetRef="create-workspace">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_1">${execution.getVariable('hasGeoSink') == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-geo-skip" name="no" sourceRef="geo-gateway" targetRef="pipeline-gateway"/>
    <sequenceFlow id="flow-workspace-datastore" sourceRef="create-workspace" targetRef="create-datastore"/>
    <sequenceFlow id="flow-datastore-layers-gateway" sourceRef="create-datastore" targetRef="layers-gateway"/>
    <sequenceFlow id="flow-layers-provision" name="yes" sourceRef="layers-gateway" targetRef="provision-layers">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_2">${execution.getVariable('hasLayers') == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-layers-skip" name="no" sourceRef="layers-gateway" targetRef="pipeline-gateway"/>
    <sequenceFlow id="flow-layers-pipeline" sourceRef="provision-layers" targetRef="pipeline-gateway"/>
    <sequenceFlow id="flow-gateway-redpanda" name="yes" sourceRef="pipeline-gateway" targetRef="deploy-pipelines">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_3">${hasPipelines == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-gateway-skip" name="no" sourceRef="pipeline-gateway" targetRef="publish-success"/>
    <sequenceFlow id="flow-redpanda-success" sourceRef="deploy-pipelines" targetRef="publish-success"/>
    <sequenceFlow id="flow-publish-success-end" sourceRef="publish-success" targetRef="end"/>
    <sequenceFlow id="flow-frost-error" sourceRef="frost-error" targetRef="publish-failure"/>
    <sequenceFlow id="flow-apisix-error" sourceRef="apisix-error" targetRef="compensate-frost"/>
    <sequenceFlow id="flow-workspace-error" sourceRef="workspace-error" targetRef="compensate-geoserver"/>
    <sequenceFlow id="flow-datastore-error" sourceRef="datastore-error" targetRef="compensate-geoserver"/>
    <sequenceFlow id="flow-layers-error" sourceRef="layers-error" targetRef="compensate-geoserver"/>
    <sequenceFlow id="flow-redpanda-error" sourceRef="redpanda-error" targetRef="compensate-geoserver"/>
    <sequenceFlow id="flow-comp-geoserver-apisix" sourceRef="compensate-geoserver" targetRef="compensate-apisix"/>
    <sequenceFlow id="flow-comp-apisix-frost" sourceRef="compensate-apisix" targetRef="compensate-frost"/>
    <sequenceFlow id="flow-comp-frost-fail" sourceRef="compensate-frost" targetRef="publish-failure"/>
    <sequenceFlow id="flow-publish-failure-end" sourceRef="publish-failure" targetRef="error-end"/>
  </process>
