<?xml version="1.0" encoding="UTF-8"?>
<!-- origin at X=0.0 Y=0.0 -->
<definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xs="http://www.w3.org/2001/XMLSchema" id="Definitions_1" exporter="org.eclipse.bpmn2.modeler.core" exporterVersion="1.5.4.RC1-v20220528-0836-B1" targetNamespace="http://civitas.de/saga">
  <error id="stepFailedError" errorCode="STEP_FAILED" name="Step Failed"/>
  <process id="dataset-create" name="Dataset Create Saga" isExecutable="true">
    <startEvent id="start" name="Start">
      <outgoing>flow-start</outgoing>
    </startEvent>
    <exclusiveGateway id="frost-gateway" name="Has FROST Sink?" default="flow-frost-skip">
      <incoming>flow-start</incoming>
      <outgoing>flow-frost-create</outgoing>
      <outgoing>flow-frost-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="create-project" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Create FROST Project">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="frost"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="CREATE_PROJECT"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-project"/>
      </extensionElements>
      <incoming>flow-frost-create</incoming>
      <outgoing>flow-frost-apisix</outgoing>
    </serviceTask>
    <boundaryEvent id="frost-error" name="Step Failed" attachedToRef="create-project">
      <outgoing>flow-frost-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_1" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="create-route" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Create APISIX Route">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="apisix"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="CREATE_ROUTE"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-route"/>
      </extensionElements>
      <incoming>flow-frost-apisix</incoming>
      <incoming>flow-frost-skip</incoming>
      <outgoing>flow-apisix-geo</outgoing>
    </serviceTask>
    <boundaryEvent id="apisix-error" name="Step Failed" attachedToRef="create-route">
      <outgoing>flow-apisix-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_2" errorRef="stepFailedError"/>
    </boundaryEvent>
    <exclusiveGateway id="geo-gateway" name="Has Geo Sink?" default="flow-geo-skip">
      <incoming>flow-apisix-geo</incoming>
      <outgoing>flow-geo-sink</outgoing>
      <outgoing>flow-geo-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="provision-sink" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Provision PostGIS Sink">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="postgis"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="PROVISION_SINK"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="provision-sink"/>
      </extensionElements>
      <incoming>flow-geo-sink</incoming>
      <outgoing>flow-sink-workspace</outgoing>
    </serviceTask>
    <boundaryEvent id="provision-sink-error" name="Step Failed" attachedToRef="provision-sink">
      <outgoing>flow-sink-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_7" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="create-workspace" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Create GeoServer Workspace">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="geoserver"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="CREATE_WORKSPACE"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-workspace"/>
      </extensionElements>
      <incoming>flow-sink-workspace</incoming>
      <outgoing>flow-workspace-datastore</outgoing>
    </serviceTask>
    <boundaryEvent id="workspace-error" name="Step Failed" attachedToRef="create-workspace">
      <outgoing>flow-workspace-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_4" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="create-datastore" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Create GeoServer Datastore">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="geoserver"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="CREATE_DATASTORE"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-datastore"/>
      </extensionElements>
      <incoming>flow-workspace-datastore</incoming>
      <outgoing>flow-datastore-layers-gateway</outgoing>
    </serviceTask>
    <boundaryEvent id="datastore-error" name="Step Failed" attachedToRef="create-datastore">
      <outgoing>flow-datastore-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_5" errorRef="stepFailedError"/>
    </boundaryEvent>
    <exclusiveGateway id="layers-gateway" name="Has Layers?" default="flow-layers-skip">
      <incoming>flow-datastore-layers-gateway</incoming>
      <outgoing>flow-layers-provision</outgoing>
      <outgoing>flow-layers-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="provision-layers" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Provision GeoServer Layers">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="geoserver"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="PROVISION_LAYERS"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="provision-layers"/>
      </extensionElements>
      <incoming>flow-layers-provision</incoming>
      <outgoing>flow-layers-pipeline</outgoing>
    </serviceTask>
    <boundaryEvent id="layers-error" name="Step Failed" attachedToRef="provision-layers">
      <outgoing>flow-layers-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_6" errorRef="stepFailedError"/>
    </boundaryEvent>
    <exclusiveGateway id="pipeline-gateway" name="Has Pipelines?" default="flow-gateway-skip">
      <incoming>flow-geo-skip</incoming>
      <incoming>flow-layers-skip</incoming>
      <incoming>flow-layers-pipeline</incoming>
      <outgoing>flow-gateway-pipeline</outgoing>
      <outgoing>flow-gateway-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="deploy-pipelines" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Deploy Pipelines">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="nifi"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DEPLOY_PIPELINES"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="deploy-pipelines"/>
      </extensionElements>
      <incoming>flow-gateway-pipeline</incoming>
      <outgoing>flow-pipeline-success</outgoing>
    </serviceTask>
    <boundaryEvent id="pipeline-error" name="Step Failed" attachedToRef="deploy-pipelines">
      <outgoing>flow-pipeline-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_3" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="compensate-pipelines" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaCompensationDelegate" name="Compensate: Delete NiFi Pipelines">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="nifi"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DELETE_PIPELINES"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="deploy-pipelines"/>
      </extensionElements>
      <incoming>flow-pipeline-error</incoming>
      <incoming>flow-prune-comp-pipelines</incoming>
      <outgoing>flow-comp-pipelines-gateway</outgoing>
    </serviceTask>
    <exclusiveGateway id="pipeline-comp-gateway" name="Compensate GeoServer?" default="flow-pipeline-comp-apisix">
      <incoming>flow-comp-pipelines-gateway</incoming>
      <outgoing>flow-pipeline-comp-geo</outgoing>
      <outgoing>flow-pipeline-comp-apisix</outgoing>
    </exclusiveGateway>
    <serviceTask id="compensate-geoserver" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaCompensationDelegate" name="Compensate: Delete GeoServer Workspace">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="geoserver"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DELETE_WORKSPACE"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-workspace"/>
      </extensionElements>
      <incoming>flow-workspace-error</incoming>
      <incoming>flow-datastore-error</incoming>
      <incoming>flow-layers-error</incoming>
      <incoming>flow-pipeline-comp-geo</incoming>
      <incoming>flow-prune-comp-geo</incoming>
      <outgoing>flow-comp-geoserver-sink</outgoing>
    </serviceTask>
    <serviceTask id="compensate-sink" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaCompensationDelegate" name="Compensate: Deprovision PostGIS Sink">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="postgis"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DEPROVISION_SINK"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="provision-sink"/>
      </extensionElements>
      <incoming>flow-comp-geoserver-sink</incoming>
      <outgoing>flow-comp-sink-apisix</outgoing>
    </serviceTask>
    <serviceTask id="compensate-apisix" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaCompensationDelegate" name="Compensate: Delete APISIX Route">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="apisix"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DELETE_ROUTE"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-route"/>
      </extensionElements>
      <incoming>flow-comp-sink-apisix</incoming>
      <incoming>flow-pipeline-comp-apisix</incoming>
      <incoming>flow-sink-error</incoming>
      <incoming>flow-prune-comp-apisix</incoming>
      <outgoing>flow-comp-apisix-frost</outgoing>
    </serviceTask>
    <exclusiveGateway id="frost-comp-gateway" name="Compensate FROST Project?" default="flow-frost-comp-skip">
      <incoming>flow-apisix-error</incoming>
      <incoming>flow-comp-apisix-frost</incoming>
      <outgoing>flow-frost-comp-delete</outgoing>
      <outgoing>flow-frost-comp-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="compensate-frost" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaCompensationDelegate" name="Compensate: Delete FROST Project">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="frost"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DELETE_PROJECT"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="create-project"/>
      </extensionElements>
      <incoming>flow-frost-comp-delete</incoming>
      <outgoing>flow-comp-frost-fail</outgoing>
    </serviceTask>
    <exclusiveGateway id="prune-gateway" name="Has Geo Sink?" default="flow-prune-skip">
      <incoming>flow-gateway-skip</incoming>
      <incoming>flow-pipeline-success</incoming>
      <outgoing>flow-prune-featuretypes</outgoing>
      <outgoing>flow-prune-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="prune-featuretypes" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Prune Stale GeoServer Feature Types">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="geoserver"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="PRUNE_FEATURE_TYPES"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="prune-featuretypes"/>
      </extensionElements>
      <incoming>flow-prune-featuretypes</incoming>
      <outgoing>flow-prune-success</outgoing>
    </serviceTask>
    <boundaryEvent id="prune-error" name="Step Failed" attachedToRef="prune-featuretypes">
      <outgoing>flow-prune-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_8" errorRef="stepFailedError"/>
    </boundaryEvent>
    <exclusiveGateway id="prune-comp-gateway" name="Compensate From?" default="flow-prune-comp-apisix">
      <incoming>flow-prune-error</incoming>
      <incoming>flow-delete-pending-workspace-error</incoming>
      <incoming>flow-unprovision-sinks-error</incoming>
      <incoming>flow-delete-pending-project-error</incoming>
      <outgoing>flow-prune-comp-pipelines</outgoing>
      <outgoing>flow-prune-comp-geo</outgoing>
      <outgoing>flow-prune-comp-apisix</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="pending-workspace-gateway" name="Pending Geo Sink Only?" default="flow-pending-workspace-skip">
      <incoming>flow-prune-skip</incoming>
      <incoming>flow-prune-success</incoming>
      <outgoing>flow-pending-workspace-delete</outgoing>
      <outgoing>flow-pending-workspace-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="delete-pending-workspace" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Delete GeoServer Workspace of Pending Sinks">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="geoserver"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DELETE_WORKSPACE"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="delete-pending-workspace"/>
      </extensionElements>
      <incoming>flow-pending-workspace-delete</incoming>
      <outgoing>flow-pending-workspace-sinks</outgoing>
    </serviceTask>
    <boundaryEvent id="delete-pending-workspace-error" name="Step Failed" attachedToRef="delete-pending-workspace">
      <outgoing>flow-delete-pending-workspace-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_9" errorRef="stepFailedError"/>
    </boundaryEvent>
    <exclusiveGateway id="pending-sinks-gateway" name="Has Pending Geo Sink?" default="flow-pending-sinks-skip">
      <incoming>flow-pending-workspace-skip</incoming>
      <incoming>flow-pending-workspace-sinks</incoming>
      <outgoing>flow-pending-sinks-unprovision</outgoing>
      <outgoing>flow-pending-sinks-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="unprovision-sinks" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Unprovision Pending PostGIS Sinks">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="postgis"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="UNPROVISION_SINKS"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="unprovision-sinks"/>
      </extensionElements>
      <incoming>flow-pending-sinks-unprovision</incoming>
      <outgoing>flow-pending-sinks-project</outgoing>
    </serviceTask>
    <boundaryEvent id="unprovision-sinks-error" name="Step Failed" attachedToRef="unprovision-sinks">
      <outgoing>flow-unprovision-sinks-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_10" errorRef="stepFailedError"/>
    </boundaryEvent>
    <exclusiveGateway id="pending-project-gateway" name="Pending FROST Sink Only?" default="flow-pending-project-skip">
      <incoming>flow-pending-sinks-skip</incoming>
      <incoming>flow-pending-sinks-project</incoming>
      <outgoing>flow-pending-project-delete</outgoing>
      <outgoing>flow-pending-project-skip</outgoing>
    </exclusiveGateway>
    <serviceTask id="delete-pending-project" flowable:class="de.civitascore.configadapter.flowable.common.delegate.SagaStepDelegate" name="Delete FROST Project of Pending Sinks">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="adapterName" stringValue="frost"/>
        <flowable:field xsi:type="xs:anyType" name="operation" stringValue="DELETE_PROJECT"/>
        <flowable:field xsi:type="xs:anyType" name="stepId" stringValue="delete-pending-project"/>
      </extensionElements>
      <incoming>flow-pending-project-delete</incoming>
      <outgoing>flow-pending-project-success</outgoing>
    </serviceTask>
    <boundaryEvent id="delete-pending-project-error" name="Step Failed" attachedToRef="delete-pending-project">
      <outgoing>flow-delete-pending-project-error</outgoing>
      <errorEventDefinition id="ErrorEventDefinition_11" errorRef="stepFailedError"/>
    </boundaryEvent>
    <serviceTask id="publish-success" flowable:async="true" flowable:class="de.civitascore.configadapter.flowable.common.delegate.ResultPublishDelegate" name="Publish Success Result">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="resultType" stringValue="success"/>
      </extensionElements>
      <incoming>flow-pending-project-skip</incoming>
      <incoming>flow-pending-project-success</incoming>
      <outgoing>flow-publish-success-end</outgoing>
    </serviceTask>
    <serviceTask id="publish-failure" flowable:async="true" flowable:class="de.civitascore.configadapter.flowable.common.delegate.ResultPublishDelegate" name="Publish Failure Result">
      <extensionElements>
        <flowable:field xsi:type="xs:anyType" name="resultType" stringValue="failure"/>
      </extensionElements>
      <incoming>flow-frost-error</incoming>
      <incoming>flow-comp-frost-fail</incoming>
      <incoming>flow-frost-comp-skip</incoming>
      <outgoing>flow-publish-failure-end</outgoing>
    </serviceTask>
    <endEvent id="end" name="Saga Completed">
      <incoming>flow-publish-success-end</incoming>
    </endEvent>
    <endEvent id="error-end" name="Saga Failed">
      <incoming>flow-publish-failure-end</incoming>
    </endEvent>
    <sequenceFlow id="flow-start" sourceRef="start" targetRef="frost-gateway"/>
    <sequenceFlow id="flow-frost-create" name="yes" sourceRef="frost-gateway" targetRef="create-project">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_5">${execution.getVariable('hasFrostSink') == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-frost-skip" name="no" sourceRef="frost-gateway" targetRef="create-route"/>
    <sequenceFlow id="flow-frost-apisix" sourceRef="create-project" targetRef="create-route"/>
    <sequenceFlow id="flow-apisix-geo" sourceRef="create-route" targetRef="geo-gateway"/>
    <sequenceFlow id="flow-geo-sink" name="yes" sourceRef="geo-gateway" targetRef="provision-sink">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_1">${execution.getVariable('hasGeoSink') == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-sink-workspace" sourceRef="provision-sink" targetRef="create-workspace"/>
    <sequenceFlow id="flow-geo-skip" name="no" sourceRef="geo-gateway" targetRef="pipeline-gateway"/>
    <sequenceFlow id="flow-workspace-datastore" sourceRef="create-workspace" targetRef="create-datastore"/>
    <sequenceFlow id="flow-datastore-layers-gateway" sourceRef="create-datastore" targetRef="layers-gateway"/>
    <sequenceFlow id="flow-layers-provision" name="yes" sourceRef="layers-gateway" targetRef="provision-layers">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_2">${execution.getVariable('hasLayers') == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-layers-skip" name="no" sourceRef="layers-gateway" targetRef="pipeline-gateway"/>
    <sequenceFlow id="flow-layers-pipeline" sourceRef="provision-layers" targetRef="pipeline-gateway"/>
    <sequenceFlow id="flow-gateway-pipeline" name="yes" sourceRef="pipeline-gateway" targetRef="deploy-pipelines">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_3">${hasPipelines == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-gateway-skip" name="no" sourceRef="pipeline-gateway" targetRef="prune-gateway"/>
    <sequenceFlow id="flow-pipeline-success" sourceRef="deploy-pipelines" targetRef="prune-gateway"/>
    <sequenceFlow id="flow-prune-featuretypes" name="yes" sourceRef="prune-gateway" targetRef="prune-featuretypes">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_7">${execution.getVariable('hasGeoSink') == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-prune-skip" name="no" sourceRef="prune-gateway" targetRef="pending-workspace-gateway"/>
    <sequenceFlow id="flow-prune-success" sourceRef="prune-featuretypes" targetRef="pending-workspace-gateway"/>
    <sequenceFlow id="flow-pending-workspace-delete" name="yes" sourceRef="pending-workspace-gateway" targetRef="delete-pending-workspace">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_10">${execution.getVariable('hasPendingGeoSink') == true and execution.getVariable('hasGeoSink') != true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-pending-workspace-skip" name="no" sourceRef="pending-workspace-gateway" targetRef="pending-sinks-gateway"/>
    <sequenceFlow id="flow-pending-workspace-sinks" sourceRef="delete-pending-workspace" targetRef="pending-sinks-gateway"/>
    <sequenceFlow id="flow-pending-sinks-unprovision" name="yes" sourceRef="pending-sinks-gateway" targetRef="unprovision-sinks">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_11">${execution.getVariable('hasPendingGeoSink') == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-pending-sinks-skip" name="no" sourceRef="pending-sinks-gateway" targetRef="pending-project-gateway"/>
    <sequenceFlow id="flow-pending-sinks-project" sourceRef="unprovision-sinks" targetRef="pending-project-gateway"/>
    <sequenceFlow id="flow-pending-project-delete" name="yes" sourceRef="pending-project-gateway" targetRef="delete-pending-project">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_12">${execution.getVariable('hasPendingFrostSink') == true and execution.getVariable('hasFrostSink') != true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-pending-project-skip" name="no" sourceRef="pending-project-gateway" targetRef="publish-success"/>
    <sequenceFlow id="flow-pending-project-success" sourceRef="delete-pending-project" targetRef="publish-success"/>
    <sequenceFlow id="flow-delete-pending-workspace-error" sourceRef="delete-pending-workspace-error" targetRef="prune-comp-gateway"/>
    <sequenceFlow id="flow-unprovision-sinks-error" sourceRef="unprovision-sinks-error" targetRef="prune-comp-gateway"/>
    <sequenceFlow id="flow-delete-pending-project-error" sourceRef="delete-pending-project-error" targetRef="prune-comp-gateway"/>
    <sequenceFlow id="flow-prune-error" sourceRef="prune-error" targetRef="prune-comp-gateway"/>
    <sequenceFlow id="flow-prune-comp-pipelines" name="pipelines" sourceRef="prune-comp-gateway" targetRef="compensate-pipelines">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_8">${hasPipelines == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-prune-comp-geo" name="geo" sourceRef="prune-comp-gateway" targetRef="compensate-geoserver">
      <conditionExpression xsi:type="tFormalExpression" id="FormalExpression_9">${hasPipelines != true and execution.getVariable('hasGeoSink') == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-prune-comp-apisix" name="no" sourceRef="prune-comp-gateway" targetRef="compensate-apisix"/>
    <sequenceFlow id="flow-publish-success-end" sourceRef="publish-success" targetRef="end"/>
    <sequenceFlow id="flow-frost-error" sourceRef="frost-error" targetRef="publish-failure"/>
