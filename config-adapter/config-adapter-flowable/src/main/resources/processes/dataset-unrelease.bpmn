        <di:waypoint xsi:type="dc:Point" x="580.0" y="251.0"/>
        <di:waypoint xsi:type="dc:Point" x="675.0" y="251.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_18">
          <dc:Bounds height="14.0" width="49.0" x="581.0" y="252.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SequenceFlow_11" bpmnElement="flow-publish-failure-end" sourceElement="BPMNShape_ServiceTask_4" targetElement="BPMNShape_EndEvent_1">
        <di:waypoint xsi:type="dc:Point" x="785.0" y="242.0"/>
        <di:waypoint xsi:type="dc:Point" x="853.0" y="259.0"/>
        <di:waypoint xsi:type="dc:Point" x="853.0" y="219.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_19"/>
