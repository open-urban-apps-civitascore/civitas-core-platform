<?xml version="1.0"?>
<ruleset name="Config Adapter NiFi"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
           https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

  <description>PMD rules for the config-adapter-nifi module.
    Noise rules are excluded; only actionable findings remain.</description>

  <!-- Best Practices -->
  <rule ref="category/java/bestpractices.xml">
    <exclude name="GuardLogStatement"/>          <!-- SLF4J parameterized logging is lazy -->
  </rule>

  <!-- Design -->
  <rule ref="category/java/design.xml">
    <exclude name="LawOfDemeter"/>               <!-- Too strict for fluent client/builder APIs -->
    <exclude name="CyclomaticComplexity"/>       <!-- Closed switch-based parsers/mappers are branchy by nature -->
    <exclude name="TooManyMethods"/>             <!-- Small focused helpers in the handler/REST client -->
    <exclude name="ExcessiveImports"/>           <!-- The orchestration classes wire many small collaborators -->
    <exclude name="CouplingBetweenObjects"/>     <!-- The planner is the intended composition point -->
    <exclude name="GodClass"/>                   <!-- Cohesive REST client / closed parser; one method per API call (same rationale as TooManyMethods) -->
  </rule>

  <!-- Error Prone -->
  <rule ref="category/java/errorprone.xml">
    <exclude name="NullAssignment"/>             <!-- Intentional for idempotent close() pattern -->
    <exclude name="AvoidLiteralsInIfCondition"/> <!-- HTTP status codes / arities read clearer as literals -->
    <exclude name="AvoidDuplicateLiterals"/>     <!-- Repeated REST path/JSON-key fragments are clearer inline -->
    <exclude name="AvoidFieldNameMatchingMethodName"/> <!-- Record-style accessor naming (rawOp()/nifiValue()) -->
    <exclude name="UseProperClassLoader"/>       <!-- Not a J2EE app; the module classloader resolves bundled templates -->
  </rule>

  <!-- Code Style -->
  <rule ref="category/java/codestyle.xml">
    <exclude name="LocalVariableCouldBeFinal"/>  <!-- Style preference, not enforced project-wide -->
    <exclude name="MethodArgumentCouldBeFinal"/> <!-- Same -->
    <exclude name="CommentDefaultAccessModifier"/><!-- Package-private is intentional in this module -->
    <exclude name="OnlyOneReturn"/>              <!-- Multiple returns are idiomatic in guard clauses -->
    <exclude name="AtLeastOneConstructor"/>       <!-- Utility classes with private constructors are fine -->
    <exclude name="LongVariable"/>               <!-- Descriptive names like processGroupId are fine -->
    <exclude name="ShortVariable"/>              <!-- Variables like id, op, ds are clear in context -->
    <exclude name="UseExplicitTypes"/>           <!-- var usage follows Backend Style Guide rules -->
    <exclude name="TooManyStaticImports"/>       <!-- Explicit static imports are fine per Style Guide -->
  </rule>
</ruleset>
