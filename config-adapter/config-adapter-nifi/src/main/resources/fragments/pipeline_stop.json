    "x": 400.0,
    "y": 600.0
  },
  "type": "org.apache.nifi.processors.standard.LogMessage",
  "bundle": {
    "group": "org.apache.nifi",
    "artifact": "nifi-standard-nar",
    "version": "2.9.0"
  },
  "properties": {
    "log-level": "error",
    "log-prefix": null,
    "log-message": "${core.stop.cause}"
  },
  "propertyDescriptors": {
    "log-level": {
      "name": "log-level",
      "displayName": "Log Level",
      "identifiesControllerService": false,
      "sensitive": false,
      "dynamic": false
    },
    "log-prefix": {
      "name": "log-prefix",
      "displayName": "Log prefix",
      "identifiesControllerService": false,
      "sensitive": false,
      "dynamic": false
    },
    "log-message": {
      "name": "log-message",
      "displayName": "Log message",
      "identifiesControllerService": false,
      "sensitive": false,
      "dynamic": false
    }
  },
  "style": {},
  "schedulingPeriod": "0 sec",
  "schedulingStrategy": "TIMER_DRIVEN",
  "executionNode": "ALL",
  "penaltyDuration": "30 sec",
  "yieldDuration": "1 sec",
  "bulletinLevel": "WARN",
  "runDurationMillis": 0,
  "concurrentlySchedulableTaskCount": 1,
  "autoTerminatedRelationships": [
    "success"
