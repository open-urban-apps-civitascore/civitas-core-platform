# Normalize all text files to LF in the repository.
# Git converts to the OS-native line ending on checkout (CRLF on Windows, LF on Linux/Mac).
* text=auto

# Force LF for files that must work on Linux (scripts, CI, Docker)
*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
.dockerignore text eol=lf
Makefile text eol=lf

# Force LF for source code (consistent across all modules)
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.rego text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.bru text eol=lf

# Binary files — no conversion
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
