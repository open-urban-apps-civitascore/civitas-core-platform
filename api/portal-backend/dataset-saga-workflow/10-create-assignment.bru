meta {
  name: 10. Create Assignment
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/assignments
  body: json
  auth: inherit
}

body:json {
  {
    "scopeType": "DATASET",
    "scopeId": "{{sagaDataSetId}}",
    "groupId": "{{sagaGroupId}}",
    "roleId": "{{sagaRoleId}}"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaAssignmentId', res.body.id);
  }
}

docs {
  ## Assembly – Create Assignment

  **Precondition:** `sagaDataSetId`, `sagaGroupId`, and `sagaRoleId` are set (from steps 1, 2, 8).

  Creates a scoped assignment linking the group and role to the dataset.

  **Expected Response**
  - Status: `201 Created`
  - Body contains `id`

  **Post-condition:** Saves `sagaAssignmentId` from `body.id`.

  **System Impact**

  | System | Expected Change |
  |---|---|
  | Backend | Scoped assignment record created in `portal_backend` DB |
  | Config Adapter | AuthZ Repository is notified to refresh authorization data cache |
  | AuthZ Repository (OPA) | Scoped role-group binding becomes visible in OPA policy data; verify at `http://localhost:8181/v1/data` |
}
