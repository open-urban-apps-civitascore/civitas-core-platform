meta {
  name: 8. Create DataSet
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/datasets
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Saga Test DataSet",
    "description": "Dataset for end-to-end saga workflow test",
    "openDataAccess": false
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaDataSetId', res.body.id);
  }
}

docs {
  ## Assembly – Create DataSet

  Creates the dataset that will be published and released.

  **Expected Response**
  - Status: `201 Created`
  - Body contains `id`

  **Post-condition:** Saves `sagaDataSetId` from `body.id`.

  **System Impact**

  | System | Expected Change |
  |---|---|
  | Backend | DataSet record created in `portal_backend` DB with status `DRAFT` |
}
