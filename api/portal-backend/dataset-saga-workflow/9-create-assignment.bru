meta {
  name: 9. Create Assignment
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/assignments
  body: json
  auth: inherit
}

body:json {
  {
    "groupId": "{{sagaGroupId}}",
    "roleId": "{{sagaRoleId}}",
    "scopeType": "DATASET",
    "scopeId": "{{sagaDataSetId}}"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaAssignmentId', res.body.id);
  }
}

