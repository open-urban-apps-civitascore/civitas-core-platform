meta {
  name: 9. Create Pipeline
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/pipelines
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Saga Test Pipeline",
    "description": "Pipeline for saga workflow test",
    "dataSetId": "{{sagaDataSetId}}",
    "dataSourceIds": ["{{sagaDataSourceId}}"],
    "apis": ["/v1.1/Things"],
    "persistences": [],
    "model": {
      "input": {
        "mqtt": {
          "urls": ["tcp://civitas.local:1234"],
          "topics": ["+/civitas+/civitas/core/+/123"],
          "client_id": "civitas-pipeline-demo"
        }
      },
      "pipeline": {
        "processors": []
      },
      "output": {
        "http_client": {
          "url": "http://civitas-frost:8080/FROST-Server/v1.1/Things",
          "verb": "POST",
          "headers": {
            "Content-Type": "application/json"
          }
        }
      }
    }
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaPipelineId', res.body.id);
  }
}
