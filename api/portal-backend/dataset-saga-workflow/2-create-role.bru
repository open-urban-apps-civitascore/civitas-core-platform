meta {
  name: 2. Create Role (DATA)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/roles
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Saga Test Data Role",
    "description": "Data role for saga workflow test",
    "roleType": "DATA",
    "permissionIds": [],
    "readonly": false
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaRoleId', res.body.id);
  }
}

docs {
  ## Setup – Create Role (DATA)

  Creates a DATA role to be used for the scoped assignment later in the workflow.

  **Expected Response**
  - Status: `201 Created`
  - Body contains `id`

  **Post-condition:** Saves `sagaRoleId` from `body.id`.

  **System Impact**

  | System | Expected Change |
  |---|---|
  | Backend | Role record created in `portal_backend` DB |
}
