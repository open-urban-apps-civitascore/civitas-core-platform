meta {
  name: 7. Create DataSource (MQTT)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Energy Meter",
    "description": "Public MQTT broker — Energy meter demo data",
    "connectorType": "MQTT",
    "configuration": {
      "urls": ["tcp://civitas.local:1234"],
      "topics": ["+/civitas+/civitas/core/+/123"],
      "client_id": "civitas-demo",
      "qos": 1,
      "connect_timeout": "5s",
      "keepalive": "30s",
      "tls": {
        "enabled": false
      }
    },
    "dataStructureVersionId": "{{sagaDataStructureVersionId}}",
    "assignments": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaDataSourceId', res.body.id);
  }
}

docs {
  ## Setup – Create DataSource (MQTT)

  **Precondition:** `sagaDataStructureVersionId` is set (from step 4).

  Creates an MQTT data source linked to the published data structure version.

  **Expected Response**
  - Status: `201 Created`
  - Body contains `id`

  **Post-condition:** Saves `sagaDataSourceId` from `body.id`.

  **System Impact**

  | System | Expected Change |
  |---|---|
  | Backend | DataSource record created in `portal_backend` DB with status `DRAFT` |
}
