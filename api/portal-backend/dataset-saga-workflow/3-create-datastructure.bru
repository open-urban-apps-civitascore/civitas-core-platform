meta {
  name: 3. Create DataStructure
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/datastructures
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Sensor Data Structure",
    "description": "Data structure for sensor readings",
    "createdFromDataSource": false,
    "dataStructureVersionIds": [],
    "assignments": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaDataStructureId', res.body.id);
  }
}

docs {
  ## Setup – Create DataStructure

  Creates a data structure that will hold the version with the UML model.

  **Expected Response**
  - Status: `201 Created`
  - Body contains `id`

  **Post-condition:** Saves `sagaDataStructureId` from `body.id`.

  **System Impact**

  | System | Expected Change |
  |---|---|
  | Backend | DataStructure record created in `portal_backend` DB |
}
