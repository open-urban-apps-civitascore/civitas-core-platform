meta {
  name: 14. Verify Assignments
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/datasets/:id/assignments
  body: none
  auth: inherit
}

params:path {
  id: {{sagaDataSetId}}
}

docs {
  ## Verify Assignments

  **Precondition:** `sagaDataSetId` is set; assignment was created in step 10.

  Retrieves the assignments for the dataset to verify the scoped assignment is present.

  **Expected Response**
  - Status: `200 OK`
  - Body contains at least one assignment with `scopeType: DATASET` and `scopeId` matching `sagaDataSetId`
}
