meta {
  name: 1. Create Group
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Saga Test Group",
    "description": "Group for saga workflow test",
    "contactUserId": null,
    "parentGroupId": null,
    "memberIds": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaGroupId', res.body.id);
  }
}

