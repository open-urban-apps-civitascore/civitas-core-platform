meta {
  name: 5. Create DataSet
  type: http
  seq: 12
  tags: [
    requires-nifi
  ]
}

post {
  url: {{baseUrl}}/datasets
  body: json
  auth: inherit
}

body:json {
  {
    "name": "PostGIS Saga DataSet",
    "description": "Dataset for end-to-end PostGIS + geoPoint saga workflow test",
    "openDataAccess": false,
    "namedApis": [
      { "name": "Things", "slug": "things", "standard": "STA", "version": "1.1" }
    ]
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('pgDataSetId', res.body.id);
  }
  const slug =
    (res.body && res.body.namedApis && res.body.namedApis[0] && res.body.namedApis[0].slug) ||
    'things';
  bru.setVar('pgSlug', slug);
}

tests {
  test("DataSet created or already exists", function() {
    const status = res.getStatus();
    // 201=created, 409=already exists from previous run
    expect(status === 201 || status === 409).to.be.true;
  });
}

docs {
  **PostGIS saga step 5** — Prerequisites: datasource released (step 4a), target structure released (step 3c).

  Creates the dataset ("PostGIS Saga DataSet") that will be staged, released (triggering the DATASET_CREATE saga), and later unreleased (triggering DATASET_DELETE). The POSTGIS DataSink (step 6) and the pipeline (step 7) are both nested under this dataset.

  **Expected Response:** 201 Created, body contains `id`. 409 if it already existed (idempotent).

  **Post-condition:** Save `pgDataSetId` from `body.id`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSet record created in `portal_backend` DB with status `DRAFT` |
  | Config Adapter | — |
  | External System | — |
}
