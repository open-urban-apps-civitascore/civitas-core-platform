meta {
  name: 15. Cleanup - Delete DataSet
  type: http
  seq: 23
  tags: [
    requires-nifi
  ]
}

delete {
  url: {{baseUrl}}/datasets/:id
  body: none
  auth: inherit
}

params:path {
  id: {{pgDataSetId}}
}

tests {
  test("DataSet deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=not in DRAFT state (pending saga)
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}

docs {
  **PostGIS saga step 15** — Delete the dataset (final cleanup).

  Removes the dataset record. Must be in `DRAFT` state (step 12). The DataSink (step 13) must already be gone — `data_sinks.dataset_id` is `NOT NULL` with no DB cascade, so a lingering sink would block this delete. The pipeline (step 14) is also deleted first; if any remains it is cascade-removed.

  **Expected Response:** 204 No Content. 400 if not in `DRAFT` state (wait for pending saga). 404 if already deleted.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSet record removed from `portal_backend` DB |
  | Config Adapter | — |
  | External System | — |
}
