meta {
  name: 7. Create Pipeline (geoPoint mapping)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/datasets/:dataSetId/pipelines
  body: json
  auth: inherit
}

params:path {
  dataSetId: {{pgDataSetId}}
}

body:json {
  {
    "name": "PostGIS Saga Pipeline",
    "description": "Pipeline mapping lon/lat scalars to a PostGIS Point via the geoPoint op",
    "dataSourceIds": ["{{pgDataSourceId}}"],
    "dataSinkIds": ["{{pgDataSinkId}}"],
    "model": {
      "nodes": [
        { "id": "33333333-3333-4000-8000-000000000001", "kind": "start", "label": "Start", "x-ui-position": { "x": 360, "y": -40 } },
        { "id": "33333333-3333-4000-8000-000000000005", "kind": "source", "label": "MQTT Source", "sourceRef": "{{pgDataSourceConfigUrn}}", "x-ui-position": { "x": 140, "y": 100 } },
        { "id": "33333333-3333-4000-8000-000000000002", "kind": "mapping", "label": "Mapping", "mappingRef": "{{pgMappingUrn}}", "x-ui-position": { "x": 320, "y": 100 } },
        { "id": "33333333-3333-4000-8000-000000000006", "kind": "sink", "label": "Geospatial Data Storage", "sinkRef": "{{pgDataSinkConfigUrn}}", "x-ui-position": { "x": 520, "y": 100 } },
        { "id": "33333333-3333-4000-8000-000000000003", "kind": "end", "label": "End", "x-ui-position": { "x": 740, "y": 80 } }
      ],
      "edges": [
        { "id": "33333333-3333-4000-8000-0000000000e1", "source": "33333333-3333-4000-8000-000000000001", "target": "33333333-3333-4000-8000-000000000005" },
        { "id": "33333333-3333-4000-8000-0000000000e3", "source": "33333333-3333-4000-8000-000000000005", "target": "33333333-3333-4000-8000-000000000002" },
        { "id": "33333333-3333-4000-8000-0000000000e4", "source": "33333333-3333-4000-8000-000000000002", "target": "33333333-3333-4000-8000-000000000006" },
        { "id": "33333333-3333-4000-8000-0000000000e2", "source": "33333333-3333-4000-8000-000000000006", "target": "33333333-3333-4000-8000-000000000003" }
      ]
    },
    "styles": {
      "viewport": { "x": 0, "y": 0, "zoom": 1 },
      "nodePositions": {
        "33333333-3333-4000-8000-000000000001": { "x": 360, "y": -40 },
        "33333333-3333-4000-8000-000000000005": { "x": 140, "y": 100 },
        "33333333-3333-4000-8000-000000000002": { "x": 320, "y": 100 },
        "33333333-3333-4000-8000-000000000006": { "x": 520, "y": 100 },
        "33333333-3333-4000-8000-000000000003": { "x": 740, "y": 80 }
      },
      "nodes": [
        {
          "id": "33333333-3333-4000-8000-000000000001",
          "type": "start",
          "position": { "x": 360, "y": -40 },
          "data": { "nodeType": "start", "label": "Start", "configured": true, "description": "Entry point of the pipeline. Execution begins here." },
          "measured": { "width": 32, "height": 32 }
        },
        {
          "id": "33333333-3333-4000-8000-000000000005",
          "type": "dataSource",
          "position": { "x": 140, "y": 100 },
          "data": { "label": "MQTT Source", "configured": true, "entityType": "datasource", "entityId": "{{pgDataSourceId}}", "entityMetadata": { "connector": "MQTT" } },
          "measured": { "width": 160, "height": 48 }
        },
        {
          "id": "33333333-3333-4000-8000-000000000002",
          "type": "mapping",
          "position": { "x": 320, "y": 100 },
          "data": {
            "label": "Mapping",
            "configured": true,
            "mappingConfig": {
              "$schema": "https://civitasconnect.digital/core/mapping/v1",
              "source": "urn:core:tenant:civitas:datastructure:demo:GeoSensorSource:0000000001:1.0.0",
              "target": "urn:core:tenant:civitas:datastructure:demo:GeoSensorTarget:0000000002:1.0.0",
              "fields": {
                "$.stationid": "$.stationid",
                "$.geo": { "op": "geoPoint", "lon": "$.lon", "lat": "$.lat" }
              },
              "positions": {}
            },
            "sourceDatastructureId": "{{pgSourceDataStructureId}}",
            "sourceVersionId": "{{pgSourceVersionId}}",
            "sourceName": "GeoSensorSource",
            "targetDatastructureId": "{{pgTargetDataStructureId}}",
            "targetVersionId": "{{pgTargetVersionId}}",
            "targetName": "GeoSensorTarget"
          },
          "measured": { "width": 160, "height": 66 },
          "selected": false,
          "dragging": false
        },
        {
          "id": "33333333-3333-4000-8000-000000000006",
          "type": "geoPersistence",
          "position": { "x": 520, "y": 100 },
          "data": { "label": "Geospatial Data Storage", "configured": true, "entityType": "persistence", "entityId": "{{pgDataSinkId}}", "tableName": "saga_geo_observations", "dataStructureVersionId": "{{pgTargetDataStructureId}}/{{pgTargetVersionId}}", "dataStructureName": "GeoSensorTarget" },
          "measured": { "width": 160, "height": 48 }
        },
        {
          "id": "33333333-3333-4000-8000-000000000003",
          "type": "end",
          "position": { "x": 740, "y": 80 },
          "data": { "nodeType": "end", "label": "End", "configured": true, "description": "Exit point of the pipeline. Execution completes here." },
          "measured": { "width": 32, "height": 32 }
        }
      ],
      "edges": [
        { "id": "33333333-3333-4000-8000-0000000000e1", "source": "33333333-3333-4000-8000-000000000001", "target": "33333333-3333-4000-8000-000000000005", "type": "smoothstep", "data": { "label": "" } },
        { "id": "33333333-3333-4000-8000-0000000000e3", "source": "33333333-3333-4000-8000-000000000005", "target": "33333333-3333-4000-8000-000000000002", "type": "smoothstep", "data": { "label": "" } },
        { "id": "33333333-3333-4000-8000-0000000000e4", "source": "33333333-3333-4000-8000-000000000002", "target": "33333333-3333-4000-8000-000000000006", "type": "smoothstep", "data": { "label": "" } },
        { "id": "33333333-3333-4000-8000-0000000000e2", "source": "33333333-3333-4000-8000-000000000006", "target": "33333333-3333-4000-8000-000000000003", "type": "smoothstep", "data": { "label": "" } }
      ]
    }
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('pgPipelineId', res.body.id);
  }
}

tests {
  test("Pipeline created", function() {
    const status = res.getStatus();
    // 201=created. This collection assumes a clean DB per run (CI uses an ephemeral stack); a 409
    // would mean a previous run leaked — fail loudly rather than carry a stale id downstream.
    expect(status).to.equal(201);
  });
}

docs {
  **PostGIS saga step 7** — Prerequisites: DataSource AVAILABLE (step 4a), DataSet created (step 5), POSTGIS DataSink created (step 6).

  Creates the pipeline attached to the dataset, modelled as a CORE intermediate-representation graph. The graph is the mandatory linear data flow `start → dataSource → mapping → geoPersistence → end`: the wired MQTT source node (`entityId` = `pgDataSourceId`) feeds the mapping, which feeds the wired POSTGIS sink node (`entityId` = `pgDataSinkId`). The adapter derives source and sink per pipeline from the graph's `entityId`s, which must also appear in `dataSourceIds`/`dataSinkIds`; a graph without a wired source or sink node is rejected at deploy.

  The mapping node carries an inline `mappingConfig` whose `fields` use the **geoPoint** op:
  `"$.geo": { "op": "geoPoint", "lon": "$.lon", "lat": "$.lat" }`.
  The adapter compiles this to a WKT `POINT(<lon> <lat>)` literal that the `GEOMETRY(POINT,4326)` column parses on insert; `$.stationid` is a straight copy. `source`/`target` are versioned CORE URNs (opaque labels for the mapping parser); `$schema` and `positions` are accepted-but-ignored.

  When the dataset is released, the saga deploys this pipeline to the pipeline engine writing to the PostGIS sink.

  **Expected Response:** 201 Created, body contains `id`. 409 if it already existed (idempotent).

  **Post-condition:** Save `pgPipelineId` from `body.id`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Pipeline record created in `portal_backend` DB linked to the dataset; DataSink `pipeline_id` set |
  | Config Adapter | — |
  | Pipeline engine | Pipeline is deployed only after the DATASET_CREATE saga runs (step 9) |
}
