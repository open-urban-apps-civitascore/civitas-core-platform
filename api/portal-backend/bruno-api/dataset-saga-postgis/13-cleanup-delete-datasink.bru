meta {
  name: 13. Cleanup - Delete DataSink
  type: http
  seq: 21
  tags: [
    requires-nifi
  ]
}

delete {
  url: {{baseUrl}}/datasets/:dataSetId/datasinks/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{pgDataSetId}}
  id: {{pgDataSinkId}}
}

tests {
  test("DataSink deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=invalid ID (unset var on first run)
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}

docs {
  **PostGIS saga step 13** — Delete the POSTGIS DataSink (cleanup).

  Removes the DataSink created in step 6. This must run **before** deleting the pipeline (step 14) and the dataset (step 15): `data_sinks.dataset_id` is `NOT NULL` with no `ON DELETE CASCADE`, and `data_sinks.pipeline_id` references the pipeline — deleting either parent first would violate the FK.

  **Expected Response:** 204 No Content. 404 if already deleted. 400 if `pgDataSinkId` is not set (first run).

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSink record removed from `portal_backend` DB |
  | Config Adapter | — (sink table already de-provisioned by the DELETE saga) |
}
