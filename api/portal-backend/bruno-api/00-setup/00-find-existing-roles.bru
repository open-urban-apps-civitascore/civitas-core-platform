meta {
  name: Setup - Find Existing Roles
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/roles?search=API Test
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 200 && res.body && res.body.content) {
    const dataRole = res.body.content.find(r => r.name === 'API Test Data Role');
    if (dataRole) {
      bru.setVar('roleId', dataRole.id);
      bru.setVar('setupRoleId', dataRole.id);
    }
    const systemRole = res.body.content.find(r => r.name === 'API Test System Role');
    if (systemRole) {
      bru.setVar('systemRoleId', systemRole.id);
      bru.setVar('setupSystemRoleId', systemRole.id);
    }
  }
}

tests {
  test("Lookup succeeded", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Purpose:** Checks whether "API Test Data Role" and "API Test System Role" from a previous run already exist. If found, saves the IDs so the creation steps (02, 02b) can be skipped and teardown targets the correct records.

  **Expected Response:** 200 OK, body is a paginated list (may be empty if this is the first run).

  **Post-condition:** If matches are found, saves `roleId` / `setupRoleId` and `systemRoleId` / `setupSystemRoleId` from `body.content[].id`.
}
