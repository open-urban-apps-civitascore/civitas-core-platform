meta {
  name: Setup - Create Group
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "API Test Group",
    "description": "Base group for API testing",
    "contactUserId": null,
    "parentGroupId": null,
    "memberIds": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('groupId', res.body.id);
    bru.setVar('setupGroupId', res.body.id);
  }
}

tests {
  test("Group created", function() {
    const status = res.getStatus();
    // 201=created, 409=already exists from previous run
    expect(status === 201 || status === 409).to.be.true;
  });
}

docs {
  **Expected Response:** 201 Created, body contains `id`. 409 if the group already existed (idempotent setup).

  **Post-condition:** Save `groupId` and `setupGroupId` from `body.id`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Group record created in `portal_backend` DB |
  | Config Adapter | Produces `de.civitascore.idm.group.created` Kafka event; forwards creation to Keycloak |
  | Keycloak | Group added to `civitas-core` realm |
}
