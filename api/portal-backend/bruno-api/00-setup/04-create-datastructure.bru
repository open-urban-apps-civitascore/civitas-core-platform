meta {
  name: Setup - Create DataStructure
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/datastructures
  body: json
  auth: inherit
}

body:json {
  {
    "name": "API Test DataStructure",
    "description": "Base data structure for API testing",
    "createdFromDataSource": false,
    "dataStructureVersionIds": [],
    "assignments": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('dataStructureId', res.body.id);
    bru.setVar('setupDataStructureId', res.body.id);
  }
}

tests {
  test("DataStructure created", function() {
    const status = res.getStatus();
    // 201=created, 409=already exists from previous run
    expect(status === 201 || status === 409).to.be.true;
  });
}
