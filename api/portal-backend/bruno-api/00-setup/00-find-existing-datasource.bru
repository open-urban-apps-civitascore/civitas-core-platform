meta {
  name: Setup - Find Existing DataSource
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/datasources?search=API Test DataSource
  body: none
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

script:post-response {
  if (res.getStatus() === 200 && res.body && res.body.content) {
    const match = res.body.content.find(d => d.name === 'API Test DataSource');
    if (match) {
      bru.setVar('dataSourceId', match.id);
      bru.setVar('setupDataSourceId', match.id);
      bru.setVar('scopeType', 'DATASOURCE');
      bru.setVar('scopeId', match.id);
    }
  }
}

tests {
  test("Lookup succeeded", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Purpose:** Checks whether an "API Test DataSource" from a previous run already exists. If found, saves the ID so the creation step (03) can be skipped and teardown targets the correct record.

  **Expected Response:** 200 OK, body is a paginated list (may be empty if this is the first run).

  **Post-condition:** If a match is found, saves `dataSourceId`, `setupDataSourceId`, `scopeType` (`DATASOURCE`), and `scopeId` from `body.content[].id`.
}
