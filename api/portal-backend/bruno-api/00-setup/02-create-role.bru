meta {
  name: Setup - Create Role (DATA)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/roles
  body: json
  auth: inherit
}

body:json {
  {
    "name": "API Test Data Role",
    "description": "Base DATA role for API testing",
    "roleType": "DATA",
    "permissionIds": [],
    "readonly": false
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('roleId', res.body.id);
    bru.setVar('setupRoleId', res.body.id);
  }
}

tests {
  test("Role created", function() {
    const status = res.getStatus();
    // 201=created, 409=already exists from previous run
    expect(status === 201 || status === 409).to.be.true;
  });
}
