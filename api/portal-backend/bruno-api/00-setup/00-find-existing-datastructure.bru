meta {
  name: Setup - Find Existing DataStructure
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/datastructures?search=API Test DataStructure
  body: none
  auth: inherit
}


script:post-response {
  if (res.getStatus() === 200 && res.body && res.body.content) {
    const match = res.body.content.find(d => d.name === 'API Test DataStructure');
    if (match) {
      bru.setVar('dataStructureId', match.id);
      bru.setVar('setupDataStructureId', match.id);
    }
  }
}

tests {
  test("Lookup succeeded", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Purpose:** Checks whether an "API Test DataStructure" from a previous run already exists. If found, saves the ID so the creation step (04) can be skipped and teardown targets the correct record.

  **Expected Response:** 200 OK, body is a paginated list (may be empty if this is the first run).

  **Post-condition:** If a match is found, saves `dataStructureId` and `setupDataStructureId` from `body.content[].id`.
}
