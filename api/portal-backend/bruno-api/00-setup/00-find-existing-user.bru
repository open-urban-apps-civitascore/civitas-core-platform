meta {
  name: Setup - Find Existing User
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/users?search=api.testuser
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 200 && res.body && res.body.content) {
    const match = res.body.content.find(u => u.email === 'api.testuser@example.com');
    if (match) {
      bru.setVar('userId', match.id);
      bru.setVar('setupUserId', match.id);
    }
  }
}

tests {
  test("Lookup succeeded", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Purpose:** Checks whether user `api.testuser@example.com` from a previous run already exists. If found, saves the ID so the creation step (06) can be skipped and teardown targets the correct record.

  **Expected Response:** 200 OK, body is a paginated list (may be empty if this is the first run).

  **Post-condition:** If a match is found, saves `userId` and `setupUserId` from `body.content[].id`.
}
