meta {
  name: 14. Cleanup - Delete DataStructure
  type: http
  seq: 28
}

delete {
  url: {{baseUrl}}/datastructures/:id
  body: none
  auth: inherit
}

params:path {
  id: {{httpSagaDataStructureId}}
}

tests {
  test("DataStructure deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=id never set, 409=still referenced
    expect(status === 204 || status === 404 || status === 400 || status === 409).to.be.true;
  });
}
