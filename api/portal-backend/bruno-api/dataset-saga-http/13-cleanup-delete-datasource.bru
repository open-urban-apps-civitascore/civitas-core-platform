meta {
  name: 13. Cleanup - Delete DataSource
  type: http
  seq: 40
}

delete {
  url: {{baseUrl}}/datasources/:id
  body: none
  auth: inherit
}

params:path {
  id: {{httpSagaDataSourceId}}
}

tests {
  test("DataSource deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=wrong state or id never set, 409=still in use
    expect(status === 204 || status === 404 || status === 400 || status === 409).to.be.true;
  });
}
