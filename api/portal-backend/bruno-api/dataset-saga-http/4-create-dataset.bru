meta {
  name: 4. Create DataSet
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/datasets
  body: json
  auth: inherit
}

body:json {
  {
    "name": "HTTP Saga DataSet",
    "description": "Dataset for the end-to-end test of HTTP/REST Pipelines",
    "openDataAccess": false,
    "namedApis": [
      { "name": "Things", "slug": "things", "standard": "STA", "version": "1.1" }
    ]
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('httpSagaDataSetId', res.body.id);
  }
}

tests {
  test("DataSet created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
