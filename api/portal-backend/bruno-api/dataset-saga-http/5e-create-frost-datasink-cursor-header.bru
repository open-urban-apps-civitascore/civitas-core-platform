meta {
  name: 5e. Create FROST DataSink (cursor-header)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/datasets/:dataSetId/datasinks
  body: json
  auth: inherit
}

params:path {
  dataSetId: {{httpSagaDataSetId}}
}

body:json {
  {
    "dataSinkType": "FROST",
    "configuration": { "port": "ThingTree" }
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('httpSagaCursorHeaderSinkId', res.body.id);
  }
  if (res.body && res.body.configurationUrn) {
    bru.setVar('httpSagaCursorHeaderSinkConfigurationUrn', res.body.configurationUrn);
  }
}

tests {
  test("DataSink created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
