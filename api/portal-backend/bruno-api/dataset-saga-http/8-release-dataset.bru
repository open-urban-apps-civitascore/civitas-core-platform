meta {
  name: 8. Release DataSet (triggers saga)
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/datasets/:id/release
  body: none
  auth: inherit
}

params:path {
  id: {{httpSagaDataSetId}}
}

tests {
  test("Release saga triggered", function() {
    expect(res.getStatus()).to.equal(202);
  });
}
