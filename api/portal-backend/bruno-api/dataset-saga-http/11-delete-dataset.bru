meta {
  name: 11. Delete DataSet (triggers delete saga)
  type: http
  seq: 34
}

delete {
  url: {{baseUrl}}/datasets/:id
  body: none
  auth: inherit
}

params:path {
  id: {{httpSagaDataSetId}}
}

tests {
  test("DataSet delete accepted or already gone", function() {
    const status = res.getStatus();
    // 204=delete saga triggered, 404=already gone
    expect(status === 204 || status === 404).to.be.true;
  });
}
