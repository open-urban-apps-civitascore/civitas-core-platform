meta {
  name: 6i. Create Pipeline (next-link)
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/datasets/:dataSetId/pipelines
  body: json
  auth: inherit
}

params:path {
  dataSetId: {{httpSagaDataSetId}}
}

body:json {
  {
    "name": "HTTP Saga Pipeline next-link",
    "description": "Reads the API call next-link into the FROST Data sink",
    "dataSourceIds": ["{{httpSagaDataSourceId}}"],
    "dataSinkIds": ["{{httpSagaNextLinkSinkId}}"],
    "model": {
      "nodes": [
        { "id": "start", "kind": "start", "label": "Start" },
        { "id": "cron", "kind": "cron", "label": "CRON", "cronExpression": "0/10 * * * * ?" },
        {
          "id": "source",
          "kind": "source",
          "label": "HTTP/REST Source",
          "sourceRef": "{{httpSagaDataSourceLatestUrn}}",
          "apiCallName": "next-link"
        },
        {
          "id": "sink",
          "kind": "sink",
          "label": "Sensor Data Storage",
          "sinkRef": "{{httpSagaNextLinkSinkConfigurationUrn}}"
        },
        { "id": "end", "kind": "end", "label": "End" }
      ],
      "edges": [
        { "id": "e1", "source": "start", "target": "cron" },
        { "id": "e2", "source": "cron", "target": "source" },
        { "id": "e3", "source": "source", "target": "sink" },
        { "id": "e4", "source": "sink", "target": "end" }
      ]
    }
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('httpSagaNextLinkPipelineId', res.body.id);
  }
}

tests {
  test("Pipeline created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
