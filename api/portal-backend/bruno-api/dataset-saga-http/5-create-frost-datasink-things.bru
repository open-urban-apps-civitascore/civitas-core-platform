meta {
  name: 5. Create FROST DataSink (things)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/datasets/:dataSetId/datasinks
  body: json
  auth: inherit
}

params:path {
  dataSetId: {{httpSagaDataSetId}}
}

body:json {
  {
    "dataSinkType": "FROST",
    "configuration": { "port": "ThingTree" }
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('httpSagaThingsSinkId', res.body.id);
  }
  if (res.body && res.body.configurationUrn) {
    bru.setVar('httpSagaThingsSinkConfigurationUrn', res.body.configurationUrn);
  }
}

tests {
  test("DataSink created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  A Data sink belongs to one Pipeline, so each Pipeline gets a FROST Data sink of its own. All of
  them write into the FROST project of the Dataset.
}
