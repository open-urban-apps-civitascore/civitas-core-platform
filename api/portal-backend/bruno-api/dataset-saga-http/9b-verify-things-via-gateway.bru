meta {
  name: 9b. Verify the Things in FROST via APISIX
  type: http
  seq: 21
}

get {
  url: {{httpSagaPublicUrl}}/things/Things
  body: none
  auth: inherit
}

script:pre-request {
  // Runs after 9a, so the invalid Pipeline has already read its response once: a record of it in
  // FROST would show here.
  const axios = require('axios');
  const url = `${bru.getVar('httpSagaPublicUrl')}/things/Things`;
  const expected = [
    'http-saga-things-1', 'http-saga-things-2',
    'http-saga-pages-1', 'http-saga-pages-2', 'http-saga-pages-3', 'http-saga-pages-4',
    'http-saga-pages-5',
  ];

  const form = [
    ['grant_type', 'password'],
    ['client_id', bru.getEnvVar('clientId')],
    ['client_secret', bru.getEnvVar('clientSecret')],
    ['username', bru.getEnvVar('username')],
    ['password', bru.getEnvVar('password')],
  ].map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join('&');
  const tokenResp = await axios.post(
    `${bru.getEnvVar('keycloakUrl')}/realms/${bru.getEnvVar('realm')}/protocol/openid-connect/token`,
    form,
    { headers: { 'Content-Type': 'application/x-www-form-urlencoded' } }
  );
  const token = tokenResp.data.access_token;

  for (let i = 0; i < 30; i++) {
    let resp;
    try {
      resp = await axios.get(url, { headers: { 'Authorization': `Bearer ${token}` } });
    } catch (e) { /* transient; retry */ }
    const references = ((resp && resp.data && resp.data.value) || [])
      .map(thing => thing.properties && thing.properties.reference);
    if (expected.every(reference => references.includes(reference))) break;
    await new Promise(r => setTimeout(r, 2000));
  }
}

tests {
  const references = () =>
    (res.body.value || []).map(thing => thing.properties && thing.properties.reference);

  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("FROST holds the Things of the things API call", function() {
    expect(references()).to.include.members(['http-saga-things-1', 'http-saga-things-2']);
  });

  test("FROST holds the Things of all three pages of the pages API call", function() {
    expect(references()).to.include.members([
      'http-saga-pages-1', 'http-saga-pages-2', 'http-saga-pages-3', 'http-saga-pages-4',
      'http-saga-pages-5',
    ]);
  });

  test("FROST holds no record of the invalid response", function() {
    expect(references()).to.not.include('http-saga-invalid-0');
  });
}
