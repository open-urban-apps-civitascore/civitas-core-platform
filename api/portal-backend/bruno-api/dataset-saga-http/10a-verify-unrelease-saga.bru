meta {
  name: 10a. Verify unrelease saga complete
  type: http
  seq: 33
}

get {
  url: {{baseUrl}}/datasets/:id
  body: none
  auth: inherit
}

params:path {
  id: {{httpSagaDataSetId}}
}

script:pre-request {
  // The delete answers 400 while a saga is pending, and the teardown would leak the Dataset.
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl');
  const datasetId = bru.getVar('httpSagaDataSetId');

  const form = [
    ['grant_type', 'password'],
    ['client_id', bru.getEnvVar('clientId')],
    ['client_secret', bru.getEnvVar('clientSecret')],
    ['username', bru.getEnvVar('username')],
    ['password', bru.getEnvVar('password')],
  ].map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join('&');
  const tokenResp = await axios.post(
    `${bru.getEnvVar('keycloakUrl')}/realms/${bru.getEnvVar('realm')}/protocol/openid-connect/token`,
    form,
    { headers: { 'Content-Type': 'application/x-www-form-urlencoded' } }
  );
  const token = tokenResp.data.access_token;

  for (let i = 0; i < 30; i++) {
    let resp;
    try {
      resp = await axios.get(`${baseUrl}/datasets/${datasetId}`, {
        headers: { 'Authorization': `Bearer ${token}` },
      });
    } catch (e) { /* transient; retry */ }
    if (resp && resp.status === 200 && resp.data && resp.data.pendingSagaType === null
        && resp.data.dataSetStatus === 'READY') {
      break;
    }
    await new Promise(r => setTimeout(r, 2000));
  }
}

tests {
  test("Unrelease saga settled with the DataSet READY", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.pendingSagaType).to.be.null;
    expect(res.body.dataSetStatus).to.equal('READY');
  });
}
