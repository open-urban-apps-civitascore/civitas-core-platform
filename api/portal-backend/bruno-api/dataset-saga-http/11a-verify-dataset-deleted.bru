meta {
  name: 11a. Verify delete saga complete
  type: http
  seq: 35
}

get {
  url: {{baseUrl}}/datasets/:id
  body: none
  auth: inherit
}

params:path {
  id: {{httpSagaDataSetId}}
}

script:pre-request {
  // The delete saga removes the NiFi flows and the APISIX route, and the DataSet with its
  // Pipelines only once it completes. The Data source stays in use until then.
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl');
  const datasetId = bru.getVar('httpSagaDataSetId');

  const form = [
    ['grant_type', 'password'],
    ['client_id', bru.getEnvVar('clientId')],
    ['client_secret', bru.getEnvVar('clientSecret')],
    ['username', bru.getEnvVar('username')],
    ['password', bru.getEnvVar('password')],
  ].map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join('&');
  const tokenResp = await axios.post(
    `${bru.getEnvVar('keycloakUrl')}/realms/${bru.getEnvVar('realm')}/protocol/openid-connect/token`,
    form,
    { headers: { 'Content-Type': 'application/x-www-form-urlencoded' } }
  );
  const token = tokenResp.data.access_token;

  for (let i = 0; i < 30; i++) {
    let status;
    try {
      const resp = await axios.get(`${baseUrl}/datasets/${datasetId}`, {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      status = resp.status;
    } catch (e) {
      status = e.response && e.response.status;
    }
    if (status === 404) break;
    await new Promise(r => setTimeout(r, 2000));
  }
}

tests {
  test("DataSet removed after the delete saga", function() {
    expect(res.getStatus()).to.equal(404);
  });
}
