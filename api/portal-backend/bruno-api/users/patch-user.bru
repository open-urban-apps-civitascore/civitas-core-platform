meta {
  name: Patch User
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/users/:id
  body: json
  auth: bearer
}

params:path {
  id: {{userId}}
}

body:json {
  {
    "firstName": "Jane"
  }
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('userId', res.body.id);
  }
}
