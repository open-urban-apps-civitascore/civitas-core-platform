meta {
  name: Delete User
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/users/:id
  body: none
  auth: inherit
}

params:path {
  id: {{userId}}
}

script:post-response {
  const setupId = bru.getVar('setupUserId');
  if (setupId) {
    bru.setVar('userId', setupId);
  }
}

tests {
  test("Status code is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
