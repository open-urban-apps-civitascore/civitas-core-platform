meta {
  name: Create User
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: bearer
}

body:json {
  {
    "title": "MR",
    "firstName": "John",
    "lastName": "Doe",
    "email": "john.doe@example.com",
    "phone": "+1234567890",
    "externalId": "ext-123",
    "active": true,
    "groupIds": []
  }
}

auth:bearer {
  token: {{accessToken}}
}
