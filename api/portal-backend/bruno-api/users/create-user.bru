meta {
  name: Create User
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: inherit
}

body:json {
  {
    "title": "MR",
    "firstName": "John",
    "lastName": "Doe",
    "email": "john.doe@example.com",
    "phone": "+1234567890",
    "active": true,
    "groupIds": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('userId', res.body.id);
  }
}
