meta {
  name: Update User
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/users/:id
  body: json
  auth: inherit
}

params:path {
  id: {{userId}}
}

body:json {
  {
    "title": "MR",
    "firstName": "John",
    "lastName": "Doe",
    "email": "john.doe@example.com",
    "phone": "+1234567890",
    "active": true,
    "groupIds": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('userId', res.body.id);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Precondition:** `userId` is set.

  **Expected Response**
  - Status: `200 OK`
  - Body reflects the updated values

  **System Impact**

  | System | Expected Change |
  |---|---|
  | Backend | User record updated in `portal_backend` DB |
  | Config Adapter | Consumes `de.civitascore.idm.user.updated` Kafka event; forwards update to Keycloak |
  | Keycloak | User attributes updated in `civitas-core` realm |
}
