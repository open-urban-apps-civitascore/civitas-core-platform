meta {
  name: Teardown - Delete User
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/users/{{userId}}
  body: none
  auth: inherit
}

tests {
  test("User deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=invalid ID
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}

docs {
  **Expected Response:** 204 No Content.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | User record removed from `portal_backend` DB |
  | Config Adapter | Produces `de.civitascore.idm.user.deleted` Kafka event; forwards deletion to Keycloak |
  | Keycloak | User account removed from `civitas-core` realm |
}
