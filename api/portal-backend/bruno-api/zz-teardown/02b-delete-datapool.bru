meta {
  name: Teardown - Delete DataPool
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/datapools/{{dataPoolId}}
  body: none
  auth: inherit
}

tests {
  test("DataPool deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 409=datasets still assigned
    expect(status === 204 || status === 404 || status === 409).to.be.true;
  });
}

docs {
  **Expected Response:** 204 No Content. 409 if datasets are still assigned (they should have been deleted by the previous step).

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataPool record removed from `portal_backend` DB |
  | Config Adapter | — |
  | External System | — |
}
