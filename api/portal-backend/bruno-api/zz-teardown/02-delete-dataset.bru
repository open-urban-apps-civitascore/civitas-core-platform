meta {
  name: Teardown - Delete DataSet
  type: http
  seq: 2
}

delete {
  url: {{baseUrl}}/datasets/{{dataSetId}}
  body: none
  auth: inherit
}

tests {
  test("DataSet deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=not in DRAFT state
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}

docs {
  **Expected Response:** 204 No Content. 400 if the dataset is not in `DRAFT` state (must unpublish first).

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSet record removed from `portal_backend` DB |
  | Config Adapter | — |
  | External System | — |
}
