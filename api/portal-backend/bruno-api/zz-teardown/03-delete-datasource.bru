meta {
  name: Teardown - Delete DataSource
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/datasources/{{dataSourceId}}
  body: none
  auth: inherit
}

tests {
  test("DataSource deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=not in DRAFT state
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}
