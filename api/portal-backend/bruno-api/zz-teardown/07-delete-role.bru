meta {
  name: Teardown - Delete Role
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/roles/{{roleId}}
  body: none
  auth: inherit
}

tests {
  test("Role deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=invalid ID
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}

docs {
  **Expected Response:** 204 No Content.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DATA role record removed from `portal_backend` DB |
  | Config Adapter | — |
  | External System | — |
}
