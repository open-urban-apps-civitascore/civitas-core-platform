meta {
  name: Teardown - Delete DataStructure
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/datastructures/{{dataStructureId}}
  body: none
  auth: inherit
}

tests {
  test("DataStructure deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone
    expect(status === 204 || status === 404).to.be.true;
  });
}

docs {
  **Expected Response:** 204 No Content. 409 if one of its versions is still in use.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataStructure record removed from `portal_backend` DB |
  | Config Adapter | — |
  | External System | — |
}
