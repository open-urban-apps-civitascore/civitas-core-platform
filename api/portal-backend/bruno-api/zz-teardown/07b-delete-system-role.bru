meta {
  name: Teardown - Delete System Role
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/roles/{{systemRoleId}}
  body: none
  auth: inherit
}

tests {
  test("System Role deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=invalid ID, 409=has active assignments
    expect(status === 204 || status === 404 || status === 400 || status === 409).to.be.true;
  });
}

docs {
  **Expected Response:** 204 No Content. 409 if the role still has active assignments (delete those first).

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | SYSTEM role record removed from `portal_backend` DB |
  | Config Adapter | — |
  | External System | — |
}
