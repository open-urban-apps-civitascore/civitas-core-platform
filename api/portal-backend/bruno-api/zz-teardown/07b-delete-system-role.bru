meta {
  name: Teardown - Delete System Role
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/roles/{{systemRoleId}}
  body: none
  auth: inherit
}

tests {
  test("System Role deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=invalid ID, 409=has active assignments
    expect(status === 204 || status === 404 || status === 400 || status === 409).to.be.true;
  });
}
