meta {
  name: Teardown - Delete Group
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/groups/{{groupId}}
  body: none
  auth: inherit
}

tests {
  test("Group deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=invalid ID
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}
