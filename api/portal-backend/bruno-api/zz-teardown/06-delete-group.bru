meta {
  name: Teardown - Delete Group
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/groups/{{groupId}}
  body: none
  auth: inherit
}

tests {
  test("Group deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=invalid ID
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}

docs {
  **Expected Response:** 204 No Content.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Group record removed from `portal_backend` DB |
  | Config Adapter | Produces `de.civitascore.idm.group.deleted` Kafka event; forwards deletion to Keycloak |
  | Keycloak | Group removed from `civitas-core` realm |
}
