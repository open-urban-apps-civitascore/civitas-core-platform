meta {
  name: Create Data Structure
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/datastructures
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Sensor Data Structure",
    "description": "Data structure for sensor readings",
    "assignments": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('dataStructureId', res.body.id);
    bru.setVar('scopeType', 'DATASTRUCTURE');
    bru.setVar('scopeId', res.body.id);
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Has id", function() {
    expect(res.body.id).to.be.a('string');
  });
  test("Has name", function() {
    expect(res.body.name).to.be.a('string');
  });
  test("Has dataStructureStatus", function() {
    expect(res.body.dataStructureStatus).to.be.a('string');
  });
}

docs {
  **Expected Response:** 201 Created, body contains `id`.

  **Post-condition:** Save `dataStructureId` from `body.id`.

  **System Impact:**

  | Layer | Impact | Status |
  |---|---|---|
  | Backend | DataStructure record created in `portal_backend` DB | --- |
  | Config Adapter | --- | --- |
  | External System | --- | --- |
}
