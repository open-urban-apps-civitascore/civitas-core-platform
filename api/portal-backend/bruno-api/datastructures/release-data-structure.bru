meta {
  name: Release Data Structure
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/datastructures/:dataStructureId/release
  body: none
  auth: inherit
}

params:path {
  dataStructureId: {{dataStructureId}}
}

tests {
  test("Release accepted or precondition not met", function() {
    const status = res.getStatus();
    // 200=released, 400=not in DRAFT state
    expect(status === 200 || status === 400).to.be.true;
  });
}

docs {
  **Precondition:** `dataStructureId` is set and in draft state.

  **Expected Response:** 200 OK, body reflects data structure in released state.

  **System Impact:**

  | Layer | Impact | Status |
  |---|---|---|
  | Backend | DataStructure status updated to released | --- |
  | Config Adapter | --- | --- |
}
