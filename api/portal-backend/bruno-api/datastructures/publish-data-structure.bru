meta {
  name: Publish Data Structure
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/datastructures/:dataStructureId/publish
  body: none
  auth: inherit
}

params:path {
  dataStructureId: {{dataStructureId}}
}

tests {
  test("Publish accepted or precondition not met", function() {
    const status = res.getStatus();
    // 200=published, 400=not in DRAFT state
    expect(status === 200 || status === 400).to.be.true;
  });
}
