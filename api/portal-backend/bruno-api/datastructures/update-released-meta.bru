meta {
  name: Update Published Data Structure Meta
  type: http
  seq: 18
}

put {
  url: {{baseUrl}}/datastructures/:dataStructureId/published/meta
  body: json
  auth: inherit
}

params:path {
  dataStructureId: {{dataStructureId}}
}

body:json {
  {
    "name": "Updated Name",
    "description": "Updated description for published data structure"
  }
}

tests {
  test("Updated or not published", function() {
    const status = res.getStatus();
    // 200=updated, 400=data structure not in published state
    expect(status === 200 || status === 400).to.be.true;
  });
}

docs {
  **Precondition:** `dataStructureId` is set and in published state.

  **Expected Response:** 200 OK, published name and description are updated.

  **System Impact:**

  | Layer | Impact | Status |
  |---|---|---|
  | Backend | Published DataStructure name/description updated | --- |
  | Config Adapter | --- | --- |
  | Model Atlas | Metadata updated in Model Atlas | --- |
}
