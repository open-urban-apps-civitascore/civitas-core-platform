meta {
  name: Get All Data Structure Versions
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/datastructures/:dataStructureId/versions
  body: none
  auth: inherit
}

params:path {
  dataStructureId: {{dataStructureId}}
}

params:query {
  ~page: 0
  ~size: 20
  ~sort: createdAt,DESC
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Returns paginated list", function() {
    expect(res.body.content).to.be.an('array');
  });
}
