meta {
  name: Unpublish Data Structure
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/datastructures/:dataStructureId/unpublish
  body: none
  auth: inherit
}

params:path {
  dataStructureId: {{dataStructureId}}
}

tests {
  test("Unpublish accepted or not published", function() {
    const status = res.getStatus();
    // 200=unpublished, 400=not in published state
    expect(status === 200 || status === 400).to.be.true;
  });
}
