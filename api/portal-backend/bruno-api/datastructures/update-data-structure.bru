meta {
  name: Update Data Structure
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/datastructures/:id
  body: json
  auth: inherit
}

params:path {
  id: {{dataStructureId}}
}

body:json {
  {
    "name": "Sensor Data Structure",
    "description": "Updated data structure for sensor readings",
    "createdFromDataSource": false,
    "dataStructureVersionIds": [],
    "assignments": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('dataStructureId', res.body.id);
  }
}
