meta {
  name: Create Data Structure Version
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/datastructures/:dataStructureId/versions
  body: json
  auth: inherit
}

params:path {
  dataStructureId: {{dataStructureId}}
}

body:json {
  {
    "dataStructureVersionSource": "OWN",
    "description": "Initial version",
    "modelName": "StudentDatabaseModel1",
    "model": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "StudentDatabaseModel1",
      "type": "object",
      "properties": {
        "attribut": { "type": "string" }
      }
    },
    "styles": {}
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('dataStructureVersionId', res.body.id);
    bru.setVar('scopeType', 'DATASTRUCTURE');
    bru.setVar('scopeId', bru.getVar('dataStructureId'));
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Has id", function() {
    expect(res.body.id).to.be.a('string');
  });
  test("Has version", function() {
    expect(res.body.version).to.be.a('string');
  });
  test("Has dataStructureVersionStatus", function() {
    expect(res.body.dataStructureVersionStatus).to.be.a('string');
  });
}

docs {
  **Precondition:** `dataStructureId` is set.

  **Expected Response:** 201 Created, body contains `id`.

  **Post-condition:** Save `dataStructureVersionId` from `body.id`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Version record created in `portal_backend` DB, linked to the DataStructure |
  | Config Adapter | -- |
  | External System | -- |
}
