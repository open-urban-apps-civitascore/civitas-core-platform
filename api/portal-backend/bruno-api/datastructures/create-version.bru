meta {
  name: Create Data Structure Version
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/datastructures/:dataStructureId/versions
  body: json
  auth: inherit
}

params:path {
  dataStructureId: {{dataStructureId}}
}

body:json {
  {
    "dataStructureVersionSource": "OWN",
    "version": "1.0.0",
    "description": "Initial version",
    "modelAtlasUri": null,
    "modelName": "SensorModel",
    "model": null,
    "styles": {}
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('dataStructureVersionId', res.body.id);
  }
}
