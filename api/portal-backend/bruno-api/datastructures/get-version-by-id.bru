meta {
  name: Get Data Structure Version by ID
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/datastructures/:dataStructureId/versions/:id
  body: none
  auth: bearer
}

params:path {
  dataStructureId: {{dataStructureId}}
  id: {{dataStructureVersionId}}
}

auth:bearer {
  token: {{accessToken}}
}
