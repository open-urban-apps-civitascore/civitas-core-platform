meta {
  name: Update Data Structure Version
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/datastructures/:dataStructureId/versions/:id
  body: json
  auth: inherit
}

params:path {
  dataStructureId: {{dataStructureId}}
  id: {{dataStructureVersionId}}
}

body:json {
  {
    "dataStructureVersionSource": "OWN",
    "version": "1.0.4",
    "description": "Updated version",
    "modelName": "StudentDatabaseModel1",
    "model": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "StudentDatabaseModel1",
      "type": "object",
      "properties": {
        "attribut": { "type": "string" }
      }
    },
    "styles": {}
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('dataStructureVersionId', res.body.id);
    bru.setVar('scopeType', 'DATASTRUCTURE');
    bru.setVar('scopeId', bru.getVar('dataStructureId'));
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Precondition:** `dataStructureId` and `dataStructureVersionId` are set.

  **Expected Response:** 200 OK, body reflects updated values.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Version record updated in `portal_backend` DB |
  | Config Adapter | -- |
  | External System | -- |
}
