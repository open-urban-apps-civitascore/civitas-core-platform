meta {
  name: Publish Data Structure Version
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/datastructures/:dataStructureId/versions/:versionId/publish
  body: none
  auth: bearer
}

params:path {
  dataStructureId: {{dataStructureId}}
  versionId: {{dataStructureVersionId}}
}

auth:bearer {
  token: {{accessToken}}
}
