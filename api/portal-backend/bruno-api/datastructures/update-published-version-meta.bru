meta {
  name: Update Published Version Meta
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/datastructures/:dataStructureId/versions/:versionId/published/meta
  body: json
  auth: inherit
}

params:path {
  dataStructureId: {{dataStructureId}}
  versionId: {{dataStructureVersionId}}
}

body:json {
  {
    "dataStructureVersionSource": "OWN",
    "version": "1.0.1",
    "modelName": "UpdatedModelName",
    "styles": {}
  }
}

tests {
  test("Updated or not published", function() {
    const status = res.getStatus();
    // 200=updated, 400=version not in published state
    expect(status === 200 || status === 400).to.be.true;
  });
}
