meta {
  name: Get Data Structure by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/datastructures/:id
  body: none
  auth: inherit
}

params:path {
  id: {{dataStructureId}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Has correct id", function() {
    expect(res.body.id).to.be.a('string');
  });
}

docs {
  **Precondition:** `dataStructureId` is set.

  **Expected Response:** 200 OK, body contains the data structure with matching `id`
}
