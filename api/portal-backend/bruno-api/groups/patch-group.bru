meta {
  name: Patch Group
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/groups/:id
  body: json
  auth: inherit
}

params:path {
  id: {{groupId}}
}

body:json {
  {
    "description": "Patched description"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('groupId', res.body.id);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
