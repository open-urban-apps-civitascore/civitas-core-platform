meta {
  name: Patch Group
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/groups/:id
  body: json
  auth: inherit
}

params:path {
  id: {{groupId}}
}

body:json {
  {
    "description": "Patched description"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('groupId', res.body.id);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Precondition:** `groupId` is set.

  **Expected Response:** 200 OK, body reflects updated `description`; other fields unchanged.

  **Post-condition:** Save `groupId` from `body.id`.

  **System Impact:**

  | Component | Effect |
  |---|---|
  | **Backend** | Group `description` updated; other fields unchanged |
  | **Config Adapter** | Consumes `de.civitascore.idm.group.updated` Kafka event; forwards update to Keycloak |
  | **Keycloak** | Group description updated |
}
