meta {
  name: Get All Groups
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/groups
  body: none
  auth: inherit
}

params:query {
  ~page: 0
  ~size: 20
  ~sort: createdAt,DESC
  ~name: Engineering
  ~description: Development team
  ~contactUserId: user-123
  ~parentGroupId: group-456
  ~q: team
}
