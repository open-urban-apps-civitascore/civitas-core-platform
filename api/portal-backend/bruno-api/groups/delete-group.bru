meta {
  name: Delete Group
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/groups/:id
  body: none
  auth: inherit
}

params:path {
  id: {{groupId}}
}

script:post-response {
  const setupId = bru.getVar('setupGroupId');
  if (setupId) {
    bru.setVar('groupId', setupId);
  }
}

tests {
  test("Status code is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
