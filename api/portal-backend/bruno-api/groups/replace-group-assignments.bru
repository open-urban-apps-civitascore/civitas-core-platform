meta {
  name: Replace Group Assignments
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/groups/:id/assignments
  body: json
  auth: inherit
}

params:path {
  id: {{groupId}}
}

body:json {
  [
    {
      "roleId": "{{roleId}}",
      "scopeType": "{{scopeType}}",
      "scopeId": "{{scopeId}}"
    }
  ]
}

tests {
  test("Assignments replaced or scope unavailable", function() {
    const status = res.getStatus();
    // 200=replaced, 400=invalid scope reference, 404=group already deleted
    expect(status === 200 || status === 400 || status === 404).to.be.true;
  });
}
