meta {
  name: Create Group
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/groups
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Engineering",
    "description": "Engineering team",
    "contactUserId": null,
    "parentGroupId": null,
    "memberIds": [],
    "roleIds": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('groupId', res.body.id);
  }
}
