meta {
  name: Get Style by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/datasets/:dataSetId/styles/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
  id: {{styleId}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Has correct id", function() {
    expect(res.body.id).to.be.a('string');
  });
  test("Has name", function() {
    expect(res.body.name).to.be.a('string');
  });
}

docs {
  **Precondition:** `dataSetId` and `styleId` are set.

  **Expected Response:** 200 OK, body contains the Style with matching `id`, including the `inUse` flag (true when any Layer references it as default or alternative).
}
