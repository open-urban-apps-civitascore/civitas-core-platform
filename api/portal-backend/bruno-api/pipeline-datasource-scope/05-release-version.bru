meta {
  name: 05. Release DataStructure Version
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/datastructures/:dataStructureId/versions/:versionId/release
  body: none
  auth: inherit
}

params:path {
  dataStructureId: {{scopeDataStructureId}}
  versionId: {{scopeVersionId}}
}

tests {
  test("Released or already released", function() {
    const status = res.getStatus();
    // 200=released, 400=already released
    expect(status === 200 || status === 400).to.be.true;
  });
}

docs {
  A data source can only be released once the version it pins is released.
}
