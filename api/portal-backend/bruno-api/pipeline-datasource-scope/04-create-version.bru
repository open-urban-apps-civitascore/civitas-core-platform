meta {
  name: 04. Create DataStructure Version
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/datastructures/:dataStructureId/versions
  body: json
  auth: inherit
}

params:path {
  dataStructureId: {{scopeDataStructureId}}
}

body:json {
  {
    "dataStructureVersionSource": "OWN",
    "version": "1.0.0",
    "description": "Initial version for scope-test data structure",
    "modelAtlasUri": "http://civitas.org/model/ScopeTestModel/1.0.0",
    "modelName": "ScopeTestModel",
    "model": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<uml:Model xmi:version=\"20131001\" xmlns:xmi=\"http://www.omg.org/spec/XMI/20131001\" xmlns:uml=\"http://www.eclipse.org/uml2/5.0.0/UML\" xmi:id=\"_0a53777b-5a46-4412-bbf1-e192f65cf8d8_model\" name=\"Untitled Diagram\" URI=\"http://civitas.org/model/ScopeTestModel/1.0.0\">\n  <packagedElement xmi:type=\"uml:Package\" xmi:id=\"_757a28a4-9e8c-4947-a0ec-2e29dd6c37ab\" name=\"untitled-diagram\" URI=\"http://civitas.org/model/untitled-diagram\">\n    <packagedElement xmi:type=\"uml:Class\" xmi:id=\"_8a9067df-cc7d-4d8a-b32f-1dba74517365\" name=\"NeueKlasse\">\n      <ownedAttribute xmi:id=\"_8b3cf4f9-40d1-488b-adcb-b7c9d6b2cfc6\" name=\"attribut\" visibility=\"private\">\n        <type xmi:type=\"uml:PrimitiveType\" href=\"http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String\"/>\n      </ownedAttribute>\n    </packagedElement>\n  </packagedElement>\n</uml:Model>",
    "styles": {}
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('scopeVersionId', res.body.id);
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("scopeVersionId is set", function() {
    expect(bru.getVar('scopeVersionId')).to.be.a('string');
  });
}

docs {
  **Precondition:** `scopeDataStructureId` set. **Post-condition:** saves `scopeVersionId`.
}
