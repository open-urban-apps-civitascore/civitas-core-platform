meta {
  name: Get All Mappings
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/datasets/:dataSetId/mappings
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
}

tests {
  test("Mappings listed", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body).to.be.an('array');
  });

  test("Lists the created mapping", function() {
    const ids = res.body.map((mapping) => mapping.mappingId);
    expect(ids).to.include(bru.getVar('mappingId'));
  });
}

docs {
  **Precondition:** `dataSetId` and `mappingId` are set.

  **Expected Response:** 200 OK with an array of `{mappingId, logicalUrn, title}`, one entry per
  mapping of the dataset.
}
