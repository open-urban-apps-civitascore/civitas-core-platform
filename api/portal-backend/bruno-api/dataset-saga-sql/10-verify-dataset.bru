meta {
  name: 10. Verify DataSet (SQL-source saga complete)
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/datasets/:id
  body: none
  auth: inherit
}

params:path {
  id: {{sqlDataSetId}}
}

script:pre-request {
  // Poll the dataset until the DATASET_CREATE saga has fully completed: pendingSagaType
  // cleared and status AVAILABLE. The PostGIS sink + NiFi flow provisioning runs
  // asynchronously, so this endpoint may still show pendingSagaType=CREATE on first
  // reach. This wait is the assertion that the PostGIS + geoPoint saga path succeeded.
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl');
  const keycloakUrl = bru.getEnvVar('keycloakUrl');
  const datasetId = bru.getVar('sqlDataSetId');

  // Bruno's QuickJS sandbox has no URLSearchParams — build the form body by hand.
  const form = [
    ['grant_type', 'password'],
    ['client_id', bru.getEnvVar('clientId')],
    ['client_secret', bru.getEnvVar('clientSecret')],
    ['username', bru.getEnvVar('username')],
    ['password', bru.getEnvVar('password')],
  ].map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join('&');

  const tokenResp = await axios.post(
    `${keycloakUrl}/realms/${bru.getEnvVar('realm')}/protocol/openid-connect/token`,
    form,
    { headers: { 'Content-Type': 'application/x-www-form-urlencoded' } }
  );
  const token = tokenResp.data.access_token;

  for (let i = 0; i < 30; i++) {
    // The QuickJS sandbox does not honour validateStatus across the VM boundary, so a
    // transient 401/403 while OPA data propagates rejects the promise. Guard each attempt
    // separately so one such response does not abort the whole poll.
    let resp;
    try {
      resp = await axios.get(
        `${baseUrl}/datasets/${datasetId}`,
        { headers: { 'Authorization': `Bearer ${token}` } }
      );
    } catch (e) { /* transient; retry */ }
    // Settled = saga no longer pending. Either it succeeded (AVAILABLE) or it failed and
    // compensated (back to READY). Break on EITHER so a red run fails fast with a clear status
    // instead of burning the full 60s timeout.
    if (resp && resp.status === 200 && resp.data && resp.data.pendingSagaType === null) {
      if (resp.data.publicUrl) {
        bru.setVar('sqlPublicUrl', resp.data.publicUrl);
      }
      break;
    }
    await new Promise(r => setTimeout(r, 2000));
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("DATASET_CREATE saga settled (pendingSagaType cleared)", function() {
    expect(res.body.pendingSagaType).to.be.null;
  });

  test("Status is AVAILABLE (SQL source deployed)", function() {
    // The core acceptance assertion: the DATASET_CREATE saga deployed the NiFi flow with the
    // SQL source. If deploy failed (today: "SQL source not yet supported"), the saga compensates
    // and the dataset reverts to READY — so this is the RED gate that turns green once the SQL
    // source is implemented. A READY here means the deploy was rejected.
    expect(res.body.dataSetStatus).to.equal('AVAILABLE');
  });
}

docs {
  **SQL saga step 10** — Poll dataset status after releasing, then assert the saga deployed.

  The DATASET_CREATE saga runs asynchronously (FROST → APISIX → PostGIS table → NiFi flow). The
  pre-request loop polls until the saga has **settled** (`pendingSagaType` cleared), whether it
  succeeded (`AVAILABLE`) or failed and compensated (`READY`).

  **TDD red gate:** with a SQL source the NiFi deploy currently fails (`SQL source not yet
  supported`), so the saga compensates and the dataset stays `READY` → the `AVAILABLE` assertion
  fails. This is expected until the SQL source is implemented; the test then turns green and proves
  the SQL-source → pipeline → NiFi deploy path end-to-end — the path no existing test covers.

  **Expected Response (after fix):** 200 OK; `dataSetStatus` is `AVAILABLE` and `pendingSagaType` is `null`.
}
