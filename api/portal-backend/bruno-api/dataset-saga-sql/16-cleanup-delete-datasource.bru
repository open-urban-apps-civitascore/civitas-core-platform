meta {
  name: 16. Cleanup - Delete DataSource
  type: http
  seq: 27
}

delete {
  url: {{baseUrl}}/datasources/:id
  body: none
  auth: inherit
}

params:path {
  id: {{sqlDataSourceId}}
}

tests {
  test("DataSource deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone
    expect(status === 204 || status === 404).to.be.true;
  });
}

docs {
  **SQL saga step 16** — Delete the datasource (cleanup).

  Removes the SQL datasource created in step 1. The pipeline must have been deleted first (step 14) and the datasource unreleased to `DRAFT` (step 15b) — a released (`AVAILABLE`) datasource cannot be deleted.

  **Expected Response:** 204 No Content. 404 if already deleted.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSource record removed from `portal_backend` DB |
  | Config Adapter | — |
  | External System | — |
}
