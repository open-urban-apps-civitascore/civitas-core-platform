meta {
  name: 11a. Verify DELETE saga complete
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/datasets/:id
  body: none
  auth: inherit
}

params:path {
  id: {{sqlDataSetId}}
}

script:pre-request {
  // Wait for the DATASET_DELETE saga to finish (pendingSagaType cleared, status READY)
  // before unstaging/deleting. Without this wait, unstage (step 12) and delete (step 15)
  // would 400 with a still-pending saga and the teardown would leak resources.
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl');
  const keycloakUrl = bru.getEnvVar('keycloakUrl');
  const datasetId = bru.getVar('sqlDataSetId');

  // Bruno's QuickJS sandbox has no URLSearchParams — build the form body by hand.
  const form = [
    ['grant_type', 'password'],
    ['client_id', bru.getEnvVar('clientId')],
    ['client_secret', bru.getEnvVar('clientSecret')],
    ['username', bru.getEnvVar('username')],
    ['password', bru.getEnvVar('password')],
  ].map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join('&');

  const tokenResp = await axios.post(
    `${keycloakUrl}/realms/${bru.getEnvVar('realm')}/protocol/openid-connect/token`,
    form,
    { headers: { 'Content-Type': 'application/x-www-form-urlencoded' } }
  );
  const token = tokenResp.data.access_token;

  for (let i = 0; i < 30; i++) {
    // The QuickJS sandbox does not honour validateStatus across the VM boundary, so any non-2xx
    // rejects the promise. Guard each attempt and keep the response off the error, so a 404
    // (dataset already gone) is still seen while a transient 401/403 just retries.
    let resp;
    try {
      resp = await axios.get(
        `${baseUrl}/datasets/${datasetId}`,
        { headers: { 'Authorization': `Bearer ${token}` } }
      );
    } catch (e) {
      resp = e.response;
    }
    if (resp && resp.status === 404) break; // already deleted by a previous run
    if (resp && resp.status === 200 && resp.data && resp.data.pendingSagaType === null
        && resp.data.dataSetStatus === 'READY') {
      break;
    }
    await new Promise(r => setTimeout(r, 2000));
  }
}

tests {
  test("Status code is 200 or 404", function() {
    const status = res.getStatus();
    // 200=present (saga done), 404=already deleted in a previous run
    expect(status === 200 || status === 404).to.be.true;
  });

  test("DELETE saga completed (pendingSagaType cleared, status READY)", function() {
    if (res.getStatus() === 200) {
      expect(res.body.pendingSagaType).to.be.null;
      expect(res.body.dataSetStatus).to.equal('READY');
    }
  });
}

docs {
  **SQL saga step 11a** — Poll until the DATASET_DELETE saga has completed.

  Mirrors step 10 but waits for the delete saga: polls (up to 60s) until `pendingSagaType` is `null`. Required so the unstage (step 12) and delete (step 15) steps don't 400 on a still-pending saga. Tolerates 404 if a previous run already deleted the dataset.

  **Expected Response:** 200 OK with `pendingSagaType: null` (delete saga done), or 404 if already gone.
}
