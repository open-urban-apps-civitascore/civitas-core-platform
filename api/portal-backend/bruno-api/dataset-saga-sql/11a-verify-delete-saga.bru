meta {
  name: 11a. Verify DELETE saga complete
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/datasets/:id
  body: none
  auth: inherit
}

params:path {
  id: {{sqlDataSetId}}
}

script:pre-request {
  // Wait for the DATASET_DELETE saga to finish (pendingSagaType cleared, status READY)
  // before unstaging/deleting. Without this wait, unstage (step 12) and delete (step 15)
  // would 400 with a still-pending saga and the teardown would leak resources.
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl');
  const keycloakUrl = bru.getEnvVar('keycloakUrl');
  const datasetId = bru.getVar('sqlDataSetId');

  // Bruno's QuickJS sandbox has no URLSearchParams — build the form body by hand.
  const form = [
    ['grant_type', 'password'],
    ['client_id', bru.getEnvVar('clientId')],
    ['client_secret', bru.getEnvVar('clientSecret')],
    ['username', bru.getEnvVar('username')],
    ['password', bru.getEnvVar('password')],
  ].map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join('&');

  const tokenResp = await axios.post(
    `${keycloakUrl}/realms/${bru.getEnvVar('realm')}/protocol/openid-connect/token`,
    form,
    { headers: { 'Content-Type': 'application/x-www-form-urlencoded' } }
  );
  const token = tokenResp.data.access_token;

  for (let i = 0; i < 30; i++) {
    const resp = await axios.get(
      `${baseUrl}/datasets/${datasetId}`,
      {
        headers: { 'Authorization': `Bearer ${token}` },
        validateStatus: () => true,
      }
    );
    if (resp.status === 200 && resp.data && resp.data.pendingSagaType === null
        && resp.data.dataSetStatus === 'READY') {
      break;
    }
    await new Promise(r => setTimeout(r, 2000));
  }
}

tests {
  test("Status code is 200", function() {
    // The unrelease saga preserves the sink and keeps the dataset — it is never deleted here.
    expect(res.getStatus()).to.equal(200);
  });

  test("UNRELEASE saga completed (pendingSagaType cleared, status READY)", function() {
    expect(res.body.pendingSagaType).to.be.null;
    expect(res.body.dataSetStatus).to.equal('READY');
  });

  test("Sink stays provisioned (data preserved)", function() {
    // The PostGIS table survives the unrelease; the dataset remains flagged provisioned.
    expect(res.body.provisioned).to.equal(true);
  });
}

docs {
  **SQL saga step 11a** — Poll until the DATASET_UNRELEASE saga has completed.

  Mirrors step 10 but waits for the unrelease saga: polls (up to 60s) until `pendingSagaType` is `null` and status is `READY`. Required so the unstage (step 12) step doesn't 400 on a still-pending saga. Unlike a delete, the dataset is **not** removed — it returns to `READY` with its sink (PostGIS table) intact and `provisioned` still `true`, ready for a re-release without data loss.

  **Expected Response:** 200 OK with `pendingSagaType: null`, `dataSetStatus: READY`, `provisioned: true`.
}
