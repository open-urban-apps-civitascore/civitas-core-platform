meta {
  name: Get Layer by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/datasets/:dataSetId/layers/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
  id: {{layerId}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Has correct id", function() {
    expect(res.body.id).to.be.a('string');
  });
  test("Has layerName", function() {
    expect(res.body.layerName).to.be.a('string');
  });
}

docs {
  **Precondition:** `dataSetId` and `layerId` are set.

  **Expected Response:** 200 OK, body contains the Layer with matching `id`, including `dataSinkId`, `defaultStyleId`, `alternativeStyleIds`, and (once provisioned) `geometryType` and `nativeCRS`.
}
