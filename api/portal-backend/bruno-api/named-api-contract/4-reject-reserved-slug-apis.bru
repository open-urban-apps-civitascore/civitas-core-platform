meta {
  name: 4. Reject the reserved slug apis
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/datasets
  body: json
  auth: inherit
}


body:json {
  {
    "name": "Named API Contract Reserved Apis",
    "description": "Negative fixture — the reserved slug must be the only reason this create fails.",
    "openDataAccess": false,
    "namedApis": [
      { "name": "Reserved Apis", "slug": "apis", "standard": "STA", "version": "1.1" }
    ]
  }
}

tests {
  const body = res.body || {};
  // Bean-validation failures put the reason in the per-field message, not in `detail`.
  const fieldMessages = (body.fieldErrors || []).map(function(fe) { return fe.message; }).join(' ');
  const problemText = [body.detail, body.title, fieldMessages].join(' ').toLowerCase();

  test("Status code is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Response is a problem document", function() {
    expect(body.detail !== undefined || body.title !== undefined).to.be.true;
  });
  test("Rejection states the slug is reserved", function() {
    expect(problemText).to.contain('reserved');
  });
}

docs {
  **Contract step 4** — Reject the reserved slug `apis`.

  `apis` would collide with the discovery endpoint `GET /v1/datasets/{id}/apis`: a named API using
  it would claim the same path segment as the platform's own route listing, so the reserved-slug
  blocklist rejects it at validation time rather than letting the release saga register a shadowing
  APISIX route.

  Everything else in the body is valid, so a 400 here can only come from the slug.

  **Precondition:** none.

  **Expected Response:** 400 Bad Request, `application/problem+json` whose field error names the
  slug as reserved.

  **Post-condition:** none — no dataset is created, so nothing to clean up.
}
