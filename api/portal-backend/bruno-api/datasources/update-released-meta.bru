meta {
  name: Update Released Data Source Meta
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/datasources/:id/released/meta
  body: json
  auth: inherit
}

params:path {
  id: {{dataSourceId}}
}

body:json {
  {
    "name": "Updated Source Name",
    "description": "Updated description for released data source",
    "assignments": []
  }
}

tests {
  test("Updated or not released", function() {
    const status = res.getStatus();
    // 200=updated, 400=datasource not in released state
    expect(status === 200 || status === 400).to.be.true;
  });
}

docs {
  **Precondition:** `dataSourceId` is set and in released state.

  **Expected Response:** 200 OK, released name and description are updated.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Released DataSource name/description updated |
  | Config Adapter | Consumes `de.civitascore.api.backend.updated` Kafka event; updates route metadata in APISIX |
  | APISIX | Route metadata updated |
}
