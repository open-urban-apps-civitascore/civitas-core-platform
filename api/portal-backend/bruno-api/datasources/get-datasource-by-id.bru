meta {
  name: Get Data Source by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/datasources/:id
  body: none
  auth: inherit
}

params:path {
  id: {{dataSourceId}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Has correct id", function() {
    expect(res.body.id).to.be.a('string');
  });
}
