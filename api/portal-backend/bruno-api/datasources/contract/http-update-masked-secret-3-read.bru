meta {
  name: Contract HTTP — update with masked password (3/4 read-back)
  type: http
  seq: 109
}

get {
  url: {{baseUrl}}/datasources/{{contractHttpMaskedSecretId}}
  body: none
  auth: inherit
}


tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Password remains masked on read-back", function() {
    expect(res.body.connector.authentication.password).to.equal("********");
  });
  test("No response field holds the password in clear text", function() {
    expect(JSON.stringify(res.body)).to.not.include("http-s3cret");
  });
}
