meta {
  name: Contract MQTT — connection test answers
  type: http
  seq: 131
}

post {
  url: {{baseUrl}}/datasources/connection-test
  body: json
  auth: inherit
}


body:json {
  {
    "connector": {
      "connectorType": "MQTT",
      "urls": ["tcp://broker.invalid:1883"],
      "topics": ["sensor/#"],
      "qos": 1
    }
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Body has the connection test result shape", function() {
    const body = res.body;
    expect(body.success).to.be.a('boolean');
    expect(body).to.have.property('message');
    expect(body).to.have.property('rowCount');
    expect(body).to.have.property('httpStatus');
  });
  test("The connection test service answers that the host is unknown", function() {
    expect(res.body.success).to.equal(false);
    expect(res.body.reason).to.equal("SOURCE_ERROR");
    expect(res.body.message).to.equal("The host 'broker.invalid' is unknown.");
  });
}

docs {
  Pins the answer of a connection test for unsaved MQTT values. An
  MQTT connector names no `apiCall`. The `.invalid` host never resolves
  (RFC 6761), so the connection test service answers `SOURCE_ERROR`.
}
