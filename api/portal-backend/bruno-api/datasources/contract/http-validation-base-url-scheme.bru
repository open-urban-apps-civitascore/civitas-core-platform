meta {
  name: Contract HTTP — validation: base URL scheme
  type: http
  seq: 112
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_http_invalid_scheme",
    "description": "contract — HTTP",
    "connector": {
      "connectorType": "HTTP",
      "baseUrl": "ftp://api.example.org"
    },
    "dataStructureVersionId": null
  }
}

tests {
  test("Status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Error body matches the MALFORMED_REQUEST contract", function() {
    expect(res.body.type).to.equal("urn:civitas:error:MALFORMED_REQUEST");
    expect(res.body.title).to.equal("Bad Request");
    expect(res.body.status).to.equal(400);
    expect(res.body.detail).to.equal("Invalid value: connector.baseUrl");
  });
}

docs {
  The API host is a target for outbound requests from the cluster, so
  only `http` and `https` are accepted. The detail names the key, not the
  value.
}
