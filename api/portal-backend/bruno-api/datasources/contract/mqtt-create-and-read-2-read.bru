meta {
  name: Contract MQTT — create + read (2/3 read)
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/datasources/{{contractMqttCreateId}}
  body: none
  auth: inherit
}


tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Read returns the same shape as create", function() {
    expect(res.body.name).to.equal("contract_mqtt_create");
    expect(res.body.description).to.equal("contract — MQTT");
    expect(res.body.connectorType).to.equal("MQTT");
    expect(res.body.dataSourceStatus).to.equal("DRAFT");
    expect(res.body.inUse).to.equal(false);
    expect(res.body.configuration.urls).to.deep.equal(["tcp://broker:1883"]);
    expect(res.body.configuration.topics).to.deep.equal(["sensor/data"]);
    expect(res.body.configuration.qos).to.equal(1);
    expect(res.body.configuration.tls).to.deep.equal({ enabled: false });
    expect(res.body.configuration).to.have.property('user', null);
    expect(res.body.configuration).to.have.property('password', null);
    expect(res.body.configuration).to.have.property('keepalive', null);
    expect(res.body.configuration).to.have.property('connect_timeout', null);
  });
}
