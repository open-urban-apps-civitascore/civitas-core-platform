meta {
  name: Contract HTTP — validation: cursor names and JSON paths
  type: http
  seq: 139
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_http_cursor_and_json_path",
    "description": "contract — HTTP",
    "connector": {
      "connectorType": "HTTP",
      "baseUrl": "https://api.example.org",
      "authentication": { "type": "API_TOKEN", "name": "x-cursor", "value": "secret", "in": "HEADER" },
      "apiCalls": [
        {
          "name": "events",
          "path": "/events",
          "headers": [{ "name": "X-Cursor", "value": "1" }],
          "pagination": { "type": "CURSOR", "cursorPath": "$..cursor", "cursorParameter": "x-cursor", "cursorIn": "HEADER", "limitParameter": "limit", "limit": 20 }
        },
        {
          "name": "items",
          "path": "/items",
          "pagination": { "type": "LIMIT_OFFSET", "limitParameter": "n", "offsetParameter": "n", "countPath": "$.items[?(@.id)]" }
        },
        {
          "name": "links",
          "path": "/links",
          "pagination": {
            "type": "NEXT_LINK",
            "nextLinkPath": "$..next",
            "maxLinks": 0
          }
        }
      ]
    },
    "dataStructureVersionId": null
  }
}

tests {
  test("Status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Error body names each colliding name and each JSON path that is not only member names and indexes", function() {
    expect(res.body.type).to.equal("urn:civitas:error:VALIDATION_FAILED");
    expect(res.body.fieldErrors.map(function(e) { return e.field; })).to.have.members([
      "connector.authentication.name",
      "connector.apiCalls[0].pagination.cursorParameter",
      "connector.apiCalls[0].pagination.cursorPath",
      "connector.apiCalls[2].pagination.nextLinkPath",
      "connector.apiCalls[2].pagination.maxLinks",
      "connector.apiCalls[1].pagination.offsetParameter",
      "connector.apiCalls[1].pagination.countPath"
    ]);
  });
}

docs {
  Header names collide regardless of case. A JSON path holds only member
  names and array indexes, so the processor evaluates no filter or
  script expression. The rules run on every write, not only at release.
}
