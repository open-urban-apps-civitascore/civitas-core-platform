meta {
  name: Contract SQL — release rejects empty config (2/6 release DSV)
  type: http
  seq: 40
}

post {
  url: {{baseUrl}}/datastructures/{{setupDataStructureId}}/versions/{{contractSqlReleaseEmptyDsvId}}/release
  body: none
  auth: inherit
}


tests {
  test("DSV released (200)", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("DSV status is AVAILABLE", function() {
    expect(res.body.dataStructureVersionStatus).to.equal("AVAILABLE");
  });
}

docs {
  Releases the DSV created in step 1 so it becomes AVAILABLE. Required
  because `DataSourceService.validateDataStructureVersionLinkable` rejects
  linking a DRAFT DSV — step 3's DataSource POST would fail with 400
  otherwise. The DSV's Model Atlas upload (configured in step 1's body)
  must already have succeeded for this release to pass; the saga workflow
  uses the same pattern.
}
