meta {
  name: Contract SQL — PATCH of another host (2/4 patch)
  type: http
  seq: 140
}

patch {
  url: {{baseUrl}}/datasources/{{contractSqlPatchOtherHostId}}
  body: json
  auth: inherit
}


body:json {
  {
    "connector": {
      "dsn": "postgres://other.example:5432/db?sslmode=require"
    }
  }
}

tests {
  test("Status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("The stored password does not follow the connector to another host", function() {
    expect(res.body.type).to.equal("urn:civitas:error:MALFORMED_REQUEST");
    expect(res.body.detail).to.match(/^The stored secret is kept only for the stored destination/);
  });
}

docs {
  Pins that a write which changes a destination of the connector (scheme,
  host, port or `sslmode`) keeps no stored password: neither an omitted
  password nor `"********"` follows the connector there. The password is
  entered again.
}
