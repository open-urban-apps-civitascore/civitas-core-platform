meta {
  name: Contract MQTT — validation: qos out of range
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_mqtt_invalid",
    "description": "x",
    "connector": {
      "connectorType": "MQTT",
      "urls": ["tcp://broker:1883"],
      "topics": ["sensor/data"],
      "qos": 99
    },
    "dataStructureVersionId": null
  }
}

tests {
  test("Status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Error body matches the VALIDATION_FAILED contract", function() {
    expect(res.body.type).to.equal("urn:civitas:error:VALIDATION_FAILED");
    expect(res.body.title).to.equal("Bad Request");
    expect(res.body.status).to.equal(400);
    expect(res.body.fieldErrors).to.deep.equal([
      { field: "connector.qos", message: "'qos' must be 0, 1, or 2" }
    ]);
  });
}

docs {
  Pins the error response for MQTT with `qos: 99` (must be 0, 1, or 2) on
  create. The range check belongs to the `Default` validation group and
  runs on every write, unlike the required-field checks, which wait for
  the release (see `mqtt-empty-config-accepted-*.bru`). The field error
  names the key path in the request body.
}
