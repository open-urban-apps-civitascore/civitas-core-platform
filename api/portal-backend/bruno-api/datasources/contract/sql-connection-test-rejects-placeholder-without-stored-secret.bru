meta {
  name: Contract SQL — connection test rejects a placeholder of unsaved values
  type: http
  seq: 134
}

post {
  url: {{baseUrl}}/datasources/connection-test
  body: json
  auth: inherit
}


body:json {
  {
    "connector": {
      "connectorType": "SQL",
      "driver": "postgres",
      "dsn": "postgres://db.invalid:5432/city",
      "user": "reader",
      "password": "********",
      "table": "readings",
      "columns": ["id"]
    }
  }
}

tests {
  test("Status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Error body names the placeholder", function() {
    expect(res.body.type).to.equal("urn:civitas:error:MALFORMED_REQUEST");
    expect(res.body.detail).to.equal("No stored secret for ******** at connector.password");
  });
}

docs {
  Unsaved values have no stored secret for `"********"` to keep. A test
  refuses the placeholder, because without the password it would test
  something else.
}
