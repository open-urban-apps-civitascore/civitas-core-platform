meta {
  name: Contract SQL — masked password without stored secret (2/4 update)
  type: http
  seq: 62
}

put {
  url: {{baseUrl}}/datasources/{{contractSqlMaskedNoSecretId}}
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_sql_masked_no_secret",
    "description": "contract — SQL without password",
    "connector": {
      "connectorType": "SQL",
      "driver": "postgres",
      "dsn": "postgres://example:5432/db",
      "user": "alice",
      "password": "********",
      "table": "events",
      "columns": ["*"]
    },
    "dataStructureVersionId": null
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("The placeholder stores no password", function() {
    expect(res.body.connector).to.have.property('password', null);
  });
}

docs {
  Pins that `"password": "********"` means "keep the stored password",
  not a password of its own: with no stored password, none is stored,
  and the placeholder never becomes the credential.
}
