meta {
  name: Contract SQL — validation: unknown connectorType
  type: http
  seq: 38
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_sql_invalid",
    "description": "x",
    "connector": { "connectorType": "NONSENSE" },
    "dataStructureVersionId": null
  }
}

tests {
  test("Status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Error body matches the MALFORMED_REQUEST contract", function() {
    expect(res.body.type).to.equal("urn:civitas:error:MALFORMED_REQUEST");
    expect(res.body.title).to.equal("Bad Request");
    expect(res.body.status).to.equal(400);
    expect(res.body.instance).to.match(/\/datasources$/);
    expect(res.body.detail).to.equal("Unknown connectorType: NONSENSE");
  });
}

docs {
  Pins the error response for a `connector` with an unknown
  `connectorType`. The connector cannot be read, so the response is the
  `urn:civitas:error:MALFORMED_REQUEST` Problem Detail, distinct from the
  `urn:civitas:error:VALIDATION_FAILED` shape for a readable connector
  with invalid values (cf. `mqtt-validation-qos-out-of-range.bru`).
}
