meta {
  name: Contract MQTT — update changes arrays (1/4 create)
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

body:json {
  {
    "name": "contract_mqtt_update",
    "description": "contract — MQTT",
    "connectorType": "MQTT",
    "configuration": {
      "urls": ["tcp://broker:1883"],
      "topics": ["sensor/data"],
      "qos": 1
    },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('contractMqttUpdateId', res.body.id);
  }
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
