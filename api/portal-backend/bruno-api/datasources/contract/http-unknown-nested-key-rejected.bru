meta {
  name: Contract HTTP — unknown nested connector key rejected
  type: http
  seq: 111
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_http_unknown_nested_key",
    "description": "contract — HTTP",
    "connector": {
      "connectorType": "HTTP",
      "baseUrl": "https://api.example.org",
      "apiCalls": [{ "name": "a", "path": "/x", "foo": "bar" }]
    },
    "dataStructureVersionId": null
  }
}

tests {
  test("Status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Error body matches the MALFORMED_REQUEST contract", function() {
    expect(res.body.type).to.equal("urn:civitas:error:MALFORMED_REQUEST");
    expect(res.body.title).to.equal("Bad Request");
    expect(res.body.status).to.equal(400);
    expect(res.body.detail).to.equal("Unknown key: connector.apiCalls[0].foo");
  });
}

docs {
  Pins that the strict reading of `connector` reaches the elements of
  `apiCalls`. Nothing is created, so no cleanup step follows.
}
