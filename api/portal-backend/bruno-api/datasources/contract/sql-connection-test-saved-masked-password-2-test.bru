meta {
  name: Contract SQL — connection test of a saved data source (2/3 test)
  type: http
  seq: 137
}

post {
  url: {{baseUrl}}/datasources/{{contractSqlConnectionTestId}}/connection-test
  body: json
  auth: inherit
}


body:json {
  {
    "connector": {
      "connectorType": "SQL",
      "driver": "postgres",
      "dsn": "postgres://db.invalid:5432/city",
      "user": "reader",
      "password": "********",
      "table": "readings",
      "columns": ["id"]
    }
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Body has the connection test result shape", function() {
    const body = res.body;
    expect(body.success).to.be.a('boolean');
    expect(body.previewTruncated).to.be.a('boolean');
    expect(body).to.have.property('message');
    expect(body).to.have.property('preview');
    expect(body).to.have.property('rowCount');
    expect(body).to.have.property('httpStatus');
  });
  test("The connection test service answers that the host is unknown", function() {
    expect(res.body.success).to.equal(false);
    expect(res.body.reason).to.equal("SOURCE_ERROR");
    expect(res.body.message).to.equal("The host 'db.invalid' is unknown.");
  });
}

docs {
  `"********"` keeps the password that the data source stores, so the
  test answers 200. `DataSourceConnectionTestIntegrationTest` pins that
  the password reaches the connection test service only encrypted.
}
