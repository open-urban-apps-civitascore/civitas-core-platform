meta {
  name: Contract SQL — connection test answers
  type: http
  seq: 130
}

post {
  url: {{baseUrl}}/datasources/connection-test
  body: json
  auth: inherit
}


body:json {
  {
    "connector": {
      "connectorType": "SQL",
      "driver": "postgres",
      "dsn": "postgres://db.invalid:5432/city",
      "user": "reader",
      "password": "s3cret",
      "table": "readings",
      "columns": ["id", "value"]
    }
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Body has the connection test result shape", function() {
    const body = res.body;
    expect(body.success).to.be.a('boolean');
    expect(body).to.have.property('message');
    expect(body).to.have.property('rowCount');
    expect(body).to.have.property('httpStatus');
    if (body.success) {
      expect(body.reason).to.equal(null);
    } else {
      expect(["INVALID_CONNECTOR", "SOURCE_ERROR", "TIMEOUT"]).to.include(body.reason);
    }
  });
}

docs {
  Pins the answer shape of a connection test for unsaved SQL values. An
  unreachable source answers `success: false`, not an error, so any
  outcome passes.
}
