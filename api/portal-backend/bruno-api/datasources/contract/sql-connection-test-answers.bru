meta {
  name: Contract SQL — connection test answers
  type: http
  seq: 130
}

post {
  url: {{baseUrl}}/datasources/connection-test
  body: json
  auth: inherit
}


body:json {
  {
    "connector": {
      "connectorType": "SQL",
      "driver": "postgres",
      "dsn": "postgres://db.invalid:5432/city",
      "user": "reader",
      "password": "s3cret",
      "table": "readings",
      "columns": ["id", "value"]
    }
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Body has the connection test result shape", function() {
    const body = res.body;
    expect(body.success).to.be.a('boolean');
    expect(body.previewTruncated).to.be.a('boolean');
    expect(body).to.have.property('message');
    expect(body).to.have.property('preview');
    expect(body).to.have.property('rowCount');
    expect(body).to.have.property('httpStatus');
  });
  test("The connection test service answers that the host is unknown", function() {
    expect(res.body.success).to.equal(false);
    expect(res.body.reason).to.equal("SOURCE_ERROR");
    expect(res.body.message).to.equal("The host 'db.invalid' is unknown.");
  });
}

docs {
  Pins the answer of a connection test for unsaved SQL values. The
  `.invalid` host never resolves (RFC 6761), so the connection test
  service answers `SOURCE_ERROR`.
}
