meta {
  name: Contract SQL — release rejects empty config (4/6 create DS)
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_sql_release_empty",
    "description": "Pins that release rejects an empty SQL connector",
    "connector": { "connectorType": "SQL" },
    "dataStructureVersionId": "{{contractSqlReleaseEmptyDsvId}}"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('contractSqlReleaseEmptyId', res.body.id);
  }
}

tests {
  test("DataSource created in DRAFT with empty connector (201)", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Status is DRAFT", function() {
    expect(res.body.dataSourceStatus).to.equal("DRAFT");
  });
}

docs {
  Creates an SQL DataSource with `connector: { "connectorType": "SQL" }`
  (the deferred-validation contract permits this on DRAFT). Step 5 attempts
  to release it and pins the rejection contract.
}
