meta {
  name: Contract SQL — unknown connector keys rejected
  type: http
  seq: 51
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_sql_unknown_fields",
    "description": "Probes how unknown connector keys are handled",
    "connector": {
      "connectorType": "SQL",
      "driver": "postgres",
      "dsn": "postgres://example:5432/db",
      "user": "alice",
      "password": "s3cret",
      "table": "events",
      "columns": ["*"],
      "username": "alice-typo",
      "query": "SELECT 1"
    },
    "dataStructureVersionId": null
  }
}

tests {
  test("Status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Error body matches the MALFORMED_REQUEST contract", function() {
    expect(res.body.type).to.equal("urn:civitas:error:MALFORMED_REQUEST");
    expect(res.body.title).to.equal("Bad Request");
    expect(res.body.status).to.equal(400);
    expect(res.body.instance).to.match(/\/datasources$/);
  });
  test("Detail names the unknown key, not its value", function() {
    expect(res.body.detail).to.match(/^Unknown key: connector\.(username|query)$/);
    expect(res.body.detail).to.not.contain("alice-typo");
    expect(res.body.detail).to.not.contain("SELECT 1");
  });
}

docs {
  Pins that a `connector` key outside the schema of its `connectorType`
  is rejected instead of dropped. The body is a valid SQL connector plus
  two unknown keys:

  - `username` — a plausible typo of the correct `user` field.
  - `query` — a name that is not part of the SQL connector schema at all.

  The request fails with 400 / `urn:civitas:error:MALFORMED_REQUEST`, and
  the detail names the first unknown key the server reads. The detail
  never echoes a value, because a value can carry a credential. Nothing
  is created, so no cleanup step follows.

  The nested case is pinned by `mqtt-unknown-nested-key-rejected.bru`.
}
