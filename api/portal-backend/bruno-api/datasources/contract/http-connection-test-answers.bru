meta {
  name: Contract HTTP — connection test answers
  type: http
  seq: 132
}

post {
  url: {{baseUrl}}/datasources/connection-test
  body: json
  auth: inherit
}


body:json {
  {
    "connector": {
      "connectorType": "HTTP",
      "baseUrl": "https://api.invalid/v1",
      "apiCalls": [
        { "name": "Get all weather stations", "path": "/stations" },
        { "name": "Get one weather station", "path": "/stations/1" }
      ]
    },
    "apiCall": "Get one weather station"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Body has the connection test result shape", function() {
    const body = res.body;
    expect(body.success).to.be.a('boolean');
    expect(body.previewTruncated).to.be.a('boolean');
    expect(body).to.have.property('message');
    expect(body).to.have.property('preview');
    expect(body).to.have.property('rowCount');
    expect(body).to.have.property('httpStatus');
    if (body.success) {
      expect(body.reason).to.equal(null);
    } else {
      expect(["INVALID_CONNECTOR", "SOURCE_ERROR", "TIMEOUT"]).to.include(body.reason);
    }
  });
}

docs {
  Pins the answer shape of a connection test for unsaved HTTP values. An
  HTTP connector runs the one API call that `apiCall` names.
}
