meta {
  name: Contract HTTP — connection test answers
  type: http
  seq: 132
}

post {
  url: {{baseUrl}}/datasources/connection-test
  body: json
  auth: inherit
}


body:json {
  {
    "connector": {
      "connectorType": "HTTP",
      "baseUrl": "https://api.invalid/v1",
      "apiCalls": [
        { "name": "Get all weather stations", "path": "/stations" },
        { "name": "Get one weather station", "path": "/stations/1" }
      ]
    },
    "apiCall": "Get one weather station"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Body has the connection test result shape", function() {
    const body = res.body;
    expect(body.success).to.be.a('boolean');
    expect(body).to.have.property('message');
    expect(body).to.have.property('rowCount');
    expect(body).to.have.property('httpStatus');
  });
  test("The connection test service answers that the host is unknown", function() {
    expect(res.body.success).to.equal(false);
    expect(res.body.reason).to.equal("SOURCE_ERROR");
    expect(res.body.message).to.equal("The host 'api.invalid' is unknown.");
  });
}

docs {
  Pins the answer of a connection test for unsaved HTTP values. An
  HTTP connector runs the one API call that `apiCall` names. The
  `.invalid` host never resolves (RFC 6761), so the connection test
  service answers `SOURCE_ERROR`.
}
