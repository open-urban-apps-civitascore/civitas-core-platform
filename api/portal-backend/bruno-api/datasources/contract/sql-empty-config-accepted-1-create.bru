meta {
  name: Contract SQL — DRAFT accepts empty connector (deferred validation)
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_sql_empty",
    "description": "x",
    "connector": { "connectorType": "SQL" },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractSqlEmptyConfigId', res.body.id);
}

tests {
  test("Status is 201 — empty SQL connector accepted on DRAFT", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Every field reads back null", function() {
    expect(res.body.connector.connectorType).to.equal("SQL");
    ['driver', 'dsn', 'table', 'columns', 'where', 'user', 'password'].forEach(function(key) {
      expect(res.body.connector).to.have.property(key, null);
    });
  });
}

docs {
  Pins the deferred-validation contract: a DataSource in DRAFT status may
  be saved with an incomplete connector, here one with only
  `connectorType`. Validation of required fields is deferred to the
  release transition, enforced via the Bean Validation `OnRelease` group
  on `SqlConnectorConfiguration` (`driver`, `dsn`, `table`, `columns`).

  The release-time half of this contract is pinned by
  `sql-release-rejects-empty-configuration-*.bru` — if either half
  changes, both tests need to be revisited together.
}
