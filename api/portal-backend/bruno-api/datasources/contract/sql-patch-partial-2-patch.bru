meta {
  name: Contract SQL — patch partial (2/4 patch)
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/datasources/{{contractSqlPatchId}}
  body: json
  auth: inherit
}


body:json {
  {
    "description": "contract — SQL patched"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Only description was changed; other top-level fields preserved", function() {
    expect(res.body.name).to.equal("contract_sql_patch");
    expect(res.body.description).to.equal("contract — SQL patched");
    expect(res.body.connector.connectorType).to.equal("SQL");
    expect(res.body.dataSourceStatus).to.equal("DRAFT");
    expect(res.body.inUse).to.equal(false);
  });
  test("Connector unchanged by description-only PATCH", function() {
    expect(res.body.connector.driver).to.equal("postgres");
    expect(res.body.connector.dsn).to.equal("postgres://example:5432/db");
    expect(res.body.connector.user).to.equal("alice");
    expect(res.body.connector.password).to.equal("********");
    expect(res.body.connector.table).to.equal("events");
    expect(res.body.connector.columns).to.deep.equal(["*"]);
  });
}
