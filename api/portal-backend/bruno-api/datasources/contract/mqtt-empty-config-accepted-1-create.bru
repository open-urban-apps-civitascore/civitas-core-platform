meta {
  name: Contract MQTT — DRAFT accepts empty connector (deferred validation)
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_mqtt_empty",
    "description": "x",
    "connector": { "connectorType": "MQTT" },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractMqttEmptyConfigId', res.body.id);
}

tests {
  test("Status is 201 — empty MQTT connector accepted on DRAFT", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Every field reads back null or its default", function() {
    expect(res.body.connector.connectorType).to.equal("MQTT");
    expect(res.body.connector).to.have.property('urls', null);
    expect(res.body.connector).to.have.property('topics', null);
    expect(res.body.connector).to.have.property('qos', null);
    expect(res.body.connector).to.have.property('protocol_version', "3");
    expect(res.body.connector).to.have.property('connect_timeout', null);
    expect(res.body.connector).to.have.property('keepalive', null);
    expect(res.body.connector).to.have.property('user', null);
    expect(res.body.connector).to.have.property('password', null);
    expect(res.body.connector.tls).to.deep.equal({ enabled: false });
  });
}

docs {
  Pins the deferred-validation contract: a DataSource in DRAFT status may
  be saved with an incomplete connector, here one with only
  `connectorType`. The required MQTT fields (`urls`, `topics`, `qos`)
  carry `@NotEmpty(groups = OnRelease.class)` /
  `@NotNull(groups = OnRelease.class)` and are enforced at the release
  transition, not at create/update time.

  The `qos` *range* check (must be 0/1/2) belongs to the `Default` group
  and runs eagerly — pinned by `mqtt-validation-qos-out-of-range.bru`.
  The release-time half of the deferred contract is pinned by
  `mqtt-release-rejects-empty-configuration-*.bru`.
}
