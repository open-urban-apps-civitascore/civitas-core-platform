meta {
  name: Contract SQL — create + read (1/3 create)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_sql_create",
    "description": "contract — SQL",
    "connectorType": "SQL",
    "configuration": {
      "driver": "postgres",
      "dsn": "postgres://example:5432/db",
      "user": "alice",
      "password": "s3cret",
      "table": "events",
      "columns": ["*"]
    },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractSqlCreateId', res.body.id);
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Top-level fields match contract", function() {
    expect(res.body.name).to.equal("contract_sql_create");
    expect(res.body.description).to.equal("contract — SQL");
    expect(res.body.connectorType).to.equal("SQL");
    expect(res.body.dataSourceStatus).to.equal("DRAFT");
    expect(res.body.inUse).to.equal(false);
  });
  test("Submitted SQL configuration round-trips with password masked", function() {
    expect(res.body.configuration.driver).to.equal("postgres");
    expect(res.body.configuration.dsn).to.equal("postgres://example:5432/db");
    expect(res.body.configuration.user).to.equal("alice");
    expect(res.body.configuration.password).to.equal("********");
    expect(res.body.configuration.table).to.equal("events");
    expect(res.body.configuration.columns).to.deep.equal(["*"]);
  });
  test("Unsubmitted SQL fields default to null/zero, surfaced as expert-mode keys", function() {
    expect(res.body.configuration).to.have.property('where', null);
    expect(res.body.configuration).to.have.property('prefix', null);
    expect(res.body.configuration).to.have.property('suffix', null);
    expect(res.body.configuration).to.have.property('init_statement', null);
    expect(res.body.configuration).to.have.property('conn_max_idle_time', null);
    expect(res.body.configuration).to.have.property('conn_max_life_time', null);
    expect(res.body.configuration.conn_max_idle).to.equal(2);
    expect(res.body.configuration.conn_max_open).to.equal(0);
  });
}

docs {
  Pins the SQL POST response shape against the current contract. The
  request body uses the same property names the production frontend sends
  (`driver`, `dsn`, `user`, `password`, `table`, `columns`, …); the
  response echoes them back with `password` masked.

  - Submitted SQL fields round-trip unchanged.
  - The submitted password is preserved server-side (pinned at the JSONB
    layer by `DataSourceContractIntegrationTest$PersistedShapeOnCreate`)
    and masked in the response as `"********"`.
  - Unsubmitted scalar fields default to `null`. The two integer fields
    (`conn_max_idle`, `conn_max_open`) default to `2` and `0` respectively.

  Paired follow-ups:
  - `sql-create-and-read-2-read.bru` — GETs the resource by id and asserts
    the same shape.
  - `sql-create-and-read-3-cleanup.bru` — DELETEs the resource.
}
