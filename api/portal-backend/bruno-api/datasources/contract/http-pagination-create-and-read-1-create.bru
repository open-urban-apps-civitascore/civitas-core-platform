meta {
  name: Contract HTTP — pagination create + read (1/3 create)
  type: http
  seq: 136
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_http_pagination",
    "description": "contract — HTTP",
    "connector": {
      "connectorType": "HTTP",
      "baseUrl": "https://api.example.org/v1",
      "apiCalls": [
        {
          "name": "items",
          "path": "/items",
          "pagination": { "type": "LIMIT_OFFSET", "limitParameter": "limit", "offsetParameter": "offset", "limit": 20, "countPath": "$.meta.count" }
        },
        {
          "name": "events",
          "path": "/events",
          "pagination": { "type": "CURSOR", "cursorPath": "$.next_cursor", "cursorParameter": "X-Cursor", "cursorIn": "HEADER", "limitParameter": "limit", "limit": 20 }
        }
      ]
    },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractHttpPaginationId', res.body.id);
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Each pagination reads back as sent, with unset fields null", function() {
    expect(res.body.connector.apiCalls[0].pagination).to.deep.equal({
      type: "LIMIT_OFFSET", limitParameter: "limit", offsetParameter: "offset",
      limit: 20, offset: null, countPath: "$.meta.count"
    });
    expect(res.body.connector.apiCalls[1].pagination).to.deep.equal({
      type: "CURSOR", cursorPath: "$.next_cursor", cursorParameter: "X-Cursor",
      cursorIn: "HEADER", limitParameter: "limit", limit: 20
    });
  });
}

docs {
  Creates an HTTP/REST Data source with a limit/offset and a cursor
  pagination and reads them back. The cursor travels in a header.
}
