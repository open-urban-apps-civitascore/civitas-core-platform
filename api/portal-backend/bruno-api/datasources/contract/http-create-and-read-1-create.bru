meta {
  name: Contract HTTP — create + read (1/3 create)
  type: http
  seq: 100
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_http_create",
    "description": "contract — HTTP",
    "connector": {
      "connectorType": "HTTP",
      "baseUrl": "https://reader:pw@api.example.org/v1/",
      "authentication": { "type": "BASIC", "username": "reader", "password": "http-s3cret" },
      "apiCalls": [
        {
          "name": "Get all weather stations",
          "path": "/stations",
          "queryParameters": [{ "name": "status", "value": "active" }],
          "headers": [{ "name": "Accept", "value": "application/json" }],
          "pagination": { "type": "PAGE_NUMBER", "pageParameter": "page", "pageSizeParameter": "size", "pageSize": 100 }
        },
        { "name": "Get one weather station", "path": "/stations/1" }
      ]
    },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractHttpCreateId', res.body.id);
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Defaults are applied and the method reads GET", function() {
    const connector = res.body.connector;
    expect(connector.connectorType).to.equal("HTTP");
    expect(connector.baseUrl).to.equal("https://api.example.org/v1");
    expect(connector.apiCalls).to.have.lengthOf(2);
    expect(connector.apiCalls[0].method).to.equal("GET");
    expect(connector.apiCalls[1].method).to.equal("GET");
    expect(connector.apiCalls[0].pagination).to.deep.equal({
      type: "PAGE_NUMBER", pageParameter: "page", pageSizeParameter: "size",
      pageSize: 100, startPage: 0, endPage: null
    });
    expect(connector.apiCalls[0].queryParameters).to.deep.equal([{ name: "status", value: "active" }]);
    expect(connector.apiCalls[0].headers).to.deep.equal([{ name: "Accept", value: "application/json" }]);
    expect(connector.apiCalls[1]).to.have.property('pagination', null);
    expect(connector.apiCalls[1]).to.have.property('queryParameters', null);
    expect(connector.apiCalls[1]).to.have.property('headers', null);
  });
  test("The basic auth password is masked", function() {
    expect(res.body.connector.authentication).to.deep.equal({
      type: "BASIC", username: "reader", password: "********"
    });
  });
  test("No response field holds the password in clear text", function() {
    expect(JSON.stringify(res.body)).to.not.include("http-s3cret");
  });
}

docs {
  Creates an HTTP/REST Data source with basic auth and two API calls. The
  response applies the defaults: `startPage` 0, `endPage`, `pagination`,
  `queryParameters` and `headers` null, `method` GET. The user info and the
  trailing `/` of `baseUrl` are removed, and the password reads `"********"`.
}
