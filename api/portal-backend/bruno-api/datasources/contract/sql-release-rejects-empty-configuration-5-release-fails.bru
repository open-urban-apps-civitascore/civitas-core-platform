meta {
  name: Contract SQL — release rejects empty config (5/6 release fails)
  type: http
  seq: 43
}

post {
  url: {{baseUrl}}/datasources/{{contractSqlReleaseEmptyId}}/release
  body: none
  auth: inherit
}


tests {
  test("Status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Problem Detail matches the VALIDATION_FAILED contract", function() {
    expect(res.body.type).to.equal("urn:civitas:error:VALIDATION_FAILED");
    expect(res.body.title).to.equal("Bad Request");
    expect(res.body.status).to.equal(400);
  });
  test("fieldErrors name every missing required SQL field by its connector path", function() {
    const fields = res.body.fieldErrors.map(function(error) { return error.field; });
    expect(fields).to.include.members([
      "connector.driver",
      "connector.dsn",
      "connector.table",
      "connector.columns"
    ]);
    res.body.fieldErrors.forEach(function(error) {
      expect(error.field).to.match(/^connector\./);
      expect(error.message).to.be.a('string').and.not.empty;
    });
  });
}

docs {
  Pins the release-time half of the deferred-validation contract for SQL.

  An SQL connector with only `connectorType` is accepted on DRAFT (see
  `sql-empty-config-accepted-1-create.bru`). On release, the `OnRelease`
  constraints on `driver`, `dsn`, `table`, `columns` fire and the request fails with HTTP 400 /
  `urn:civitas:error:VALIDATION_FAILED`. Each entry of `fieldErrors` names
  the key path in the request body (`connector.<key>`), so a client can
  show the error at the field.

  A Data source whose connector was never stored fails earlier, with
  `urn:civitas:error:INVALID_INPUT` "Configuration is required for
  releasing".
}
