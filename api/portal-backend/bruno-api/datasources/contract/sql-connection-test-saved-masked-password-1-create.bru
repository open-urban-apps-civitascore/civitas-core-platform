meta {
  name: Contract SQL — connection test of a saved data source (1/3 create)
  type: http
  seq: 136
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_sql_connection_test",
    "description": "contract — SQL",
    "connector": {
      "connectorType": "SQL",
      "driver": "postgres",
      "dsn": "postgres://db.invalid:5432/city",
      "user": "reader",
      "password": "s3cret",
      "table": "readings",
      "columns": ["id"]
    },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractSqlConnectionTestId', res.body.id);
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Creates a DRAFT SQL data source with a password. The next step tests it
  with the password masked.
}
