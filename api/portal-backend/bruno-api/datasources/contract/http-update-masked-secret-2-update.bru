meta {
  name: Contract HTTP — update with masked password (2/4 update)
  type: http
  seq: 108
}

put {
  url: {{baseUrl}}/datasources/{{contractHttpMaskedSecretId}}
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_http_masked_updated",
    "description": "contract — HTTP",
    "connector": {
      "connectorType": "HTTP",
      "baseUrl": "https://reader:pw@api.example.org/v1/",
      "authentication": { "type": "BASIC", "username": "reader", "password": "********" },
      "apiCalls": [
        {
          "name": "Get all weather stations",
          "path": "/stations",
          "queryParameters": [{ "name": "status", "value": "active" }],
          "headers": [{ "name": "Accept", "value": "application/json" }],
          "pagination": { "type": "PAGE_NUMBER", "pageParameter": "page", "pageSizeParameter": "size", "pageSize": 100 }
        },
        { "name": "Get one weather station", "path": "/stations/1" }
      ]
    },
    "dataStructureVersionId": null
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("The stored password is kept and masked", function() {
    expect(res.body.name).to.equal("contract_http_masked_updated");
    expect(res.body.connector.authentication.password).to.equal("********");
  });
}

docs {
  A PUT with `"********"` keeps the stored password: the response shows
  the mask, not null. `DataSourceContractIntegrationTest` pins the stored
  ciphertext.
}
