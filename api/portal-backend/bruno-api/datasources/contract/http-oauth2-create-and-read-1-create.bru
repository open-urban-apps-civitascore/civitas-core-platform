meta {
  name: Contract HTTP — OAuth2 create + read (1/3 create)
  type: http
  seq: 130
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_http_oauth2",
    "description": "contract — HTTP",
    "connector": {
      "connectorType": "HTTP",
      "baseUrl": "https://api.example.org/v1",
      "authentication": {
        "type": "OAUTH2",
        "tokenUrl": "https://client:pw@auth.example.org/oauth2/token",
        "clientId": "civitas-core",
        "clientSecret": "http-s3cret",
        "scope": "read"
      },
      "apiCalls": [
        {
          "name": "stations",
          "path": "/stations"
        }
      ]
    },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractHttpOauth2Id', res.body.id);
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("The authentication reads back with the OAuth2 secret masked", function() {
    expect(res.body.connector.authentication).to.deep.equal({
      "type": "OAUTH2",
      "tokenUrl": "https://auth.example.org/oauth2/token",
      "clientId": "civitas-core",
      "clientSecret": "********",
      "scope": "read"
    });
  });
  test("No response field holds the secret in clear text", function() {
    expect(JSON.stringify(res.body)).to.not.include("http-s3cret");
  });
}

docs {
  Creates an HTTP/REST Data source with OAuth2 client credentials and
  reads it back. The user info of `tokenUrl` is removed.
}
