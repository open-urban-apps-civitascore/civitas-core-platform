meta {
  name: Contract HTTP — client certificate create + read (1/3 create)
  type: http
  seq: 133
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_http_client_certificate",
    "description": "contract — HTTP",
    "connector": {
      "connectorType": "HTTP",
      "baseUrl": "https://api.example.org/v1",
      "authentication": {
        "type": "CLIENT_CERTIFICATE",
        "certificate": "-----BEGIN CERTIFICATE-----\nMIIBkDCCATegAwIBAgIUOylf3oXUqQP6TNT7sYtc7g1ByaQwCgYIKoZIzj0EAwIw\nHTEbMBkGA1UEAwwSY2xpZW50LmV4YW1wbGUub3JnMCAXDTI2MTAyMzE0NTI0MFoY\nDzIxMjYwOTI5MTQ1MjQwWjAdMRswGQYDVQQDDBJjbGllbnQuZXhhbXBsZS5vcmcw\nWTATBgcqhkjOPQIBBggqhkjOPQMBBwNCAASHzbM9xN778Neeayxtcvf7wbqOkv4O\nKvCbNLEYpcE/yMA7yVEa4KMb6Ms6baGOq18t2UeT3L4mzvAKK73BMAAHo1MwUTAd\nBgNVHQ4EFgQUQ0ZjJfwlFZQuHWHhxsixvRNW2CQwHwYDVR0jBBgwFoAUQ0ZjJfwl\nFZQuHWHhxsixvRNW2CQwDwYDVR0TAQH/BAUwAwEB/zAKBggqhkjOPQQDAgNHADBE\nAiAhIY5L5SeakrxCWkDxl//xwPq5jxbfpSquJvuS8e0xAAIgSnWdgrODCGLkNnw5\n0bJNZP/v2YgYsotwmNh/jzTKk30=\n-----END CERTIFICATE-----\n",
        "privateKey": "http-s3cret"
      },
      "apiCalls": [
        {
          "name": "stations",
          "path": "/stations"
        }
      ]
    },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractHttpClientCertificateId', res.body.id);
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("The authentication reads back with the certificate and the private key masked", function() {
    expect(res.body.connector.authentication).to.deep.equal({
      "type": "CLIENT_CERTIFICATE",
      "certificate": "********",
      "privateKey": "********"
    });
  });
  test("No response field holds the secret in clear text", function() {
    expect(JSON.stringify(res.body)).to.not.include("http-s3cret");
    expect(JSON.stringify(res.body)).to.not.include("BEGIN CERTIFICATE");
  });
}

docs {
  Creates an HTTP/REST Data source with a client certificate and reads
  it back. The certificate and the private key read `"********"`.
}
