meta {
  name: Contract HTTP — release rejects invalid config (5/6 release fails)
  type: http
  seq: 118
}

post {
  url: {{baseUrl}}/datasources/{{contractHttpReleaseInvalidId}}/release
  body: none
  auth: inherit
}


tests {
  test("Status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Problem Detail matches the VALIDATION_FAILED contract", function() {
    expect(res.body.type).to.equal("urn:civitas:error:VALIDATION_FAILED");
    expect(res.body.title).to.equal("Bad Request");
    expect(res.body.status).to.equal(400);
  });
  test("fieldErrors name the missing authentication, path and pagination fields by their connector path", function() {
    const fields = res.body.fieldErrors.map(function(error) { return error.field; });
    expect(fields).to.have.members([
      "connector.authentication.token",
      "connector.apiCalls[3].pagination.nextLinkPath",
      "connector.apiCalls[0].path",
      "connector.apiCalls[0].pagination.pageSizeParameter",
      "connector.apiCalls[0].pagination.pageSize",
      "connector.apiCalls[1].pagination.offsetParameter",
      "connector.apiCalls[2].pagination.cursorParameter",
      "connector.apiCalls[2].pagination.limitParameter"
    ]);
  });
  test("A limit without its parameter names the missing parameter", function() {
    const error = res.body.fieldErrors.find(function(e) { return e.field === "connector.apiCalls[2].pagination.limitParameter"; });
    expect(error.message).to.equal("'limitParameter' is required with 'limit'");
  });
}

docs {
  Pins the release half of the deferred validation for HTTP/REST: each
  `fieldErrors` entry names the key path into the API call, so a client
  can show the error at the field.
}
