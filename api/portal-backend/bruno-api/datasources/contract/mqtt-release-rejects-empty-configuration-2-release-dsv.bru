meta {
  name: Contract MQTT — release rejects empty config (2/6 release DSV)
  type: http
  seq: 46
}

post {
  url: {{baseUrl}}/datastructures/{{setupDataStructureId}}/versions/{{contractMqttReleaseEmptyDsvId}}/release
  body: none
  auth: inherit
}


tests {
  test("DSV released (200)", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("DSV status is AVAILABLE", function() {
    expect(res.body.dataStructureVersionStatus).to.equal("AVAILABLE");
  });
}

docs {
  Releases the DSV created in step 1 so it becomes AVAILABLE. Required
  because `DataSourceService.validateDataStructureVersionLinkable` rejects
  linking a DRAFT DSV — step 3's DataSource POST would fail with 400
  otherwise. The DSV's model must already be stored in Model Forge (done
  synchronously as part of step 1's create call) for this release to pass;
  the saga workflow uses the same pattern.
}
