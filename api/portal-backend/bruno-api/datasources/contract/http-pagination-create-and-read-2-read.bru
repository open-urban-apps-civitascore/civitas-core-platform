meta {
  name: Contract HTTP — pagination create + read (2/3 read)
  type: http
  seq: 137
}

get {
  url: {{baseUrl}}/datasources/{{contractHttpPaginationId}}
  body: none
  auth: inherit
}


tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Each pagination reads back as sent, with the offset 0 when unset", function() {
    expect(res.body.connector.apiCalls[0].pagination).to.deep.equal({
      type: "LIMIT_OFFSET", limitParameter: "limit", offsetParameter: "offset",
      limit: 20, offset: 0, countPath: "$.meta.count"
    });
    expect(res.body.connector.apiCalls[2].pagination).to.deep.equal({
      type: "NEXT_LINK", nextLinkPath: "$.links.next", maxLinks: 3
    });
    expect(res.body.connector.apiCalls[1].pagination).to.deep.equal({
      type: "CURSOR", cursorPath: "$.next_cursor", cursorParameter: "X-Cursor",
      cursorIn: "HEADER", limitParameter: "limit", limit: 20
    });
  });
  test("The path to entries reads back as sent, and as null when unset", function() {
    expect(res.body.connector.apiCalls[0].entriesPath).to.equal("$.data");
    expect(res.body.connector.apiCalls[1].entriesPath).to.equal(null);
  });
}
