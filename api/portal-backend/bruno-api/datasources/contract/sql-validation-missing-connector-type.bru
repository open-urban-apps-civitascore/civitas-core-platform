meta {
  name: Contract SQL — validation: missing connectorType
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_sql_invalid",
    "description": "x",
    "connector": {
      "driver": "postgres",
      "dsn": "postgres://example:5432/db"
    },
    "dataStructureVersionId": null
  }
}

tests {
  test("Status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Error body matches the MALFORMED_REQUEST contract", function() {
    expect(res.body.type).to.equal("urn:civitas:error:MALFORMED_REQUEST");
    expect(res.body.title).to.equal("Bad Request");
    expect(res.body.status).to.equal(400);
    expect(res.body.detail).to.equal("Missing connector.connectorType");
  });
}

docs {
  Pins the error response for a `connector` without `connectorType`. The
  type selects the fields of the connector, so the connector cannot be
  read without it.
}
