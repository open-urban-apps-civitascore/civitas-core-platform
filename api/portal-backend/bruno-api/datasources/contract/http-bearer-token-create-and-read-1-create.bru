meta {
  name: Contract HTTP — Bearer token create + read (1/3 create)
  type: http
  seq: 124
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_http_bearer_token",
    "description": "contract — HTTP",
    "connector": {
      "connectorType": "HTTP",
      "baseUrl": "https://api.example.org/v1",
      "authentication": {
        "type": "BEARER_TOKEN",
        "token": "http-s3cret"
      },
      "apiCalls": [
        {
          "name": "stations",
          "path": "/stations"
        }
      ]
    },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractHttpBearerTokenId', res.body.id);
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("The authentication reads back with the Bearer token secret masked", function() {
    expect(res.body.connector.authentication).to.deep.equal({
      "type": "BEARER_TOKEN",
      "token": "********"
    });
  });
  test("No response field holds the secret in clear text", function() {
    expect(JSON.stringify(res.body)).to.not.include("http-s3cret");
  });
}

docs {
  Creates an HTTP/REST Data source with a Bearer token and reads it back.
}
