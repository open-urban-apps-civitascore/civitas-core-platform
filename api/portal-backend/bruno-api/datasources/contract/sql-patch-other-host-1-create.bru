meta {
  name: Contract SQL — PATCH of another host (1/4 create)
  type: http
  seq: 139
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_sql_patch_other_host",
    "description": "contract — SQL",
    "connector": {
      "connectorType": "SQL",
      "driver": "postgres",
      "dsn": "postgres://example:5432/db?sslmode=require",
      "user": "alice",
      "password": "s3cret",
      "table": "events",
      "columns": ["*"]
    },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractSqlPatchOtherHostId', res.body.id);
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
