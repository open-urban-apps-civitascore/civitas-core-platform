meta {
  name: Contract SQL — update with masked password (1/4 create)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

body:json {
  {
    "name": "contract_sql_masked",
    "description": "contract — SQL",
    "connectorType": "SQL",
    "configuration": {
      "driver": "postgres",
      "dsn": "postgres://example:5432/db",
      "user": "alice",
      "password": "s3cret",
      "table": "events",
      "columns": ["*"]
    },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('contractSqlMaskedSecretId', res.body.id);
  }
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  First step of the masked-secret-preservation contract test.

  Creates a SQL data source with a real password (`s3cret`). The next step
  PUTs the same record with the password replaced by the mask token
  (`********`) and confirms the original secret is preserved.
}
