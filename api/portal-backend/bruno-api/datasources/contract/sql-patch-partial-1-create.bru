meta {
  name: Contract SQL — patch partial (1/4 create)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

body:json {
  {
    "name": "contract_sql_patch",
    "description": "contract — SQL",
    "connectorType": "SQL",
    "configuration": {
      "driver": "postgres",
      "dsn": "postgres://example:5432/db",
      "user": "alice",
      "password": "s3cret",
      "table": "events",
      "columns": ["*"]
    },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractSqlPatchId', res.body.id);
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
