meta {
  name: Contract SQL — PUT changes connectorType (1/3 create)
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

body:json {
  {
    "name": "contract_sql_put_type_change",
    "description": "contract — SQL (will be PUT'd to MQTT)",
    "connectorType": "SQL",
    "configuration": {
      "driver": "postgres",
      "dsn": "postgres://example:5432/db",
      "user": "alice",
      "password": "s3cret",
      "table": "events",
      "columns": ["*"]
    },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractSqlPutTypeChangeId', res.body.id);
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Created as SQL in DRAFT", function() {
    expect(res.body.connectorType).to.equal("SQL");
    expect(res.body.dataSourceStatus).to.equal("DRAFT");
  });
}

docs {
  First step of the PUT-changes-connectorType contract test. Creates a SQL
  data source in DRAFT status; step 2 PUTs the same id with an MQTT body to
  pin the server's behaviour on connectorType mutation.
}
