meta {
  name: Contract SQL — update with masked password (3/4 read-back)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/datasources/{{contractSqlMaskedSecretId}}
  body: none
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Updated fields persisted", function() {
    expect(res.body.name).to.equal("contract_sql_masked_updated");
    expect(res.body.description).to.equal("contract — SQL updated");
  });
  test("Password remains masked on read-back", function() {
    expect(res.body.configuration.password).to.equal("********");
  });
}
