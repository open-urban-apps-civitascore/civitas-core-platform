meta {
  name: Contract MQTT — patch partial (3/4 read-back)
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/datasources/{{contractMqttPatchId}}
  body: none
  auth: inherit
}


tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Patched description persisted; connector untouched", function() {
    expect(res.body.description).to.equal("contract — MQTT patched");
    expect(res.body.connector.urls).to.deep.equal(["tcp://broker:1883"]);
    expect(res.body.connector.topics).to.deep.equal(["sensor/data"]);
    expect(res.body.connector.qos).to.equal(1);
  });
}
