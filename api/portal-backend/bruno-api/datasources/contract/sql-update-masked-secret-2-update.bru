meta {
  name: Contract SQL — update with masked password (2/4 update)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/datasources/{{contractSqlMaskedSecretId}}
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_sql_masked_updated",
    "description": "contract — SQL updated",
    "connectorType": "SQL",
    "configuration": {
      "driver": "postgres",
      "dsn": "postgres://example:5432/db",
      "user": "alice",
      "password": "********",
      "table": "events",
      "columns": ["*"]
    },
    "dataStructureVersionId": null
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Top-level fields updated", function() {
    expect(res.body.name).to.equal("contract_sql_masked_updated");
    expect(res.body.description).to.equal("contract — SQL updated");
    expect(res.body.connectorType).to.equal("SQL");
    expect(res.body.dataSourceStatus).to.equal("DRAFT");
    expect(res.body.inUse).to.equal(false);
  });
  test("Submitting the masked password placeholder still results in a masked response", function() {
    expect(res.body.configuration.password).to.equal("********");
  });
  test("Submitted SQL fields round-trip on PUT", function() {
    expect(res.body.configuration.driver).to.equal("postgres");
    expect(res.body.configuration.dsn).to.equal("postgres://example:5432/db");
    expect(res.body.configuration.user).to.equal("alice");
    expect(res.body.configuration.table).to.equal("events");
    expect(res.body.configuration.columns).to.deep.equal(["*"]);
    expect(res.body.configuration.conn_max_idle).to.equal(2);
    expect(res.body.configuration.conn_max_open).to.equal(0);
  });
}

docs {
  Sends a PUT containing the masked placeholder `"********"` for the
  password. The server must accept it without error and respond with the
  masked placeholder. The underlying ciphertext-preservation behaviour is
  pinned at the JSONB level by `DataSourceContractIntegrationTest$PersistedShapeOnMutation.sqlPutWithMaskedPasswordPreservesStoredCiphertext`.
}
