meta {
  name: Contract MQTT — release rejects empty config (1/6 create DSV)
  type: http
  seq: 45
}

post {
  url: {{baseUrl}}/datastructures/{{setupDataStructureId}}/versions
  body: json
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

body:json {
  {
    "dataStructureVersionSource": "OWN",
    "version": "contract-mqtt-release-empty-1.0.0",
    "description": "DSV for mqtt-release-rejects-empty-configuration",
    "modelAtlasUri": "http://civitas.org/model/ContractMqttReleaseEmpty/1.0.0",
    "modelName": "ContractMqttReleaseEmpty",
    "model": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<uml:Model xmi:version=\"20131001\" xmlns:xmi=\"http://www.omg.org/spec/XMI/20131001\" xmlns:uml=\"http://www.eclipse.org/uml2/5.0.0/UML\" xmi:id=\"_contract_mqtt_release_empty_model\" name=\"ContractMqttReleaseEmpty\" URI=\"http://civitas.org/model/ContractMqttReleaseEmpty/1.0.0\">\n  <packagedElement xmi:type=\"uml:Package\" xmi:id=\"_pkg\" name=\"contract\" URI=\"http://civitas.org/model/contract\">\n    <packagedElement xmi:type=\"uml:Class\" xmi:id=\"_cls\" name=\"Marker\">\n      <ownedAttribute xmi:id=\"_attr\" name=\"id\" visibility=\"public\">\n        <type xmi:type=\"uml:PrimitiveType\" href=\"http://www.omg.org/spec/UML/20131001/PrimitiveTypes.xmi#String\"/>\n      </ownedAttribute>\n    </packagedElement>\n  </packagedElement>\n</uml:Model>",
    "styles": {}
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractMqttReleaseEmptyDsvId', res.body.id);
}

tests {
  test("DSV created (201)", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Sets up a fresh DataStructureVersion under the setup DataStructure so the
  release-validation test in step 3 reaches the configuration-validation
  branch of `DataSourceService.validateRelease` instead of short-circuiting
  on a missing DSV.
}
