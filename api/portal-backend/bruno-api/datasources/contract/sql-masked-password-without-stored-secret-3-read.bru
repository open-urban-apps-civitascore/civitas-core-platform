meta {
  name: Contract SQL — masked password without stored secret (3/4 read-back)
  type: http
  seq: 63
}

get {
  url: {{baseUrl}}/datasources/{{contractSqlMaskedNoSecretId}}
  body: none
  auth: inherit
}


tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Password reads back null", function() {
    expect(res.body.connector).to.have.property('password', null);
  });
}
