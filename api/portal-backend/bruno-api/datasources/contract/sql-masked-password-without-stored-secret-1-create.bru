meta {
  name: Contract SQL — masked password without stored secret (1/4 create)
  type: http
  seq: 61
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_sql_masked_no_secret",
    "description": "contract — SQL without password",
    "connector": {
      "connectorType": "SQL",
      "driver": "postgres",
      "dsn": "postgres://example:5432/db",
      "user": "alice",
      "table": "events",
      "columns": ["*"]
    },
    "dataStructureVersionId": null
  }
}

script:post-response {
  if (!res.body || !res.body.id) {
    throw new Error("Expected create response to include non-empty 'id'");
  }
  bru.setVar('contractSqlMaskedNoSecretId', res.body.id);
}

tests {
  test("Status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("No password stored", function() {
    expect(res.body.connector).to.have.property('password', null);
  });
}
