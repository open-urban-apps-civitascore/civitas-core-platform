meta {
  name: Contract SQL — PUT changes connectorType (2/3 put-mqtt)
  type: http
  seq: 36
}

put {
  url: {{baseUrl}}/datasources/{{contractSqlPutTypeChangeId}}
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_sql_put_type_change",
    "description": "contract — flipped to MQTT",
    "connector": {
      "connectorType": "MQTT",
      "urls": ["tcp://broker:1883"],
      "topics": ["sensor/data"],
      "qos": 1
    },
    "dataStructureVersionId": null
  }
}

tests {
  test("Status is 200 — DRAFT permits connectorType change", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Response reflects the new connectorType", function() {
    expect(res.body.connector.connectorType).to.equal("MQTT");
    expect(res.body.dataSourceStatus).to.equal("DRAFT");
    expect(res.body.name).to.equal("contract_sql_put_type_change");
    expect(res.body.description).to.equal("contract — flipped to MQTT");
  });
  test("Connector follows the MQTT schema", function() {
    expect(res.body.connector.urls).to.deep.equal(["tcp://broker:1883"]);
    expect(res.body.connector.topics).to.deep.equal(["sensor/data"]);
    expect(res.body.connector.qos).to.equal(1);
    expect(res.body.connector.protocol_version).to.equal("3");
    expect(res.body.connector.tls).to.deep.equal({ enabled: false });
  });
  test("No SQL field and no SQL password remain", function() {
    expect(res.body.connector).to.not.have.property('driver');
    expect(res.body.connector).to.not.have.property('dsn');
    expect(res.body.connector).to.not.have.property('table');
    expect(res.body.connector).to.not.have.property('columns');
    expect(res.body.connector).to.have.property('user', null);
    expect(res.body.connector).to.have.property('password', null);
  });
}

docs {
  Pins that a PUT with a `connector` of another `connectorType` on a
  **DRAFT** data source is accepted (200) and replaces the connector: the
  response has only the MQTT fields, and the SQL `user` and `password`
  are not carried over.

  `DataSourceService.validateConnectorTypeChange` rejects the change only
  when the data source is `AVAILABLE`. The PATCH counterpart is pinned by
  `mqtt-patch-changes-connector-type-*.bru`.
}
