meta {
  name: Contract MQTT — unknown nested connector key rejected
  type: http
  seq: 52
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}


body:json {
  {
    "name": "contract_mqtt_unknown_nested_key",
    "description": "Probes how an unknown nested connector key is handled",
    "connector": {
      "connectorType": "MQTT",
      "urls": ["tcp://broker:1883"],
      "topics": ["sensor/data"],
      "qos": 1,
      "tls": { "enabled": true, "verify": false }
    },
    "dataStructureVersionId": null
  }
}

tests {
  test("Status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Error body matches the MALFORMED_REQUEST contract", function() {
    expect(res.body.type).to.equal("urn:civitas:error:MALFORMED_REQUEST");
    expect(res.body.title).to.equal("Bad Request");
    expect(res.body.status).to.equal(400);
    expect(res.body.detail).to.equal("Unknown key: connector.tls.verify");
  });
}

docs {
  Pins that the strict reading of `connector` reaches nested objects: an
  unknown key inside `tls` is rejected with the full key path in the
  detail. Nothing is created, so no cleanup step follows.
}
