meta {
  name: Contract SQL — create + read (2/3 read)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/datasources/{{contractSqlCreateId}}
  body: none
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Top-level fields match contract", function() {
    expect(res.body.name).to.equal("contract_sql_create");
    expect(res.body.description).to.equal("contract — SQL");
    expect(res.body.connectorType).to.equal("SQL");
    expect(res.body.dataSourceStatus).to.equal("DRAFT");
    expect(res.body.inUse).to.equal(false);
  });
  test("Submitted SQL configuration round-trips with password masked", function() {
    expect(res.body.configuration.driver).to.equal("postgres");
    expect(res.body.configuration.dsn).to.equal("postgres://example:5432/db");
    expect(res.body.configuration.user).to.equal("alice");
    expect(res.body.configuration.password).to.equal("********");
    expect(res.body.configuration.table).to.equal("events");
    expect(res.body.configuration.columns).to.deep.equal(["*"]);
  });
  test("Unsubmitted SQL fields default to null/zero", function() {
    expect(res.body.configuration).to.have.property('where', null);
    expect(res.body.configuration).to.have.property('prefix', null);
    expect(res.body.configuration).to.have.property('suffix', null);
    expect(res.body.configuration).to.have.property('init_statement', null);
    expect(res.body.configuration).to.have.property('conn_max_idle_time', null);
    expect(res.body.configuration).to.have.property('conn_max_life_time', null);
    expect(res.body.configuration.conn_max_idle).to.equal(2);
    expect(res.body.configuration.conn_max_open).to.equal(0);
  });
}

docs {
  Reads the resource created by `sql-create-and-read-1-create.bru` and
  asserts the response body shape matches what the create call returned.
}
