meta {
  name: Contract SQL — create + read (2/3 read)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/datasources/{{contractSqlCreateId}}
  body: none
  auth: inherit
}


tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Top-level fields match contract", function() {
    expect(res.body.name).to.equal("contract_sql_create");
    expect(res.body.description).to.equal("contract — SQL");
    expect(res.body.connector.connectorType).to.equal("SQL");
    expect(res.body.dataSourceStatus).to.equal("DRAFT");
    expect(res.body.inUse).to.equal(false);
  });
  test("Submitted SQL connector round-trips with password masked", function() {
    expect(res.body.connector.driver).to.equal("postgres");
    expect(res.body.connector.dsn).to.equal("postgres://example:5432/db");
    expect(res.body.connector.user).to.equal("alice");
    expect(res.body.connector.password).to.equal("********");
    expect(res.body.connector.table).to.equal("events");
    expect(res.body.connector.columns).to.deep.equal(["*"]);
  });
  test("Unsubmitted SQL where clause defaults to null", function() {
    expect(res.body.connector).to.have.property('where', null);
  });
}

docs {
  Reads the resource created by `sql-create-and-read-1-create.bru` and
  asserts the response body shape matches what the create call returned.
}
