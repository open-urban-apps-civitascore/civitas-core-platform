meta {
  name: Delete Data Source
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/datasources/:id
  body: none
  auth: inherit
}

params:path {
  id: {{dataSourceId}}
}

script:post-response {
  // Restore setup variables so later folders can use them
  const setupId = bru.getVar('setupDataSourceId');
  if (setupId) {
    bru.setVar('dataSourceId', setupId);
    bru.setVar('scopeType', 'DATASOURCE');
    bru.setVar('scopeId', setupId);
  }
}

tests {
  test("Status code is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  **Precondition:** `dataSourceId` is set and not in released state.

  **Expected Response:** 204 No Content.

  **Verification:** Issue TC-SRC-02 for same `dataSourceId` and confirm 404.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSource record removed |
  | Config Adapter | — |
  | External System | — |
}
