meta {
  name: Test Data Source Connection
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/datasources/connection-test
  body: json
  auth: inherit
}

body:json {
  {
    "connector": {
      "connectorType": "MQTT",
      "urls": ["tcp://broker.invalid:1883"],
      "topics": ["sensor/#"],
      "qos": 1,
      "user": "mqttuser",
      "password": "secret"
    }
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Body has the connection test result shape", function() {
    const body = res.body;
    expect(body.success).to.be.a('boolean');
    expect(body.previewTruncated).to.be.a('boolean');
    expect(body).to.have.property('message');
    expect(body).to.have.property('preview');
    expect(body).to.have.property('rowCount');
    expect(body).to.have.property('httpStatus');
  });
  test("The connection test service answers that the host is unknown", function() {
    expect(res.body.success).to.equal(false);
    expect(res.body.reason).to.equal("SOURCE_ERROR");
    expect(res.body.message).to.equal("The host 'broker.invalid' is unknown.");
  });
}

docs {
  **Expected Response:** 200 OK. `success` tells whether the source
  answered as configured, `reason` why not. The `.invalid` broker never
  resolves, so the answer is `SOURCE_ERROR`.

  **Other responses:** 400 for invalid values or a `"********"`
  placeholder, 429 while the user runs a test, 502 when the test cannot
  run, 504 without an answer within `connection-test.wait-seconds`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Nothing stored; one audit log line |
  | Connection test service | Consumes `de.civitascore.connectiontest.request`, answers on `de.civitascore.connectiontest.result` |
  | External System | Read once by the connection test service |
}
