meta {
  name: Test Data Source Connection
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/datasources/connection-test
  body: json
  auth: inherit
}

body:json {
  {
    "connector": {
      "connectorType": "MQTT",
      "urls": ["tcp://broker.invalid:1883"],
      "topics": ["sensor/#"],
      "qos": 1,
      "user": "mqttuser",
      "password": "secret"
    }
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Body has the connection test result shape", function() {
    const body = res.body;
    expect(body.success).to.be.a('boolean');
    expect(body).to.have.property('message');
    expect(body).to.have.property('rowCount');
    expect(body).to.have.property('httpStatus');
    if (body.success) {
      expect(body.reason).to.equal(null);
    } else {
      expect(["INVALID_CONNECTOR", "SOURCE_ERROR", "TIMEOUT"]).to.include(body.reason);
    }
  });
}

docs {
  **Expected Response:** 200 OK. `success` tells whether the source
  answered as configured, `reason` why not. The outcome depends on the
  broker the connector names.

  **Other responses:** 400 for invalid values or a `"********"`
  placeholder, 429 while the user runs a test, 502 when the test cannot
  run, 504 without an answer within `connection-test.wait-seconds`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Nothing stored; one audit log line |
  | Config Adapter | Consumes `de.civitascore.connectiontest.request`, answers on `de.civitascore.connectiontest.result` |
  | External System | Read once by config-adapter |
}
