meta {
  name: Publish Data Source
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/datasources/:id/publish
  body: none
  auth: inherit
}

params:path {
  id: {{dataSourceId}}
}

tests {
  test("Publish accepted or precondition not met", function() {
    const status = res.getStatus();
    // 200=published, 400=missing data structure version or wrong state
    expect(status === 200 || status === 400).to.be.true;
  });
}
