meta {
  name: Get All Data Sources
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/datasources
  body: none
  auth: bearer
}

params:query {
  ~page: 0
  ~size: 20
  ~sort: createdAt,DESC
  ~name: mqtt-sensor
  ~description: Temperature sensor
  ~q: sensor
  ~dataSourceStatus: DRAFT
  ~connectorType: MQTT
}

auth:bearer {
  token: {{accessToken}}
}
