meta {
  name: Test Saved Data Source Connection
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/datasources/:id/connection-test
  body: json
  auth: inherit
}

params:path {
  id: {{dataSourceId}}
}

body:json {
  {
    "connector": {
      "connectorType": "MQTT",
      "urls": ["tcp://broker.invalid:1883"],
      "topics": ["sensor/#"],
      "qos": 1,
      "keepalive": "30s",
      "user": "mqttuser",
      "password": "********",
      "connect_timeout": "5s",
      "tls": {
        "enabled": false
      }
    }
  }
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Body has the connection test result shape", function() {
    const body = res.body;
    expect(body.success).to.be.a('boolean');
    expect(body.previewTruncated).to.be.a('boolean');
    expect(body).to.have.property('message');
    expect(body).to.have.property('preview');
    expect(body).to.have.property('rowCount');
    expect(body).to.have.property('httpStatus');
  });
  test("The connection test service answers that the host is unknown", function() {
    expect(res.body.success).to.equal(false);
    expect(res.body.reason).to.equal("SOURCE_ERROR");
    expect(res.body.message).to.equal("The host 'broker.invalid' is unknown.");
  });
}

docs {
  **Precondition:** `dataSourceId` is set and stores this MQTT connector with
  a password (`update-datasource`).

  `"********"` keeps the stored password only to test the connector as saved.

  **Expected Response:** 200 OK with a connection test result. 400 for
  `"********"` with changed values, 403 for another destination without
  `DATASOURCE_READ` for the whole tenant, 404 for an unknown id.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Nothing stored; one audit log line |
  | Connection test service | Runs the test with the stored, encrypted password |
  | External System | Read once by the connection test service |
}
