meta {
  name: Get All DataSinks
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/datasets/:dataSetId/datasinks
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
}

params:query {
  ~page: 0
  ~size: 20
  ~sort: createdAt,DESC
  ~dataSinkType: POSTGIS
}

docs {
  **Precondition:** `dataSetId` is set.

  **Expected Response:** 200 OK, paginated list of DataSinks belonging to the data set.
}
