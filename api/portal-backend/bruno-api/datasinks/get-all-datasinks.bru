meta {
  name: Get All DataSinks
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/datasets/:dataSetId/datasinks
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
}

params:query {
  ~page: 0
  ~size: 20
  ~sort: createdAt,DESC
  ~dataSinkType: POSTGIS
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns a list", function() {
    if (res.getStatus() === 200) {
      const body = res.body;
      const items = Array.isArray(body) ? body : body.content;
      expect(items).to.be.an('array');
    }
  });
}

docs {
  **Precondition:** `dataSetId` is set.

  **Expected Response:** 200 OK, paginated list of DataSinks belonging to the data set.
}
