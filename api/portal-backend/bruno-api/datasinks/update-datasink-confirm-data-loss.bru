meta {
  name: Update DataSink (confirm data loss)
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/datasets/:dataSetId/datasinks/:id
  body: json
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
  id: {{dataSinkId}}
}

body:json {
  {
    "dataSinkType": "POSTGIS",
    "configuration": {
      "tableName": "sensor_observations_rebuilt",
      "element": "{{setupModelUrn}}"
    },
    "confirmDataLoss": true
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('dataSinkId', res.body.id);
  }
}

tests {
  test("Table change accepted on a DataSink that is not provisioned", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Table name changed", function() {
    if (res.getStatus() === 200) {
      expect(res.body.configuration.tableName).to.equal('sensor_observations_rebuilt');
    }
  });
}

docs {
  The dataset of this collection is never released, so the DataSink is not provisioned: it has no table yet, `confirmDataLoss` is ignored and the table change is accepted.

  | DataSink | Change of `tableName` or `element` |
  |---|---|
  | not provisioned | accepted |
  | provisioned POSTGIS | 409 Conflict, also with `confirmDataLoss` — a release never replaces a table; create a new DataSink and attach it to the Pipeline instead |
  | provisioned FROST | 409 Conflict unless `confirmDataLoss: true` |

  **Precondition:** `dataSetId`, `dataSinkId` and `setupModelUrn` set.

  **Expected Response:** 200 OK.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSink configuration updated |
  | Config Adapter | the table is created under the new name on the first release |
  | External System | — |
}
