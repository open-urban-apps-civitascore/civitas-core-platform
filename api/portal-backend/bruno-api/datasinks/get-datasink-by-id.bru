meta {
  name: Get DataSink by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/datasets/:dataSetId/datasinks/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
  id: {{dataSinkId}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Has the requested id", function() {
    if (res.getStatus() === 200) {
      expect(res.body.id).to.equal(bru.getVar('postgisDataSinkId'));
    }
  });

  test("Reports its type and configuration", function() {
    if (res.getStatus() === 200) {
      expect(res.body.dataSinkType).to.be.a('string');
      expect(res.body.configuration).to.be.an('object');
    }
  });

  test("Reports whether it is provisioned", function() {
    if (res.getStatus() === 200) {
      expect(res.body.provisioned).to.be.a('boolean');
    }
  });
}

docs {
  **Precondition:** `dataSetId` and `dataSinkId` are set.

  **Expected Response:** 200 OK, body contains the DataSink with matching `id`, including the `inUseByPipeline` and `inUseByLayer` flags, the `provisioned` flag and (for POSTGIS) the inline DataStructureVersion summary.
}
