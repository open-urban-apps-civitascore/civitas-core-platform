meta {
  name: Create Assignment
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/assignments
  body: json
  auth: bearer
}

body:json {
  {
    "groupId": "{{groupId}}",
    "roleId": "{{roleId}}",
    "scopeType": "TENANT",
    "scopeId": null
  }
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('assignmentId', res.body.id);
  }
}
