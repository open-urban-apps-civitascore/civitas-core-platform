meta {
  name: Create Assignment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/assignments
  body: json
  auth: inherit
}

body:json {
  {
    "groupId": "{{groupId}}",
    "roleId": "{{systemRoleId}}"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('assignmentId', res.body.id);
  }
}

tests {
  test("Assignment created or already exists", function() {
    const status = res.getStatus();
    // 201=created, 409=duplicate assignment
    expect(status === 201 || status === 409).to.be.true;
  });
}
