meta {
  name: Get All Assignments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/assignments
  body: none
  auth: bearer
}

params:query {
  ~page: 0
  ~size: 20
  ~sort: createdAt,DESC
