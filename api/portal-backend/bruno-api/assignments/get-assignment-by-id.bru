meta {
  name: Get Assignment by ID
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/assignments/:id
  body: none
  auth: inherit
}

params:path {
  id: {{assignmentId}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Has correct id", function() {
    expect(res.body.id).to.be.a('string');
  });
}

docs {
  **Precondition:** `assignmentId` is set.

  **Expected Response**
  - Status: `200 OK`
  - Body contains the assignment with matching `id`
}
