auth {
  mode: oauth2
}

headers {
  X-Allowed-Scope-Ids: *
}

auth:oauth2 {
  grant_type: password
  access_token_url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  refresh_token_url: 
  username: {{username}}
  password: {{password}}
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
  scope: 
  credentials_placement: basic_auth_header
  credentials_id: credentials
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

docs {
  Requests run directly against the backend (baseUrl), bypassing APISIX/OPA. The backend's
  body-reference scope guard denies when no X-Allowed-Scope-Ids header is present, so the
  collection sends the wildcard the tenant-wide test user (dev@civitas.local) would receive
  from OPA. Individual requests that need a narrower scope override this header locally.
}
