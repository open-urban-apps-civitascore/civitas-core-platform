meta {
  name: Update Role
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/roles/:id
  body: json
  auth: inherit
}

params:path {
  id: {{roleId}}
}

body:json {
  {
    "name": "Data Manager",
    "description": "Updated description",
    "roleType": "DATA",
    "permissionIds": [],
    "readonly": false
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('roleId', res.body.id);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
