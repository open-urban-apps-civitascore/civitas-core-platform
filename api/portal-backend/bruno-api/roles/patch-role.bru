meta {
  name: Patch Role
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/roles/:id
  body: json
  auth: inherit
}

params:path {
  id: {{roleId}}
}

body:json {
  {
    "description": "Patched description"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('roleId', res.body.id);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Precondition:** `roleId` is set.

  **Expected Response:** 200 OK, body reflects updated `description`; other fields unchanged.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | **Backend** | Role `description` updated; other fields unchanged |
  | **Config Adapter** | — |
  | **External System** | — |
}
