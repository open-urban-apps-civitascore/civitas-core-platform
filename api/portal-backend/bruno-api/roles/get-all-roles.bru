meta {
  name: Get All Roles
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/roles
  body: none
  auth: inherit
}

params:query {
  ~page: 0
  ~size: 20
  ~sort: createdAt,DESC
  ~name: admin
  ~description: Full access
  ~roleType: SYSTEM
  ~q: admin
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Returns paginated list", function() {
    expect(res.body.content).to.be.an('array');
  });
}
