meta {
  name: Create Role
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/roles
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Data Manager",
    "description": "Can manage data resources",
    "roleType": "DATA",
    "permissionIds": [],
    "readonly": false
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('roleId', res.body.id);
  }
}
