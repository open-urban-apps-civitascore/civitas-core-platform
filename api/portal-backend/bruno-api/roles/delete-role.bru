meta {
  name: Delete Role
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/roles/:id
  body: none
  auth: inherit
}

params:path {
  id: {{roleId}}
}

script:post-response {
  const setupId = bru.getVar('setupRoleId');
  if (setupId) {
    bru.setVar('roleId', setupId);
  }
}

tests {
  test("Status code is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
