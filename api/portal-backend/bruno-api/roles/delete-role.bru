meta {
  name: Delete Role
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/roles/:id
  body: none
  auth: inherit
}

params:path {
  id: {{roleId}}
}

script:post-response {
  const setupId = bru.getVar('setupRoleId');
  if (setupId) {
    bru.setVar('roleId', setupId);
  }
}

tests {
  test("Status code is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  **Precondition:** `roleId` is set.

  **Expected Response:** 204 No Content.

  **Verification:** Issue TC-ROLE-02 for same `roleId` and confirm 404.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | **Backend** | Role record removed from `portal_backend` DB |
  | **Config Adapter** | — |
  | **External System** | — |
}
