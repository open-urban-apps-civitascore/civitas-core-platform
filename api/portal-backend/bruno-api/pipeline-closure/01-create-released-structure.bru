meta {
  name: 01. Create DataStructure for the DataSource
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/datastructures
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Closure Source Structure {{closureRunId}}",
    "description": "Released, so the DataSource can be released",
    "createdFromDataSource": false,
    "dataStructureVersionIds": [],
    "assignments": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('closureSourceStructureId', res.body.id);
  }
}

tests {
  test("Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
