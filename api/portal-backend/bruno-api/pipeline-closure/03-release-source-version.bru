}

post {
  url: {{baseUrl}}/datastructures/:dataStructureId/versions/:versionId/release
  body: none
  auth: inherit
}

params:path {
  dataStructureId: {{closureSourceStructureId}}
  versionId: {{closureSourceVersionId}}
}

tests {
  test("Released", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
