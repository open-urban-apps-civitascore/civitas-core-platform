meta {
  name: 11. Create a POSTGIS sink bound to the draft structure
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/datasets/:dataSetId/datasinks
  body: json
  auth: inherit
}

params:path {
  dataSetId: {{closureDataSetId}}
}

body:json {
  {
    "dataSinkType": "POSTGIS",
    "configuration": {
      "tableName": "closure_test_observations",
      "element": "{{closureDraftModelUrn}}"
    }
  }
}

script:post-response {
  if (res.body && res.body.configurationUrn) {
    bru.setVar('closureSinkConfigUrn', res.body.configurationUrn);
  }
  if (res.body && res.body.id) {
    bru.setVar('closureDataSinkId', res.body.id);
  }
}

tests {
  test("Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  A sink's `element` needs only registry existence, so a draft version is accepted here. The
  release lifecycle is asserted later, when the dataset is staged.
}
