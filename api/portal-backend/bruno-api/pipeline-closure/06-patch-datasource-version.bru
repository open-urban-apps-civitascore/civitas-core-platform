meta {
  name: 06. Pin the DataSource to the released version
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/datasources/:id
  body: json
  auth: inherit
}

params:path {
  id: {{closureDataSourceId}}
}

body:json {
  {
    "dataStructureVersionId": "{{closureSourceVersionId}}"
  }
}

tests {
  test("Patched", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  A DataSource can only be released once it is pinned to a released version.
}
