meta {
  name: 02. Create its version
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/datastructures/:dataStructureId/versions
  body: json
  auth: inherit
}

params:path {
  dataStructureId: {{closureSourceStructureId}}
}

body:json {
  {
    "dataStructureVersionSource": "OWN",
    "description": "Initial version",
    "modelName": "ClosureSourceModel",
    "model": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ClosureSourceModel",
      "type": "object",
      "properties": { "messwert": { "type": "string" } }
    },
    "styles": {}
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('closureSourceVersionId', res.body.id);
  }
}

tests {
  test("Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
