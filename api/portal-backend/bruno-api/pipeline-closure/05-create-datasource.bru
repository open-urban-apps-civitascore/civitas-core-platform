meta {
  name: 05. Create DataSource
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Closure Test Source {{closureRunId}}",
    "description": "Feeds the pipeline under test",
    "connectorType": "MQTT",
    "configuration": {
      "urls": ["tcp://broker.hivemq.com:1883"],
      "topics": ["civitas/core/closure-test/+"],
      "client_id": "civitas-closure-test",
      "qos": 1,
      "connect_timeout": "5s",
      "keepalive": "30s",
      "tls": { "enabled": false }
    },
    "dataStructureVersionId": null,
    "assignments": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('closureDataSourceId', res.body.id);
  }
}

tests {
  test("Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
