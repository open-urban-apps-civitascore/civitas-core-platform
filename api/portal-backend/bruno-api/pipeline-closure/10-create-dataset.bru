meta {
  name: 10. Create the DataSet
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/datasets
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Closure Test DataSet {{closureRunId}}",
    "description": "Its flow reaches a structure that was never released"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('closureDataSetId', res.body.id);
  }
}

tests {
  test("Created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
