meta {
  name: Get Dataset Usable DataSources
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/datasets/:id/usable-datasources
  body: none
  auth: inherit
}

params:path {
  id: {{dataSetId}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Returns a data source list", function() {
    expect(res.body).to.be.an('array');
  });
  test("Each entry carries id and name and nothing else", function() {
    res.body.forEach(function(dataSource) {
      expect(dataSource.id).to.be.a('string');
      expect(dataSource.name).to.be.a('string');
      expect(Object.keys(dataSource).sort()).to.eql(['id', 'name']);
    });
  });
}

docs {
  Lists the data sources this dataset's pipelines may be built from — the input behind the data
  source picker in the pipeline editor.

  A data source is usable when it is released for **every** datapool (`datapoolScopeType = ALL`) or
  for the datapool this dataset sits in (`SPECIFIC` naming it). A dataset in **no** datapool
  therefore sees only the former. Only AVAILABLE data sources are returned, because a pipeline save
  rejects anything else.

  Authorized on the **dataset**, not on the data sources: requires `DATASET_UPDATE`, which a
  DATAPOOL-scoped grant conveys. Reading the data source administration surface still requires
  `DATASOURCE_READ`, so the response carries `id` and `name` only — no connector configuration.

  A caller without `DATASET_UPDATE` on the dataset is rejected by OPA with **403**. Past that, the
  caller's scope headers still apply: a dataset outside `X-Allowed-Scope-Ids` /
  `X-Allowed-Pool-Ids` — unknown or merely out of scope — returns **404**.

  **Precondition:** `dataSetId` is set.

  **Expected Response:** 200 OK, body is the (possibly empty) list of usable data sources.
}
