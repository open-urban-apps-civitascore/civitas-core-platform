meta {
  name: Update Dataset
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/datasets/:id
  body: json
  auth: inherit
}


params:path {
  id: {{dataSetId}}
}

body:json {
  {
    "name": "Sensor Readings Dataset",
    "description": "Updated dataset description",
    "openDataAccess": false,
    "datapoolId": "{{dataPoolId}}",
    "assignments": [],
    "namedApis": [
      { "name": "Traffic Sensor Readings", "slug": "traffic", "standard": "STA", "version": "1.1", "description": "Live traffic counter readings from city sensors." }
    ]
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('dataSetId', res.body.id);
    bru.setVar('scopeType', 'DATASET');
    bru.setVar('scopeId', res.body.id);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Precondition:** `dataSetId` and `dataPoolId` are set; `create-frost-datasink-for-sta-api` created the active FROST DataSink that backs the STA API.

  A new OWS or STA API needs an active DataSink of a kind that backs it (PostGIS for OWS, FROST for STA), and a DataSet has at most one OWS and one STA API. Otherwise the update answers `400` on `namedApis`.

  **Expected Response:** 200 OK, body reflects updated values.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSet record updated in `portal_backend` DB; STA API `traffic` added |
  | Config Adapter | — |
  | External System | — |
}
