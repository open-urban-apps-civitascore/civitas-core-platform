meta {
  name: Unpublish Dataset
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/datasets/:id/unpublish
  body: none
  auth: inherit
}

params:path {
  id: {{dataSetId}}
}

tests {
  test("Unpublished or precondition not met", function() {
    const status = res.getStatus();
    // 200=unpublished, 400=pending saga or already DRAFT
    expect(status === 200 || status === 400).to.be.true;
  });
}
