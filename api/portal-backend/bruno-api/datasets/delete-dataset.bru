meta {
  name: Delete Dataset
  type: http
  seq: 13
}

delete {
  url: {{baseUrl}}/datasets/:id
  body: none
  auth: inherit
}

params:path {
  id: {{dataSetId}}
}

script:post-response {
  // Restore setup dataset ID so pipelines folder can use it
  const setupId = bru.getVar('setupDataSetId');
  if (setupId) {
    bru.setVar('dataSetId', setupId);
  }
}

tests {
  test("Status code is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
