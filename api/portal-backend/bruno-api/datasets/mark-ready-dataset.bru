meta {
  name: Publish Dataset
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/datasets/:id/publish
  body: none
  auth: inherit
}

params:path {
  id: {{dataSetId}}
}

tests {
  test("Publish accepted or precondition not met", function() {
    const status = res.getStatus();
    // 200=published, 400=not in DRAFT state (already published or no pipeline)
    expect(status === 200 || status === 400).to.be.true;
  });
}

docs {
  **Precondition:** `dataSetId` is set and in `DRAFT` state.

  **Expected Response:** 200 OK, body contains `dataSetStatus: "READY"`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSet status updated to `READY` |
  | Config Adapter | — |
  | External System | — |
}
