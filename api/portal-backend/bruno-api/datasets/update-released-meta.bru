meta {
  name: Update Released Dataset Meta
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/datasets/:id/released/meta
  body: json
  auth: inherit
}


params:path {
  id: {{dataSetId}}
}

body:json {
  {
    "name": "Updated Dataset Name",
    "description": "Updated description for released dataset",
    "openDataAccess": false,
    "datapoolId": "{{dataPoolId}}",
    "assignments": []
  }
}

tests {
  test("Updated or not released", function() {
    const status = res.getStatus();
    // 200=updated, 400=dataset not in released state, 409=saga in-flight
    expect(status === 200 || status === 400 || status === 409).to.be.true;
  });
}

docs {
  **Precondition:** `dataSetId` is set and in released state. `dataPoolId` is set if a pool assignment should be preserved.

  **Expected Response:** 200 OK, released metadata is updated.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Released DataSet name/description updated |
  | Config Adapter | — |
  | External System | — |
}
