meta {
  name: Get All Datasets
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/datasets
  body: none
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

params:query {
  ~page: 0
  ~size: 20
  ~sort: createdAt,DESC
  ~name: sensor-data
  ~description: Temperature sensor readings
  ~q: sensor
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Returns paginated list", function() {
    expect(res.body.content).to.be.an('array');
  });
}

docs {
  **Expected Response:** 200 OK, paginated list of data set objects
}
