meta {
  name: Get All Datasets
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/datasets
  body: none
  auth: bearer
}

params:query {
  ~page: 0
  ~size: 20
  ~sort: createdAt,DESC
  ~name: sensor-data
  ~description: Temperature sensor readings
  ~q: sensor
}

auth:bearer {
  token: {{accessToken}}
}
