meta {
  name: Create Dataset
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/datasets
  body: json
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

body:json {
  {
    "name": "Sensor Readings Dataset",
    "description": "Dataset containing sensor readings",
    "openDataAccess": false,
    "assignments": [],
    "namedApis": [
      { "name": "Traffic Sensor Readings", "slug": "traffic", "standard": "STA", "version": "1.1", "description": "Live traffic counter readings from city sensors." },
      { "name": "Weather Sensor Readings", "slug": "weather", "standard": "STA", "version": "1.1" }
    ],
    "datapoolId": "{{dataPoolId}}"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('dataSetId', res.body.id);
    bru.setVar('scopeType', 'DATASET');
    bru.setVar('scopeId', res.body.id);
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Has id", function() {
    expect(res.body.id).to.be.a('string');
  });
  test("Has name", function() {
    expect(res.body.name).to.be.a('string');
  });
  test("Has dataSetStatus", function() {
    expect(res.body.dataSetStatus).to.be.a('string');
  });
  test("Has datapool reference", function() {
    expect(res.body.datapool).to.be.an('object');
    expect(res.body.datapool.id).to.be.a('string');
    expect(res.body.datapool.name).to.be.a('string');
  });
}

docs {
  **Precondition:** `dataPoolId` is set (e.g. via `00-setup/00-find-existing-datapool`).

  **Expected Response:** 201 Created, body contains `id` and an inline `datapool` summary.

  **Post-condition:** Save `dataSetId` from `body.id`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSet record created in `portal_backend` DB with status `DRAFT` |
  | Config Adapter | — |
  | External System | — |
}
