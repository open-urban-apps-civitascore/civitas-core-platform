meta {
  name: Get Visualization by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/datasets/:dataSetId/visualizations/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
  id: {{visualizationId}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Has correct id", function() {
    expect(res.body.id).to.be.a('string');
    expect(res.body.id).to.equal(bru.getVar('visualizationId'));
  });
}

docs {
  **Precondition:** `dataSetId` and `visualizationId` are set.

  **Expected Response:** 200 OK, body contains the visualization with matching `id`.
}
