meta {
  name: Update Visualization
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/datasets/:dataSetId/visualizations/:id
  body: json
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
  id: {{visualizationId}}
}

body:json {
  {
    "visualizationType": "DASHBOARD",
    "name": "Traffic Dashboard",
    "description": "Updated dashboard description"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('visualizationId', res.body.id);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Precondition:** `dataSetId` and `visualizationId` are set.

  **Expected Response:** 200 OK, body reflects updated values.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Dashboard record updated in `portal_backend` DB |
  | Config Adapter | -- |
  | External System | -- |
}
