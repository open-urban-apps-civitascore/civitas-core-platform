meta {
  name: Create Visualization
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/datasets/:dataSetId/visualizations
  body: json
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
}

body:json {
  {
    "visualizationType": "DASHBOARD",
    "name": "Traffic Dashboard",
    "description": "Visualizes traffic sensor readings"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('visualizationId', res.body.id);
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Has id", function() {
    expect(res.body.id).to.be.a('string');
  });
  test("Has name", function() {
    expect(res.body.name).to.be.a('string');
  });
}

docs {
  **Precondition:** `dataSetId` is set.

  **Expected Response:** 201 Created, body contains `id`.

  **Post-condition:** Save `visualizationId` from `body.id`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Dashboard record created in `portal_backend` DB, linked to the DataSet |
  | Config Adapter | -- |
  | External System | -- |
}
