meta {
  name: Patch Dataset with unknown field
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/datasets/:id
  body: json
  auth: inherit
}

params:path {
  id: {{dataSetId}}
}

body:json {
  {
    "description": "Must not be applied",
    "colour": "red"
  }
}

tests {
  test("Status code is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("Problem type is INVALID_INPUT", function() {
    expect(res.body.type).to.equal("urn:civitas:error:INVALID_INPUT");
  });
  test("Detail names the unknown field", function() {
    expect(res.body.detail).to.equal("Unknown field: /colour");
  });
}

docs {
  **Precondition:** `dataSetId` is set.

  **Expected Response**
  - Status: `400 Bad Request`
  - Body is a problem with type `urn:civitas:error:INVALID_INPUT` and detail `Unknown field: /colour`
  - The patch is not applied, so `description` keeps its value

  **System Impact:** none.
}
