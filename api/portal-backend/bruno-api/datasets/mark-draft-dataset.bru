meta {
  name: Mark Draft Dataset
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/datasets/:id/markDraft
  body: none
  auth: inherit
}

params:path {
  id: {{dataSetId}}
}

tests {
  test("Unpublished or precondition not met", function() {
    const status = res.getStatus();
    // 200=unpublished, 400=pending saga or already DRAFT
    expect(status === 200 || status === 400).to.be.true;
  });
}

docs {
  **Precondition:** `dataSetId` is set; dataset is in `READY` state.

  Reverts the dataset to DRAFT status. Auto-generated distributions are removed.

  **Expected Response**
  - Status: `200 OK`
  - Body reflects dataset with status `DRAFT`

  **System Impact**

  | System | Expected Change |
  |---|---|
  | Backend | DataSet status → `DRAFT`; distributions removed |
}
