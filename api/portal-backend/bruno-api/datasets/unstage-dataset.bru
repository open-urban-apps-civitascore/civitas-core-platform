meta {
  name: Unstage Dataset
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/datasets/:id/unstage
  body: none
  auth: inherit
}

params:path {
  id: {{dataSetId}}
}

tests {
  test("Unstaged or precondition not met", function() {
    const status = res.getStatus();
    // 200=unstaged, 400=pending saga or already DRAFT
    expect(status === 200 || status === 400).to.be.true;
  });
}

docs {
  **Precondition:** `dataSetId` is set; dataset is in `READY` state.

  Reverts the dataset to DRAFT status.

  **Expected Response**
  - Status: `200 OK`
  - Body reflects dataset with status `DRAFT`

  **System Impact**

  | System | Expected Change |
  |---|---|
  | Backend | DataSet status → `DRAFT` |
}
