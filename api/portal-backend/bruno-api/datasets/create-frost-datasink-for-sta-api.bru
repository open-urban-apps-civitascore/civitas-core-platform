meta {
  name: Create FROST DataSink for the STA API
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/datasets/:dataSetId/datasinks
  body: json
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
}

body:json {
  {
    "dataSinkType": "FROST",
    "configuration": {}
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('datasetsFrostDataSinkId', res.body.id);
  }
}

tests {
  test("DataSink created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  **Datasets setup** — the STA API that `update-dataset` adds needs an active FROST DataSink in the DataSet. Without it the update answers `400` on `namedApis`.

  **Precondition:** `dataSetId` is set by `create-dataset`.

  **Expected Response:** 201 Created with `id`.

  **Post-condition:** Saves `datasetsFrostDataSinkId`. `delete-dataset` removes the DataSink together with the DataSet.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSink record created, linked to the DataSet |
  | Config Adapter | — |
  | External System | — |
}
