meta {
  name: Patch Dataset
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/datasets/:id
  body: json
  auth: inherit
}

params:path {
  id: {{dataSetId}}
}

body:json {
  {
    "description": "Patched description"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('dataSetId', res.body.id);
    bru.setVar('scopeType', 'DATASET');
    bru.setVar('scopeId', res.body.id);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Precondition:** `dataSetId` is set.

  **Expected Response:** 200 OK, body reflects updated `description`; other fields unchanged.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSet `description` updated; other fields unchanged |
  | Config Adapter | — |
  | External System | — |
}
