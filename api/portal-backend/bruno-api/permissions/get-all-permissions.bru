meta {
  name: Get All Permissions
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/permissions
  body: none
  auth: inherit
}

params:query {
  ~name: read
  ~description: Allows read access
  ~q: read
  ~permissionType: SYSTEM
  ~category: TENANT_ADMINISTRATION
  ~source: INTERNAL
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Returns array of permissions", function() {
    expect(res.body).to.be.an('array');
  });
}
