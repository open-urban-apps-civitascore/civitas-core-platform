meta {
  name: Delete Pipeline
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/datasets/:dataSetId/pipelines/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
  id: {{pipelineId}}
}

tests {
  test("Status code is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  **Precondition:** `dataSetId` and `pipelineId` are set.

  **Expected Response:** 204 No Content.

  **Verification:** Issue TC-PIPE-02 for same `pipelineId` and confirm 404.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Pipeline record removed |
  | Config Adapter | -- |
  | External System | -- |
}
