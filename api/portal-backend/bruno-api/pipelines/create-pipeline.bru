meta {
  name: Create Pipeline
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/datasets/:dataSetId/pipelines
  body: json
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
}

body:json {
  {
    "name": "Traffic Data Pipeline",
    "description": "Processes traffic sensor data",
    "dataSourceIds": [],
    "model": {
      "$schema": "https://civitasconnect.digital/core-dataset/v1",
      "id": "traffic-data-pipeline",
      "dataStructures": {
        "TrafficReading": {
          "type": "object",
          "properties": { "sensorId": { "type": "string" }, "count": { "type": "integer" } }
        },
        "TrafficObservation": {
          "type": "object",
          "properties": {
            "station_id": { "type": "string" },
            "vehicle_count": { "type": "integer" },
            "status": { "type": "string" }
          }
        }
      },
      "mappings": [
        {
          "id": "reading-to-observation",
          "label": "Traffic reading → observation",
          "source": "TrafficReading",
          "target": "TrafficObservation",
          "fields": {
            "station_id": { "op": "copy", "sourcePath": "$.sensorId" },
            "vehicle_count": { "op": "copy", "sourcePath": "$.count" },
            "status": { "op": "const", "value": "active" }
          }
        }
      ],
      "dataSources": [
        {
          "id": "traffic-mqtt",
          "label": "Traffic MQTT broker",
          "connectionType": "mqtt",
          "dataStructure": "TrafficReading",
          "brokerUrl": "tcp://mosquitto:1883",
          "topic": "traffic/+/count"
        }
      ],
      "dataSinks": [
        {
          "id": "traffic-frost",
          "label": "FROST Things endpoint",
          "connectionType": "http",
          "dataStructure": "TrafficObservation",
          "url": "${FROST_BASE}/Things",
          "method": "POST",
          "contentType": "application/json"
        }
      ],
      "pipelines": [
        {
          "id": "traffic-pipeline",
          "label": "MQTT → mapping → FROST",
          "nodes": [
            { "id": "n-source", "kind": "source", "sourceRef": "traffic-mqtt", "x-ui-position": { "x": 0, "y": 0 } },
            { "id": "n-mapping", "kind": "mapping", "mappingRef": "reading-to-observation", "x-ui-position": { "x": 320, "y": 0 } },
            { "id": "n-sink", "kind": "sink", "sinkRef": "traffic-frost", "x-ui-position": { "x": 640, "y": 0 } }
          ],
          "edges": [
            { "id": "e-source-mapping", "source": "n-source", "target": "n-mapping" },
            { "id": "e-mapping-sink", "source": "n-mapping", "target": "n-sink" }
          ]
        }
      ]
    }
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('pipelineId', res.body.id);
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("Has id", function() {
    expect(res.body.id).to.be.a('string');
  });
  test("Has name", function() {
    expect(res.body.name).to.be.a('string');
  });
}

docs {
  **Precondition:** `dataSetId` is set.

  **Expected Response:** 201 Created, body contains `id`.

  **Post-condition:** Save `pipelineId` from `body.id`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Pipeline record created in `portal_backend` DB, linked to the DataSet |
  | Config Adapter | -- |
  | External System | -- (FROST is affected when the parent DataSet is released, not on pipeline creation) |
}
