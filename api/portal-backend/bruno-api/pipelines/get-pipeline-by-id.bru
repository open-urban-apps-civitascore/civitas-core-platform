meta {
  name: Get Pipeline by ID
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/datasets/:dataSetId/pipelines/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
  id: {{pipelineId}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Has correct id", function() {
    expect(res.body.id).to.be.a('string');
  });
}

docs {
  **Precondition:** `dataSetId` and `pipelineId` are set.

  **Expected Response:** 200 OK, body contains the pipeline with matching `id`.
}
