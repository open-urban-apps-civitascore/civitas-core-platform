meta {
  name: Update Pipeline
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/datasets/:dataSetId/pipelines/:id
  body: json
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
  id: {{pipelineId}}
}

body:json {
  {
    "name": "Traffic Data Pipeline",
    "description": "Updated pipeline description",
    "dataSourceIds": [],
    "styles": {
      "viewport": {
        "x": 0,
        "y": 0,
        "zoom": 1
