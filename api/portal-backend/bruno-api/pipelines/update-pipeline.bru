meta {
  name: Update Pipeline
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/datasets/:dataSetId/pipelines/:id
  body: json
  auth: inherit
}

params:path {
  dataSetId: {{dataSetId}}
  id: {{pipelineId}}
}

body:json {
  {
    "name": "Traffic Data Pipeline",
    "description": "Updated pipeline description",
    "styles": {},
    "model": {},
    "dataSourceIds": [],
    "apis": [],
    "persistences": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('pipelineId', res.body.id);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
