meta {
  name: 9b. Verify APISIX Route Config
  type: http
  seq: 21
}

get {
  url: {{apisixAdminUrl}}/apisix/admin/routes/{{sagaDataSetId}}
  body: none
  auth: none
}

headers {
  X-API-KEY: {{apisixAdminKey}}
}

script:pre-request {
  // Wait for async saga to create APISIX route (max 30s, poll every 2s)
  const axios = require('axios');
  const adminUrl = bru.getEnvVar('apisixAdminUrl');
  const adminKey = bru.getEnvVar('apisixAdminKey');
  const datasetId = bru.getVar('sagaDataSetId');

  for (let i = 0; i < 15; i++) {
    try {
      const resp = await axios.get(
        `${adminUrl}/apisix/admin/routes/${datasetId}`,
        { headers: { 'X-API-KEY': adminKey }, validateStatus: () => true }
      );
      if (resp.status === 200) break;
    } catch (e) { /* route not created yet */ }
    await new Promise(r => setTimeout(r, 2000));
  }
}

tests {
  test("Route exists in APISIX", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Route has correct URI pattern", function() {
    const route = res.body.value || res.body;
    const uris = route.uris || [route.uri];
    const datasetId = bru.getVar('sagaDataSetId');
    const hasDatasetUri = uris.some(u => u.includes(datasetId));
    expect(hasDatasetUri).to.be.true;
  });

  test("Route references upstream", function() {
    const route = res.body.value || res.body;
    expect(route.upstream_id).to.be.a('string');
  });

  test("Route has plugin_config_id (auth enabled)", function() {
    const route = res.body.value || res.body;
    expect(route.plugin_config_id).to.equal('1');
  });
}
