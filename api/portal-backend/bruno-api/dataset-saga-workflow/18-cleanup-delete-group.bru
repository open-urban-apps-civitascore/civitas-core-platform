meta {
  name: 18. Cleanup - Delete Group
  type: http
  seq: 36
}

delete {
  url: {{baseUrl}}/groups/:id
  body: none
  auth: inherit
}

params:path {
  id: {{sagaGroupId}}
}

tests {
  test("Group deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=invalid ID
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}

docs {
  **Saga step 18 of 18** — Delete the group (cleanup, final step).

  Removes the group created in step 2. This is the last cleanup step; the assignment must have been deleted first (step 14) before the group can be removed.

  **Expected Response:** 204 No Content. 404 if already deleted.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Group record removed from `portal_backend` DB |
  | Config Adapter | Produces `de.civitascore.idm.group.deleted` Kafka event; forwards deletion to Keycloak |
  | Keycloak | Group removed from `civitas-core` realm |
}
