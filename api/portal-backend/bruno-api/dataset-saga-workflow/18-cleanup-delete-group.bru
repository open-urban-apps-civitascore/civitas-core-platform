meta {
  name: 18. Cleanup - Delete Group
  type: http
  seq: 27
}

delete {
  url: {{baseUrl}}/groups/:id
  body: none
  auth: inherit
}

params:path {
  id: {{sagaGroupId}}
}

tests {
  test("Group deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=invalid ID
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}
