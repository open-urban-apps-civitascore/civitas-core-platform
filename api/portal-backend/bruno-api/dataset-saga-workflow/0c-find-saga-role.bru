meta {
  name: 0c. Find Existing Saga Role
  type: http
  seq: 3
  tags: [
    requires-nifi
  ]
}

get {
  url: {{baseUrl}}/roles?search=Saga Test Data Role
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 200 && res.body && res.body.content) {
    const match = res.body.content.find(r => r.name === 'Saga Test Data Role');
    if (match) {
      bru.setVar('sagaRoleId', match.id);
    }
  }
}

tests {
  test("Lookup succeeded", function() {
    // Always 200 — search returns empty page if entity doesn't exist
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Purpose:** Idempotency guard — checks whether the "Saga Test Data Role" from a previous saga run already exists. If found, `sagaRoleId` is populated so step 3 can be skipped and step 17 targets the correct record for cleanup.

  **Expected Response:** 200 OK, body is a paginated list (may be empty on a fresh run).

  **Post-condition:** If a match is found, saves `sagaRoleId` from `body.content[].id`.
}
