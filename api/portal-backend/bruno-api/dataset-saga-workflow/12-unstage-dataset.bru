meta {
  name: 12. Unstage DataSet
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/datasets/:id/unstage
  body: none
  auth: inherit
}

params:path {
  id: {{sagaDataSetId}}
}

script:pre-request {
  // Wait for the DATASET_DELETE saga (triggered by unrelease, step 11) to finish — pendingSagaType
  // cleared, status READY — before unstaging. Without this wait, unstage 400s on the still-pending
  // saga (dataset stays READY), and the downstream pipeline/datasink deletes then fail because the
  // pipeline can only be removed from a DRAFT dataset.
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl');
  const keycloakUrl = bru.getEnvVar('keycloakUrl');
  const datasetId = bru.getVar('sagaDataSetId');

  // Bruno's QuickJS sandbox has no URLSearchParams — build the form body by hand.
  const form = [
    ['grant_type', 'password'],
    ['client_id', bru.getEnvVar('clientId')],
    ['client_secret', bru.getEnvVar('clientSecret')],
    ['username', bru.getEnvVar('username')],
    ['password', bru.getEnvVar('password')],
  ].map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join('&');

  const tokenResp = await axios.post(
    `${keycloakUrl}/realms/${bru.getEnvVar('realm')}/protocol/openid-connect/token`,
    form,
    { headers: { 'Content-Type': 'application/x-www-form-urlencoded' } }
  );
  const token = tokenResp.data.access_token;

  for (let i = 0; i < 30; i++) {
    const resp = await axios.get(
      `${baseUrl}/datasets/${datasetId}`,
      {
        headers: { 'Authorization': `Bearer ${token}` },
        validateStatus: () => true,
      }
    );
    if (resp.status === 404) break; // already deleted by a previous run
    if (resp.status === 200 && resp.data && resp.data.pendingSagaType === null
        && resp.data.dataSetStatus === 'READY') {
      break;
    }
    await new Promise(r => setTimeout(r, 2000));
  }
}

tests {
  test("Unstaged or already draft", function() {
    const status = res.getStatus();
    // 200=unstaged, 400=pending saga or already DRAFT
    expect(status === 200 || status === 400).to.be.true;
  });
}

docs {
  **Saga step 12 of 18** — Unstage the dataset before deleting it.

  Transitions the dataset from `READY` back to `DRAFT`. This must be called after the DATASET_DELETE saga from step 11 has completed. A 400 is returned if a saga is still pending or the dataset is already in `DRAFT`.

  **Precondition:** `sagaDataSetId` is set; dataset is in `READY` state (DATASET_DELETE saga has completed).

  **Expected Response:** 200 OK, body reflects dataset with status `DRAFT`. 400 if a saga is still pending or already `DRAFT`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSet status → `DRAFT` |
  | Config Adapter | — |
  | External System | — |
}
