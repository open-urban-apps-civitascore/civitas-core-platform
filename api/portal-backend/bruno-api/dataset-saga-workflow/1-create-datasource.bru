meta {
  name: 1. Create DataSource (MQTT)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}

body:json {
  {
    "name": "TAF10 Energy Meter",
    "description": "HiveMQ public MQTT broker — TAF10 energy meter demo data",
    "connectorType": "MQTT",
    "configuration": {
      "urls": ["tcp://broker.hivemq.com:1883"],
      "topics": ["+/civitas+/civitas/core/energy/meter/+/taf10"],
      "qos": 1,
      "connect_timeout": "5s",
      "keepalive": "30s",
      "tls": {
        "enabled": false
      }
    },
    "dataStructureVersionId": null,
    "assignments": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaDataSourceId', res.body.id);
  }
}

tests {
  test("DataSource created or already exists", function() {
    const status = res.getStatus();
    // 201=created, 409=already exists from previous run
    expect(status === 201 || status === 409).to.be.true;
  });
}

docs {
  **Saga step 1 of 18** — Prerequisites: create supporting resources before triggering the saga.

  Creates the MQTT datasource ("TAF10 Energy Meter") that the pipeline will consume. This datasource is referenced by the pipeline created in step 5 and provides the data source configuration for the saga.

  **Expected Response:** 201 Created, body contains `id`. 409 if the datasource already existed (idempotent).

  **Post-condition:** Save `sagaDataSourceId` from `body.id`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSource record created in `portal_backend` DB with status `DRAFT` |
  | Config Adapter | — |
  | External System | — |
}
