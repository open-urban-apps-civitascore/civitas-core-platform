meta {
  name: 1. Create DataSource (MQTT)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/datasources
  body: json
  auth: inherit
}

body:json {
  {
    "name": "TAF10 Energy Meter",
    "description": "HiveMQ public MQTT broker — TAF10 energy meter demo data",
    "connectorType": "MQTT",
    "configuration": {
      "urls": ["tcp://broker.hivemq.com:1883"],
      "topics": ["+/civitas+/civitas/core/energy/meter/+/taf10"],
      "client_id": "civitas-saga-demo",
      "qos": 1,
      "connect_timeout": "5s",
      "keepalive": "30s",
      "tls": {
        "enabled": false
      }
    },
    "dataStructureVersionId": null,
    "assignments": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaDataSourceId', res.body.id);
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Has id", function() {
    expect(res.body.id).to.be.a('string');
  });
  
  test("ConnectorType is MQTT", function() {
    expect(res.body.connectorType).to.equal("MQTT");
  });
}
