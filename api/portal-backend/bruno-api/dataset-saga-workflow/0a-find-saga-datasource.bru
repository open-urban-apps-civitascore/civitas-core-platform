meta {
  name: 0a. Find Existing Saga DataSource
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/datasources?search=TAF10 Energy Meter
  body: none
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

script:post-response {
  if (res.getStatus() === 200 && res.body && res.body.content) {
    const match = res.body.content.find(d => d.name === 'TAF10 Energy Meter');
    if (match) {
      bru.setVar('sagaDataSourceId', match.id);
    }
  }
}

tests {
  test("Lookup succeeded", function() {
    // Always 200 — search returns empty page if entity doesn't exist
    expect(res.getStatus()).to.equal(200);
  });
}
