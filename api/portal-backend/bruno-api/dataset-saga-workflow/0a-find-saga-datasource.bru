meta {
  name: 0a. Find Existing Saga DataSource
  type: http
  seq: 1
  tags: [
    requires-nifi
  ]
}

get {
  url: {{baseUrl}}/datasources?search=TAF10 Energy Meter
  body: none
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

script:post-response {
  if (res.getStatus() === 200 && res.body && res.body.content) {
    const match = res.body.content.find(d => d.name === 'TAF10 Energy Meter');
    if (match) {
      bru.setVar('sagaDataSourceId', match.id);
    }
  }
}

tests {
  test("Lookup succeeded", function() {
    // Always 200 — search returns empty page if entity doesn't exist
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Purpose:** Idempotency guard — checks whether the "TAF10 Energy Meter" datasource from a previous saga run already exists. If found, `sagaDataSourceId` is populated so step 1 can be skipped and step 16 targets the correct record for cleanup.

  **Expected Response:** 200 OK, body is a paginated list (may be empty on a fresh run).

  **Post-condition:** If a match is found, saves `sagaDataSourceId` from `body.content[].id`.
}
