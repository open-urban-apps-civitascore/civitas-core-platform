meta {
  name: 12c. Cleanup - Delete POSTGIS DataSink without confirmation
  type: http
  seq: 41
}

delete {
  url: {{baseUrl}}/datasets/:dataSetId/datasinks/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{sagaDataSetId}}
  id: {{sagaPostgisDataSinkId}}
}

script:post-response {
  const impact = (res.body && res.body.impact) || {};
  const ids = [].concat(impact.dataSinks || [], impact.layers || [], impact.apis || []).map(e => e.id);
  bru.setVar('sagaPostgisConfirmation', ids.map(id => 'confirmedRemovalIds=' + id).join('&'));
}

tests {
  const body = res.body || {};

  test("Delete refused until the removal is confirmed", function() {
    expect(res.getStatus()).to.equal(409);
    expect(body.type).to.equal('urn:civitas:error:REMOVAL_CONFIRMATION_REQUIRED');
  });
  test("The impact lists the provisioned POSTGIS DataSink and the OWS API", function() {
    const sink = body.impact.dataSinks.find(s => s.id === bru.getVar('sagaPostgisDataSinkId'));
    expect(sink.provisioned).to.equal(true);
    expect(body.impact.apis.map(a => a.standard)).to.deep.equal(['OWS']);
  });
}

docs {
  **Saga step 12c** — Delete the POSTGIS DataSink without `confirmedRemovalIds`.

  A direct delete makes a DataSink inactive even though no Pipeline links it. The release in step 8 provisioned this DataSink, and it is the last active POSTGIS DataSink, so the OWS API would go with it. The backend refuses the delete with `409` and changes nothing.

  **Expected Response:** 409 Conflict, type `urn:civitas:error:REMOVAL_CONFIRMATION_REQUIRED`, property `impact` with the POSTGIS DataSink and the OWS API.

  **Post-condition:** Saves `sagaPostgisConfirmation` (`confirmedRemovalIds=<id>&...`).

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | — (nothing changes) |
  | Config Adapter | — |
}
