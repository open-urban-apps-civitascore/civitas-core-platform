meta {
  name: 12c. Cleanup - Delete POSTGIS DataSink without confirmation
  type: http
  seq: 40
}

delete {
  url: {{baseUrl}}/datasets/:dataSetId/datasinks/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{sagaDataSetId}}
  id: {{sagaPostgisDataSinkId}}
}

tests {
  const body = res.body || {};

  test("Delete refused until data loss is confirmed", function() {
    expect(res.getStatus()).to.equal(409);
    expect(body.type).to.equal('urn:civitas:error:REMOVAL_NOT_CONFIRMED');
    expect(body.detail).to.include('confirmDataLoss=true');
  });
}

docs {
  **Saga step 12c** — Delete the POSTGIS DataSink without `confirmDataLoss`.

  A direct delete makes a DataSink inactive even though no Pipeline links it. The release in step 8 provisioned this DataSink, so the next release deletes its stored data. The backend refuses the delete with `409` and changes nothing.

  **Expected Response:** 409 Conflict, type `urn:civitas:error:REMOVAL_NOT_CONFIRMED`, `detail` tells to set `confirmDataLoss=true`, `removal` lists the `dataSinks`, `layers` and `apis` that go.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | — (nothing changes) |
  | Config Adapter | — |
}
