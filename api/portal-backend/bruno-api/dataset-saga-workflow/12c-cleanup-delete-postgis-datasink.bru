meta {
  name: 12c. Cleanup - Delete POSTGIS DataSink
  type: http
  seq: 37
}

delete {
  url: {{baseUrl}}/datasets/:dataSetId/datasinks/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{sagaDataSetId}}
  id: {{sagaPostgisDataSinkId}}
}

tests {
  test("POSTGIS DataSink deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=sagaPostgisDataSinkId never set (aborted run)
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}

docs {
  **Saga step 12c** — Delete the POSTGIS DataSink (cleanup).

  Removes the DataSink created in step 4d, alongside the FROST sink in step 12b and before the dataset in step 13: `data_sinks.dataset_id` is `NOT NULL` with no `ON DELETE CASCADE`.

  The dataset carries no layers in this collection, so the standalone delete is not blocked — a sink whose dataset lives on is only rejected with `409` while a layer still sits on it.

  **Expected Response:** 204 No Content. 404 if already deleted. 400 if `sagaPostgisDataSinkId` is not set (first run / aborted earlier).

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSink record removed from `portal_backend` DB |
  | Config Adapter | — (PostGIS schema and GeoServer workspace cleanup happens via the DELETE saga on unrelease) |
}
