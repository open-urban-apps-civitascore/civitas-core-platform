meta {
  name: 3c. Create DataStructure Version
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/datastructures/:dataStructureId/versions
  body: json
  auth: inherit
}

params:path {
  dataStructureId: {{sagaDataStructureId}}
}

body:json {
  {
    "dataStructureVersionSource": "OWN",
    "version": "1.0.0",
    "description": "Initial version for saga sensor data",
    "modelName": "StudentDatabaseModel1",
    "model": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "StudentDatabaseModel1",
      "type": "object",
      "properties": {
        "attribut": { "type": "string" }
      }
    },
    "styles": {}
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaDataStructureVersionId', res.body.id);
  }
}

tests {
  test("Version created or already exists", function() {
    const status = res.getStatus();
    // 201=created, 409=already exists from previous run
    expect(status === 201 || status === 409).to.be.true;
  });

  test("Has id", function() {
    if (res.getStatus() === 201) {
      expect(res.body.id).to.be.a('string');
    }
  });

  test("Has version string", function() {
    if (res.getStatus() === 201) {
      expect(res.body.version).to.be.a('string');
    }
  });
}

docs {
  ## Setup – Create DataStructure Version

  **Precondition:** `sagaDataStructureId` is set (from step 3).

  Creates a version with a JSON Schema model for the data structure.

  **Expected Response**
  - Status: `201 Created`
  - Body contains `id`

  **Post-condition:** Saves `sagaDataStructureVersionId` from `body.id`.

  **System Impact**

  | System | Expected Change |
  |---|---|
  | Backend | Version record created in `portal_backend` DB, linked to the DataStructure |
}
