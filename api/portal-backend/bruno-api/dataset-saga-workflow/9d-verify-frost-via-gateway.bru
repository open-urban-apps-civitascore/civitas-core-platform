meta {
  name: 9d. Verify FROST via APISIX Gateway
  type: http
  seq: 25
  tags: [
    requires-nifi
  ]
}

get {
  url: {{sagaPublicUrl}}/{{sagaSlug}}
  body: none
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

tests {
  test("sagaPublicUrl is populated by step 9", function() {
    // If step 9 observed the saga still running, sagaPublicUrl is unset and hitting
    // it would dereference a literal `{{sagaPublicUrl}}`. Fail loudly instead so the
    // root cause (saga didn't complete in time) is obvious.
    const url = bru.getVar('sagaPublicUrl');
    expect(url, "step 9 must have stored the publicUrl — saga likely did not complete").to.be.a('string').and.not.empty;
  });

  test("FROST reachable via persisted publicUrl", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response is valid JSON", function() {
    expect(res.body).to.be.an('object');
  });
}

docs {
  **Saga step 9d of 18** — Verify end-to-end data access using the publicUrl that the saga persisted on the dataset.

  Uses the persisted `sagaPublicUrl` (`body.publicUrl` from step 9) plus the named-API `sagaSlug` as the request target — `{publicUrl}/{slug}` = `apisix.api.public.url` + `/v1/datasets/{id}/{slug}` — the per-NamedApi data-plane route (#1368). This pins the actual client contract: the per-slug URL must be reachable through the gateway with its `Host` header matching the saga-provisioned route's `hosts` filter. A silent drift between `APISIX_API_PUBLIC_URL` and `APISIX_API_HOST`, or a missing per-slug route, would make the URL unusable and this test would 404.

  **Precondition:** `sagaPublicUrl` is set by step 9 (saga completed); bearer token is valid; the persisted host resolves to the APISIX gateway.

  **Expected Response:** 200 OK, body is a valid JSON object from the FROST SensorThings API.
}
