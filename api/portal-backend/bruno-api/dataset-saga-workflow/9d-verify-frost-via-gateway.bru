meta {
  name: 9d. Verify FROST via APISIX Gateway
  type: http
  seq: 25
  tags: [
    requires-nifi
  ]
}

get {
  url: {{apisixGatewayUrl}}/datasets/{{sagaDataSetId}}
  body: none
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

tests {
  test("FROST reachable via APISIX gateway", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response is valid JSON", function() {
    expect(res.body).to.be.an('object');
  });
}

docs {
  **Saga step 9d of 18** — Verify end-to-end data access through the gateway.

  Sends an authenticated request through the APISIX gateway to the FROST server for the dataset route. This confirms the full data path is working: Keycloak token → APISIX (auth validation) → FROST (data response).

  **Precondition:** `sagaDataSetId` is set; bearer token is valid; APISIX gateway reachable at `apisixGatewayUrl`; saga completed and route + upstream exist.

  **Expected Response:** 200 OK, body is a valid JSON object from the FROST SensorThings API.
}
