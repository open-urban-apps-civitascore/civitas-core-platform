meta {
  name: 11b. Verify APISIX Route Removed (delete saga)
  type: http
  seq: 34
}

get {
  url: {{apisixAdminUrl}}/apisix/admin/routes/{{sagaDataSetId}}
  body: none
  auth: none
}

headers {
  X-API-KEY: {{apisixAdminKey}}
}

script:pre-request {
  // The DATASET_DELETE saga (step 11) removes the dataset's APISIX route asynchronously.
  // Poll the Admin API until the route is gone (404), max ~30s.
  const axios = require('axios');
  const adminUrl = bru.getEnvVar('apisixAdminUrl');
  const adminKey = bru.getEnvVar('apisixAdminKey');
  const id = bru.getVar('sagaDataSetId');
  for (let i = 0; i < 15; i++) {
    const r = await axios.get(`${adminUrl}/apisix/admin/routes/${id}`, {
      headers: { 'X-API-KEY': adminKey }, validateStatus: () => true,
    });
    if (r.status === 404) break;
    await new Promise(res => setTimeout(res, 2000));
  }
}

tests {
  test("Route no longer exists in APISIX (404)", function() {
    expect(res.getStatus()).to.equal(404);
  });
}

docs {
  **Saga step 11b of 18** — Verify the DATASET_DELETE saga de-provisioned the gateway route (issue #1368, journey J5).

  After unrelease (step 11) triggers the DELETE saga, the dataset's APISIX route (created in step 8, verified in 9b) must be removed. This is the teardown counterpart to 9b — a lingering route would leave a dangling, unauthenticated-or-orphaned data-plane path after the dataset is gone.

  **Precondition:** step 11 (unrelease) accepted; pre-request polled the Admin API until 404.

  **Expected Response:** 404 Not Found from the APISIX Admin API for the dataset's route.
}
