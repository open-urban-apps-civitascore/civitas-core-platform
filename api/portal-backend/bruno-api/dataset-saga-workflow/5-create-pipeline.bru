meta {
  name: 5. Create Pipeline
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/datasets/:dataSetId/pipelines
  body: json
  auth: inherit
}

params:path {
  dataSetId: {{sagaDataSetId}}
}

body:json {
  {
    "name": "Saga Test Pipeline",
    "description": "Pipeline for saga workflow test",
    "dataSourceIds": ["{{sagaDataSourceId}}"],
    "model": {
      "viewport": { "x": 0, "y": 0, "zoom": 1 },
      "nodePositions": {
        "22222222-2222-4000-8000-000000000001": { "x": 360, "y": -40 },
        "22222222-2222-4000-8000-000000000003": { "x": 740, "y": 80 }
      },
      "nodes": [
        {
          "id": "22222222-2222-4000-8000-000000000001",
          "type": "start",
          "position": { "x": 360, "y": -40 },
          "data": { "nodeType": "start", "label": "Start", "configured": true, "description": "Entry point of the pipeline. Execution begins here." },
          "measured": { "width": 32, "height": 32 }
        },
        {
          "id": "22222222-2222-4000-8000-000000000003",
          "type": "end",
          "position": { "x": 740, "y": 80 },
          "data": { "nodeType": "end", "label": "End", "configured": true, "description": "Exit point of the pipeline. Execution completes here." },
          "measured": { "width": 32, "height": 32 }
        }
      ],
      "edges": [
        { "id": "22222222-2222-4000-8000-0000000000e1", "source": "22222222-2222-4000-8000-000000000001", "target": "22222222-2222-4000-8000-000000000003", "type": "smoothstep", "data": { "label": "" } }
      ]
    }
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaPipelineId', res.body.id);
  }
}

tests {
  test("Pipeline created or already exists", function() {
    const status = res.getStatus();
    // 201=created, 409=already exists from previous run
    expect(status === 201 || status === 409).to.be.true;
  });
}

docs {
  **Saga step 5 of 20** — Prerequisites: DataSource released (step 4b), DataSet created (step 4).

  Creates a pipeline ("Saga Test Pipeline") attached to the dataset, modelled as a CORE intermediate-representation document (`model`). The pipeline consumes from the MQTT datasource (`sagaDataSourceId`) and posts to FROST. The datasource must be in AVAILABLE status (released in step 4b) before it can be linked. When the dataset is released, the saga deploys this pipeline to the pipeline engine.

  **Expected Response:** 201 Created, body contains `id`. 409 if the pipeline already existed (idempotent).

  **Post-condition:** Save `sagaPipelineId` from `body.id`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Pipeline record created in `portal_backend` DB linked to the dataset |
  | Config Adapter | — |
  | Pipeline engine | Pipeline is deployed only after the DATASET_CREATE saga runs (step 8) |
}
