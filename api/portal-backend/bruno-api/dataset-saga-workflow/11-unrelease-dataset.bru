meta {
  name: 11. Unrelease DataSet (triggers delete saga)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/datasets/:id/unrelease
  body: none
  auth: inherit
}

params:path {
  id: {{sagaDataSetId}}
}

tests {
  test("Unreleased or already not released", function() {
    const status = res.getStatus();
    // 202=delete saga triggered, 400=not in AVAILABLE state
    expect(status === 202 || status === 400).to.be.true;
  });
}
