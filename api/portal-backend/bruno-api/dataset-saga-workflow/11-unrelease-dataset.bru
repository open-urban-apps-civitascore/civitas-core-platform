meta {
  name: 11. Unrelease DataSet (triggers delete saga)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/datasets/:id/unrelease
  body: none
  auth: inherit
}

params:path {
  id: {{sagaDataSetId}}
}

tests {
  test("Status code is 202", function() {
    expect(res.getStatus()).to.equal(202);
  });

  test("Pending saga type is DELETE", function() {
    expect(res.body.pendingSagaType).to.equal("DELETE");
  });
}
