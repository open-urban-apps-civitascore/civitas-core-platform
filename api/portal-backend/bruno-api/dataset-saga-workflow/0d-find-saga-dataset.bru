meta {
  name: 0d. Find Existing Saga DataSet
  type: http
  seq: 4
  tags: [
    requires-nifi
  ]
}

get {
  url: {{baseUrl}}/datasets?search=Saga Test DataSet
  body: none
  auth: inherit
}

headers {
  X-Allowed-Scope-Ids: *
}

script:post-response {
  if (res.getStatus() === 200 && res.body && res.body.content) {
    const match = res.body.content.find(d => d.name === 'Saga Test DataSet');
    if (match) {
      bru.setVar('sagaDataSetId', match.id);
      bru.setVar('sagaDataSetStatus', match.dataSetStatus);
    }
  }
}

tests {
  test("Lookup succeeded", function() {
    // Always 200 — search returns empty page if entity doesn't exist
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Purpose:** Idempotency guard — checks whether the "Saga Test DataSet" from a previous saga run already exists. If found, `sagaDataSetId` and `sagaDataSetStatus` are populated so step 4 can be skipped and steps 11-13 target the correct record.

  **Expected Response:** 200 OK, body is a paginated list (may be empty on a fresh run).

  **Post-condition:** If a match is found, saves `sagaDataSetId` from `body.content[].id` and `sagaDataSetStatus` from `body.content[].dataSetStatus`.
}
