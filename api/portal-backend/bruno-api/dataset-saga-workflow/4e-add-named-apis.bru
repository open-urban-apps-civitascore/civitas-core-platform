meta {
  name: 4e. Add the STA and OWS named APIs
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/datasets/:id
  body: json
  auth: inherit
}

params:path {
  id: {{sagaDataSetId}}
}

body:json {
  {
    "namedApis": [
      { "name": "Things", "slug": "things", "standard": "STA", "version": "1.1" },
      { "name": "Map", "slug": "map", "standard": "OWS" }
    ]
  }
}

script:post-response {
  // Per-NamedApi route model (#1368): remember the API slug so the route guards (9b/9g) can
  // target the per-slug route /v1/datasets/{id}/{slug} instead of the old flat datasetId scheme.
  const apis = (res.body && res.body.namedApis) || [];
  const sta = apis.find(a => a.standard === 'STA') || apis[0];
  bru.setVar('sagaSlug', (sta && sta.slug) || 'things');
  // OWS named-API slug for the anonymous OWS open-data e2e (9g4): proves open data is universal
  // across routable backends, not FROST-only.
  const ows = apis.find(a => a.standard === 'OWS');
  bru.setVar('sagaOwsSlug', (ows && ows.slug) || 'map');
}

tests {
  test("Named APIs added", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.namedApis).to.have.lengthOf(2);
  });
}

docs {
  **Saga step 4e** — Prerequisites: FROST DataSink (step 4c) and POSTGIS DataSink (step 4d) created.

  Adds the STA API `things` and the OWS API `map`. An API can be added only while an active DataSink of a kind that backs it exists (FROST for STA, PostGIS for OWS), so this step runs after the DataSinks and not with the dataset create in step 4.

  **Expected Response:** 200 OK, `namedApis` holds both entries.

  **Post-condition:** Saves `sagaSlug` and `sagaOwsSlug`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Two NamedApi rows created for the dataset |
  | Config Adapter | — (routes are provisioned when the DATASET_CREATE saga runs in step 8) |
  | External System | — |
}
