meta {
  name: 9j. Verify Discovery API (GET /v1/datasets/{id}/apis, #1596)
  type: http
  seq: 31
}

get {
  url: {{apisixApiUrl}}/v1/datasets/{{sagaDataSetId}}/apis
  body: none
  auth: inherit
}

script:pre-request {
  // OPA authorization data for a freshly provisioned dataset propagates asynchronously, so an
  // immediate call can transiently 401/403. Poll the discovery endpoint until it returns 200
  // (max 30s) so the assertions below don't race OPA propagation.
  const axios = require('axios');
  const apiUrl = bru.getEnvVar('apisixApiUrl');
  const datasetId = bru.getVar('sagaDataSetId');

  try {
    const tokenUrl = `${bru.getEnvVar('keycloakUrl')}/realms/${bru.getEnvVar('realm')}/protocol/openid-connect/token`;
    // Build the form body by hand: the Bruno CLI runs scripts in a QuickJS sandbox that has no
    // URLSearchParams. encodeURIComponent is standard ECMAScript and is available.
    const form = [
      'grant_type=password',
      `username=${encodeURIComponent(bru.getEnvVar('username'))}`,
      `password=${encodeURIComponent(bru.getEnvVar('password'))}`,
      `client_id=${encodeURIComponent(bru.getEnvVar('clientId'))}`,
      `client_secret=${encodeURIComponent(bru.getEnvVar('clientSecret') || '')}`,
    ].join('&');
    const tokenResp = await axios.post(tokenUrl, form, {
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      validateStatus: () => true,
    });
    const accessToken = tokenResp.data && tokenResp.data.access_token;

    for (let i = 0; accessToken && i < 15; i++) {
      const resp = await axios.get(`${apiUrl}/v1/datasets/${datasetId}/apis`, {
        headers: { Authorization: `Bearer ${accessToken}`, 'X-Allowed-Scope-Ids': '*' },
        validateStatus: () => true,
      });
      if (resp.status === 200) break;
      await bru.sleep(2000);
    }
  } catch (e) {
    // Best-effort readiness wait; the request below still runs with its own inherited auth.
  }
}

tests {
  // Discovery endpoint GET /v1/datasets/{id}/apis (#1596, concept #1379) — a portal-backend
  // management endpoint, reached through the gateway's /v1/* management catch-all. No dedicated
  // APISIX route is needed: the per-NamedApi route model provisions specific
  // /v1/datasets/{id}/{slug} routes (no dataset-level wildcard) and `apis` is a reserved slug, so
  // nothing shadows this path. These assertions catch the three classic discovery mistakes.
  test("Discovery is not swallowed by a FROST data route (not 404)", function() {
    expect(res.getStatus()).to.not.equal(404);
  });

  test("Authorized discovery request succeeds (200, not 403)", function() {
    // A 403 would mean OPA is missing the /v1/datasets/{id}/apis GET -> DATASET_READ mapping
    // (authz/rego/data/backends/portal_backend/data.json).
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns the named-API list as an array, not a FROST SensorThings document", function() {
    // FROST's root returns an object with a `value` array; discovery must return the named APIs
    // as an array — catches a routing collision that reached FROST instead of portal-backend.
    expect(res.body).to.be.an('array');
    expect(res.body).to.not.have.property('value');
  });

  test("Discovery list includes the dataset's named API slug 'things'", function() {
    const slugs = (res.body || []).map(a => a.slug);
    expect(slugs).to.include('things');
  });

  test("Each named API carries a server-built previewUrl", function() {
    res.body.forEach(function(api) {
      expect(api.previewUrl).to.be.a('string');
    });
  });
}

docs {
  **Saga step 9j of 18 — Discovery API (#1596, concept #1379).**

  Lists the dataset's named APIs via `GET /v1/datasets/{id}/apis`. This is a **portal-backend
  management endpoint** reached through the gateway's `/v1/*` management catch-all → portal-backend.
  No dedicated higher-priority APISIX route is needed: the per-NamedApi route model provisions
  specific `/v1/datasets/{id}/{slug}` routes (there is no dataset-level `/v1/datasets/{id}/*`
  wildcard anymore), and `apis` is a reserved slug, so no named-API data route can shadow this path.

  Guards against the three classic discovery mistakes:
  1. **Routing collision** — a 404 / FROST-shaped (object with `value`) response would mean a data
     route swallowed `/apis`.
  2. **Missing OPA permission** — a 403 would mean `/v1/datasets/{id}/apis` GET is not mapped to
     `DATASET_READ`.
  3. **Wrong contract** — must return the named-API array including the known slug `things`, each
     with a server-built `previewUrl`.

  **Reserved slug:** `apis` is reserved (frontend `RESERVED_SLUGS`, backend
  `NamedApiAllowedSlugValidator`) so no named API can shadow this path.

  **Precondition:** released dataset with named API `things` (steps 4-9); bearer token has DATASET_READ.
  The pre-request polls up to 30s to absorb asynchronous OPA authorization propagation.

  **Expected:** 200 OK, JSON array of named APIs including slug `things`.
}
