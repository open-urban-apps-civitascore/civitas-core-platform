meta {
  name: 4b. Release DataSource
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/datasources/:id/release
  body: none
  auth: inherit
}

params:path {
  id: {{sagaDataSourceId}}
}

tests {
  test("Released or already released", function() {
    const status = res.getStatus();
    // 200=released, 400=not in DRAFT state (already released)
    expect(status === 200 || status === 400).to.be.true;
  });
}

docs {
  **Saga step 4b of 20** — Prerequisites: DataSource patched with dataStructureVersionId (step 4a).

  Releases the datasource, transitioning it from DRAFT to AVAILABLE status. This is required because pipelines can only link to datasources in AVAILABLE status.

  **Expected Response:** 200 OK. 400 if not in DRAFT state (already released — idempotent).

  **Post-condition:** DataSource status transitions from `DRAFT` to `AVAILABLE`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSource status updated to `AVAILABLE` in `portal_backend` DB |
  | Config Adapter | — |
  | External System | — |
}
