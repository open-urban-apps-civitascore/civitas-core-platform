meta {
  name: 16b. Cleanup - Delete DataStructure
  type: http
  seq: 31
}

delete {
  url: {{baseUrl}}/datastructures/:id
  body: none
  auth: inherit
}

params:path {
  id: {{sagaDataStructureId}}
}

tests {
  test("DataStructure deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=wrong state (still published)
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}
