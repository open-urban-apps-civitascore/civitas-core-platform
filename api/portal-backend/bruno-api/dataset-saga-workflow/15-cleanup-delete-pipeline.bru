meta {
  name: 15. Cleanup - Delete Pipeline without confirmation
  type: http
  seq: 37
}

delete {
  url: {{baseUrl}}/datasets/:dataSetId/pipelines/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{sagaDataSetId}}
  id: {{sagaPipelineId}}
}

tests {
  const body = res.body || {};

  test("Delete refused until data loss is confirmed", function() {
    expect(res.getStatus()).to.equal(409);
    expect(body.type).to.equal('urn:civitas:error:RESOURCE_IN_USE');
    expect(body.detail).to.include('confirmDataLoss=true');
  });
}

docs {
  **Saga step 15** — Delete the Pipeline without `confirmDataLoss`.

  The Pipeline links the FROST DataSink of step 4c, which the release in step 8 provisioned. Without the Pipeline the DataSink becomes inactive, and the next release deletes its stored data. So the backend refuses the delete with `409` and changes nothing.

  **Precondition:** steps 4 to 12 ran; the dataset is `DRAFT` again.

  **Expected Response:** 409 Conflict, type `urn:civitas:error:RESOURCE_IN_USE`, `detail` tells to set `confirmDataLoss=true`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | — (nothing changes) |
  | Config Adapter | — |
}
