meta {
  name: 15. Cleanup - Delete Pipeline without confirmation
  type: http
  seq: 38
}

delete {
  url: {{baseUrl}}/datasets/:dataSetId/pipelines/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{sagaDataSetId}}
  id: {{sagaPipelineId}}
}

script:post-response {
  const impact = (res.body && res.body.impact) || {};
  const ids = [].concat(impact.dataSinks || [], impact.layers || [], impact.apis || []).map(e => e.id);
  bru.setVar('sagaPipelineConfirmation', ids.map(id => 'confirmedRemovalIds=' + id).join('&'));
}

tests {
  const body = res.body || {};

  test("Delete refused until the removal is confirmed", function() {
    expect(res.getStatus()).to.equal(409);
    expect(body.type).to.equal('urn:civitas:error:REMOVAL_CONFIRMATION_REQUIRED');
  });
  test("The 409 carries the impact of step 14c", function() {
    expect(body.impact.requiresConfirmation).to.equal(true);
    expect(body.impact.dataSinks.map(s => s.id)).to.include(bru.getVar('sagaDataSinkId'));
    expect(body.impact.apis.map(a => a.standard)).to.deep.equal(['STA']);
  });
}

docs {
  **Saga step 15** — Delete the Pipeline without `confirmedRemovalIds`.

  The delete would remove the provisioned FROST DataSink and the STA API (step 14c), so the backend refuses it with `409` and changes nothing. The problem document carries the impact in `impact`; the post-response script turns its ids into the query of step 15a.

  **Precondition:** step 14c ran.

  **Expected Response:** 409 Conflict, type `urn:civitas:error:REMOVAL_CONFIRMATION_REQUIRED`, property `impact` as in step 14c.

  **Post-condition:** Saves `sagaPipelineConfirmation` (`confirmedRemovalIds=<id>&...`).

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | — (nothing changes) |
  | Config Adapter | — |
}
