meta {
  name: 15. Cleanup - Delete Pipeline
  type: http
  seq: 38
}

delete {
  url: {{baseUrl}}/datasets/:dataSetId/pipelines/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{sagaDataSetId}}
  id: {{sagaPipelineId}}
}

tests {
  test("Pipeline deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=invalid ID (unset var on first run)
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}

docs {
  **Saga step 15 of 18** — Delete the pipeline (cleanup).

  Removes the Redpanda Connect pipeline created in step 5. The DATASET_DELETE saga (step 11) must have completed before this step, ensuring the pipeline was already undeployed from Redpanda Connect.

  **Expected Response:** 204 No Content. 404 if already deleted. 400 if `sagaPipelineId` is not set (first run, pipeline was never created).

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | Pipeline record removed from `portal_backend` DB |
  | Redpanda Connect | Pipeline already undeployed by the DATASET_DELETE saga |
}
