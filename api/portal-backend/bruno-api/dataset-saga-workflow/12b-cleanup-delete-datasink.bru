meta {
  name: 12b. Cleanup - Delete DataSink
  type: http
  seq: 36
}

delete {
  url: {{baseUrl}}/datasets/:dataSetId/datasinks/:id
  body: none
  auth: inherit
}

params:path {
  dataSetId: {{sagaDataSetId}}
  id: {{sagaDataSinkId}}
}

tests {
  test("DataSink deleted or already gone", function() {
    const status = res.getStatus();
    // 204=deleted, 404=already gone, 400=sagaDataSinkId never set (aborted run)
    expect(status === 204 || status === 404 || status === 400).to.be.true;
  });
}

docs {
  **Saga step 12b** — Delete the FROST DataSink (cleanup).

  Removes the DataSink created in step 4c. This must run **before** deleting the dataset (step 13): `data_sinks.dataset_id` is `NOT NULL` with no `ON DELETE CASCADE` — deleting the parent first would violate the FK.

  **Expected Response:** 204 No Content. 404 if already deleted. 400 if `sagaDataSinkId` is not set (first run / aborted earlier).

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSink record removed from `portal_backend` DB |
  | Config Adapter | — (FROST project cleanup happens via the DELETE saga on unrelease) |
}
