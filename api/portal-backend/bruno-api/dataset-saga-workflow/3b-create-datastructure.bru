meta {
  name: 3b. Create DataStructure
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/datastructures
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Saga Sensor Data Structure",
    "description": "Data structure for saga workflow sensor readings",
    "createdFromDataSource": false,
    "dataStructureVersionIds": [],
    "assignments": []
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaDataStructureId', res.body.id);
  }
}

tests {
  test("DataStructure created or already exists", function() {
    const status = res.getStatus();
    // 201=created, 409=already exists from previous run
    expect(status === 201 || status === 409).to.be.true;
  });

  test("Has id", function() {
    if (res.getStatus() === 201) {
      expect(res.body.id).to.be.a('string');
    }
  });

  test("Has dataStructureStatus", function() {
    if (res.getStatus() === 201) {
      expect(res.body.dataStructureStatus).to.be.a('string');
    }
  });
}
