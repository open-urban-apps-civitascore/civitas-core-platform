meta {
  name: 0b. Find Existing Saga Group
  type: http
  seq: 2
  tags: [
    requires-nifi
  ]
}

get {
  url: {{baseUrl}}/groups?search=Saga Test Group
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 200 && res.body && res.body.content) {
    const match = res.body.content.find(g => g.name === 'Saga Test Group');
    if (match) {
      bru.setVar('sagaGroupId', match.id);
    }
  }
}

tests {
  test("Lookup succeeded", function() {
    // Always 200 — search returns empty page if entity doesn't exist
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  **Purpose:** Idempotency guard — checks whether the "Saga Test Group" from a previous saga run already exists. If found, `sagaGroupId` is populated so step 2 can be skipped and step 18 targets the correct record for cleanup.

  **Expected Response:** 200 OK, body is a paginated list (may be empty on a fresh run).

  **Post-condition:** If a match is found, saves `sagaGroupId` from `body.content[].id`.
}
