meta {
  name: 4. Create DataSet
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/datasets
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Saga Test DataSet",
    "description": "Dataset for end-to-end saga workflow test",
    "openDataAccess": false,
    "namedApis": [
      { "name": "Traffic", "slug": "traffic", "standard": "STA", "version": "1.1" }
    ]
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaDataSetId', res.body.id);
  }
}

tests {
  test("DataSet created or already exists", function() {
    const status = res.getStatus();
    // 201=created, 409=already exists from previous run
    expect(status === 201 || status === 409).to.be.true;
  });
}

docs {
  **Saga step 4 of 18** — Prerequisites: create supporting resources before triggering the saga.

  Creates the dataset ("Saga Test DataSet") with one named API (`traffic`) that will be staged, released (triggering the DATASET_CREATE saga and provisioning one APISIX route per named API), and later unreleased (triggering the DATASET_DELETE saga).

  **Expected Response:** 201 Created, body contains `id`. 409 if the dataset already existed (idempotent).

  **Post-condition:** Save `sagaDataSetId` from `body.id`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSet record created in `portal_backend` DB with status `DRAFT` |
  | Config Adapter | — |
  | External System | — |
}
