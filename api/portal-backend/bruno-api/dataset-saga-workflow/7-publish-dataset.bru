meta {
  name: 7. Publish DataSet
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/datasets/:id/publish
  body: none
  auth: inherit
}

params:path {
  id: {{sagaDataSetId}}
}

tests {
  test("Published or already published", function() {
    const status = res.getStatus();
    // 200=published, 400=not in DRAFT state (already published or released)
    expect(status === 200 || status === 400).to.be.true;
  });
}

docs {
  **Saga step 7 of 18** — Publish the dataset before releasing it.

  Transitions the dataset from `DRAFT` to `READY`. Publishing makes the dataset visible and prepares it for the release step. No saga is triggered here.

  **Precondition:** `sagaDataSetId` is set; dataset is in `DRAFT` state.

  **Expected Response:** 200 OK, body reflects dataset with status `READY`. 400 if the dataset is not in `DRAFT` state (e.g., already published or released).

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DataSet status → `READY` |
  | Config Adapter | — |
  | External System | — |
}
