meta {
  name: 9. Verify DataSet (after saga)
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/datasets/:id
  body: none
  auth: inherit
}

params:path {
  id: {{sagaDataSetId}}
}

script:pre-request {
  // Poll the dataset until the DATASET_CREATE saga has actually written publicUrl.
  // On fast runs this endpoint may still show pendingSagaType=CREATE when first
  // reached; without this wait, the post-response below would leave sagaPublicUrl
  // unset and 9d would fail on timing rather than on a real contract break.
  const axios = require('axios');
  const baseUrl = bru.getEnvVar('baseUrl');
  const keycloakUrl = bru.getEnvVar('keycloakUrl');
  const datasetId = bru.getVar('sagaDataSetId');

  // Bruno's QuickJS sandbox has no URLSearchParams — build the form body by hand.
  const form = [
    ['grant_type', 'password'],
    ['client_id', bru.getEnvVar('clientId')],
    ['client_secret', bru.getEnvVar('clientSecret')],
    ['username', bru.getEnvVar('username')],
    ['password', bru.getEnvVar('password')],
  ].map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join('&');

  const tokenResp = await axios.post(
    `${keycloakUrl}/realms/${bru.getEnvVar('realm')}/protocol/openid-connect/token`,
    form,
    { headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, timeout: 10000 }
  );
  const token = tokenResp.data.access_token;

  // Guard each attempt separately: the QuickJS sandbox does not honour validateStatus across the
  // VM boundary, so a transient non-2xx rejects the promise and would otherwise end the poll.
  for (let i = 0; i < 15; i++) {
    try {
      const resp = await axios.get(
        `${baseUrl}/datasets/${datasetId}`,
        {
          headers: { 'Authorization': `Bearer ${token}` },
          timeout: 10000,
        }
      );
      if (resp.status === 200 && resp.data && resp.data.publicUrl) {
        bru.setVar('sagaPublicUrl', resp.data.publicUrl);
        break;
      }
    } catch (e) { /* transient; retry */ }
    await new Promise(r => setTimeout(r, 2000));
  }
}

script:post-response {
  // Fallback: if the pre-request loop exited without setting sagaPublicUrl (e.g.
  // saga genuinely did not complete within 30s), capture whatever the main GET
  // returned so downstream steps fail with a clear, saga-attributable signal
  // rather than a dangling template placeholder.
  if (res.getStatus() === 200 && res.body && res.body.publicUrl && !bru.getVar('sagaPublicUrl')) {
    bru.setVar('sagaPublicUrl', res.body.publicUrl);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Status is AVAILABLE or READY", function() {
    const s = res.body.dataSetStatus;
    expect(s === 'AVAILABLE' || s === 'READY').to.be.true;
  });

  test("Saga completed or still pending", function() {
    // Saga may not have finished yet in fast runs
    const pst = res.body.pendingSagaType;
    expect(pst === null || pst === 'CREATE').to.be.true;
  });

  test("publicUrl (when present) matches configured API host", function() {
    // Pins the contract the adapter is expected to produce: apisix.api.public.url +
    // /v1/datasets/{id}. A silent host mismatch here (e.g. adapter using the admin
    // URL or an env-specific override drifted) would surface in 9d only as a 404.
    if (res.body && res.body.publicUrl) {
      const expected = bru.getEnvVar('apisixApiUrl') + '/v1/datasets/' + bru.getVar('sagaDataSetId');
      expect(res.body.publicUrl).to.equal(expected);
    }
  });
}

docs {
  **Saga step 9 of 18** — Poll dataset status after releasing.

  Fetches the dataset to verify the DATASET_CREATE saga has completed. The saga runs asynchronously so the dataset may still show `pendingSagaType=CREATE` if polled immediately. Once the saga finishes, `pendingSagaType` becomes `null` and `publicUrl` is populated.

  **Expected Response:** 200 OK. `dataSetStatus` is `AVAILABLE` (saga complete) or `READY` (saga failed with compensation). `pendingSagaType` is `null` (done) or `CREATE` (still running).

  **Post-condition:** If saga completed, saves `sagaPublicUrl` from `body.publicUrl` for downstream gateway verification (step 9d).
}
