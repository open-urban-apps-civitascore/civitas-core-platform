meta {
  name: 9. Verify DataSet (after saga)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/datasets/:id
  body: none
  auth: inherit
}

params:path {
  id: {{sagaDataSetId}}
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Status is AVAILABLE", function() {
    expect(res.body.dataSetStatus).to.equal("AVAILABLE");
  });

  test("Saga completed (no pending saga)", function() {
    expect(res.body.pendingSagaType).to.be.null;
  });

  test("Public URL is set", function() {
    expect(res.body.publicUrl).to.be.a('string').that.is.not.empty;
  });

  test("Distribution accessUrl is valid (no double-URL concatenation)", function() {
    const dists = res.body.distributions;
    expect(dists).to.be.an('array').that.is.not.empty;
    dists.forEach(function(dist) {
      // accessUrl should start with the publicUrl, not contain a second http://
      const afterPublic = dist.accessUrl.replace(res.body.publicUrl, '');
      expect(afterPublic).to.not.match(/^https?:\/\//);
    });
  });
}
