meta {
  name: 3. Create Role (DATA)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/roles
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Saga Test Data Role",
    "description": "Data role for saga workflow test",
    "roleType": "DATA",
    "permissionIds": [],
    "readonly": false
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaRoleId', res.body.id);
  }
}

