meta {
  name: 3. Create Role (DATA)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/roles
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Saga Test Data Role",
    "description": "Data role for saga workflow test",
    "roleType": "DATA",
    "permissionIds": [],
    "readonly": false
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaRoleId', res.body.id);
  }
}

tests {
  test("Role created or already exists", function() {
    const status = res.getStatus();
    // 201=created, 409=already exists from previous run
    expect(status === 201 || status === 409).to.be.true;
  });
}
