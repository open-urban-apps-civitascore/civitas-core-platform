meta {
  name: 3. Create Role (DATA)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/roles
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Saga Test Data Role",
    "description": "Data role for saga workflow test",
    "roleType": "DATA",
    "permissionIds": [],
    "readonly": false
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar('sagaRoleId', res.body.id);
  }
}

tests {
  test("Role created or already exists", function() {
    const status = res.getStatus();
    // 201=created, 409=already exists from previous run
    expect(status === 201 || status === 409).to.be.true;
  });
}

docs {
  **Saga step 3 of 18** — Prerequisites: create supporting resources before triggering the saga.

  Creates the DATA role ("Saga Test Data Role") that will be bound to the group via a scoped assignment in step 6. DATA roles can be scoped to a specific dataset.

  **Expected Response:** 201 Created, body contains `id`. 409 if the role already existed (idempotent).

  **Post-condition:** Save `sagaRoleId` from `body.id`.

  **System Impact:**

  | Layer | Effect |
  |---|---|
  | Backend | DATA role record created in `portal_backend` DB |
  | Config Adapter | — |
  | External System | — |
}
