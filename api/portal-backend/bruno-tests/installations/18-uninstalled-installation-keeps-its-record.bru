meta {
  name: Read the uninstalled installation back (the record stays)
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/installations/{{flowInstallationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  An uninstall removes the artifacts and keeps the record. The lines of an uninstalled installation
  say what it created, not what exists.
}

script:post-response {
  if (res.status === 200) {
    bru.setVar('flowUninstalledAt', res.body.uninstalledAt);
  }
}

tests {
  test("should return the installation with the time of the uninstall", function() {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar('flowInstallationId'));
    expect(res.body.uninstalledAt).to.be.a('string');
  });

  test("should keep the package and all six artifact lines", function() {
    expect(res.body.packageId).to.equal(bru.getVar('flowPackageId'));
    expect(res.body.artifacts.map(line => line.artifactType)).to.deep.equal(
      ["DATA_STRUCTURE", "DATA_SOURCE", "DATA_SET", "MAPPING", "DATA_SINK", "PIPELINE"]);
  });
}
