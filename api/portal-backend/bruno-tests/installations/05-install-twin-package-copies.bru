meta {
  name: Install another package with the same member (own copy)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/installations
  body: json
  auth: bearer
}

body:json {
  {
    "package": {
      "id": "{{packageId}}_twin",
      "version": "1.0.0",
      "title": "Soil moisture twin (smoke)",
      "members": [
        {
          "kind": "datastructure",
          "urn": "{{memberUrn}}",
          "name": "Soil moisture",
          "content": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "{{memberUrn}}",
            "title": "Soil moisture",
            "$defs": {
              "Reading": {
                "type": "object",
                "properties": {
                  "tensionKpa": { "type": "number" },
                  "measuredAt": { "type": "string", "format": "date-time" }
                },
                "required": ["tensionKpa", "measuredAt"]
              }
            }
          }
        }
      ]
    }
  }
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("should install the twin package", function() {
    expect(res.status).to.equal(201);
    expect(res.body.packageId).to.equal(bru.getVar('packageId') + "_twin");
  });

  test("should create its own copy under a fresh URN, sharing only the origin", function() {
    expect(res.body.artifacts).to.have.lengthOf(1);
    const line = res.body.artifacts[0];
    expect(line.action).to.equal("CREATED");
    expect(line.origin).to.equal(bru.getVar('memberUrn'));
    expect(line.urn).to.not.equal(bru.getVar('installedUrn'));
    expect(line.shellId).to.not.equal(bru.getVar('installedShellId'));
  });
}
