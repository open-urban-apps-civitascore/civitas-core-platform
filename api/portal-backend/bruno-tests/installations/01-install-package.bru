meta {
  name: Install package with one data structure
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/installations
  body: json
  auth: bearer
}

body:json {
  {
    "package": {
      "id": "{{packageId}}",
      "version": "1.0.0",
      "title": "Soil moisture (smoke)",
      "members": [
        {
          "kind": "datastructure",
          "urn": "{{memberUrn}}",
          "name": "Soil moisture",
          "description": "Installed by the installations flow",
          "content": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "{{memberUrn}}",
            "title": "Soil moisture",
            "$defs": {
              "Reading": {
                "type": "object",
                "properties": {
                  "tensionKpa": { "type": "number" },
                  "measuredAt": { "type": "string", "format": "date-time" }
                },
                "required": ["tensionKpa", "measuredAt"]
              }
            }
          }
        }
      ]
    }
  }
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  // A package can be installed only once per instance and there is no uninstall yet, so every
  // run mints its own identities. The flow stays re-runnable; each run leaves one data structure
  // behind in the dev database.
  const runId = Date.now().toString(36);
  bru.setVar('runId', runId);
  bru.setVar('packageId', `urn:core:package:openurbanapps:soil_moisture_${runId}`);
  bru.setVar('memberUrn', `urn:core:standard:openurbanapps:datastructure:environment:soil_moisture:${runId}`);
}

script:post-response {
  if (res.status === 201) {
    bru.setVar('installationId', res.body.id);
    bru.setVar('installedShellId', res.body.artifacts[0].shellId);
    bru.setVar('installedVersionedUrn', res.body.artifacts[0].versionedUrn);
  }
}

tests {
  test("should install the package", function() {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a('string');
    expect(res.body.packageId).to.equal(bru.getVar('packageId'));
    expect(res.body.packageVersion).to.equal("1.0.0");
  });

  test("should record one created data structure", function() {
    expect(res.body.artifacts).to.have.lengthOf(1);
    const line = res.body.artifacts[0];
    expect(line.artifactType).to.equal("DATA_STRUCTURE");
    expect(line.action).to.equal("CREATED");
    expect(line.urn).to.equal(bru.getVar('memberUrn'));
    expect(line.versionedUrn).to.have.string(bru.getVar('memberUrn') + ":");
    expect(line.shellId).to.be.a('string');
  });
}
