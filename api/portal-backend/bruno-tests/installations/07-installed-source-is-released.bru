meta {
  name: Read the installed data source back (released, linked, in the pool)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/datasources/{{installedSourceId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("should be released, so a pipeline can link it", function() {
    expect(res.status).to.equal(200);
    expect(res.body.dataSourceStatus).to.equal("AVAILABLE");
  });

  test("should be scoped to a specific datapool, the one the install named", function() {
    expect(res.body.datapoolScope.type).to.equal("SPECIFIC");
  });
}
