meta {
  name: Same Mapping URN, changed content → 409
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/imports/datasets
  body: json
  auth: bearer
}

body:json {
  {
    "name": "Bruno Flow Mapping Konflikt",
    "description": "Same mappingUrn as 07 but a different transform",
    "dataStructures": [],
    "dataSources": [],
    "mappings": [
      {
        "name": "Bruno Flow Mapping",
        "mappingUrn": "urn:core:standard:openurbanapps:mapping:test:brunoflow:r{{runId}}",
        "document": {
          "title": "Bruno Flow Mapping",
          "source": "urn:core:standard:openurbanapps:datastructure:test:brunomapsource:r{{runId}}",
          "target": "urn:core:standard:openurbanapps:datastructure:test:brunobundle:r{{runId}}",
          "fields": {
            "$.count": { "op": "toFloat", "input": "$.value" }
          }
        }
      }
    ]
  }
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("refuses to silently overwrite an installed mapping", function() {
    expect(res.status).to.equal(409);
    expect(res.body.detail).to.include('already installed with different content');
  });
}

docs {
  The turnstile, mirroring the data-structure rule: one authored URN means one
  document. Changing the transform under the same identity is an UPDATE, and
  updating an installed bundle is a separate flow that does not exist yet — so
  it must fail loudly rather than quietly bump the artifact's version.

  Note the granularity: the comparison covers the whole document, title and
  editor positions included. A cosmetically edited catalogue entry lands here
  too, not just a changed transform.

  Depends on 07.
}
