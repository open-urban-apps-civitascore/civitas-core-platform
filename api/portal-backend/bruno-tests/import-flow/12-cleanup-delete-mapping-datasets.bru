meta {
  name: Cleanup — delete mapping dataset (07)
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/datasets/{{mappingDataSetId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("mapping dataset shell removed", function() {
    expect([200, 204]).to.include(res.status);
  });
}

docs {
  The mapping increment adds two more dataset shells to clean up (07 and 08 —
  every import creates one). Deleting a dataset drops its manifest and the
  membership edges; the mapping artifact itself survives, which is what makes
  it reusable by the next bundle in the first place.
}
