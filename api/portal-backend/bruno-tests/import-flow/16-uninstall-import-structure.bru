meta {
  name: Uninstall setup — import a structure with catalogue identity
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/imports/datastructures
  body: json
  auth: bearer
}

body:json {
  {
    "name": "Bruno Uninstall Struktur",
    "description": "Created only to be uninstalled again",
    "catalogEntryId": "urn:openurbanapps:datastructure:brunouninstall:r{{runId}}",
    "catalogEntryVersion": "1.0.0",
    "model": {
      "$id": "urn:core:standard:openurbanapps:datastructure:test:brunouninstall:r{{runId}}",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "value": { "type": "number" }
      }
    }
  }
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("structure imported", function() {
    expect(res.status).to.equal(201);
  });
}

docs {
  Setup for the uninstall slice (17-19). The catalogEntryId is how 17 finds the
  installation record — the single-structure import response carries no
  installationId, which is a known gap, not a feature.
}
