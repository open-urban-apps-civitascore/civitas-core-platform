meta {
  name: Import without $id → 400
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/imports/datastructures
  body: json
  auth: bearer
}

body:json {
  {
    "name": "Bruno Flow ohne Identität",
    "description": "Model without $id must be rejected",
    "model": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "value": { "type": "number" }
      }
    }
  }
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("guard demands a :datastructure: URN as $id", function() {
    expect(res.status).to.equal(400);
    expect(res.body.detail).to.include("$id");
  });
}

docs {
  Without a :datastructure: $id the registry would type the model as a plain
  Element — re-imports would mint fresh identities (duplicates) instead of
  versioning. The guard must reject this before anything is created.
}
