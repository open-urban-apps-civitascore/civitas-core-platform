meta {
  name: Bundle with pipelines → 400 (not yet supported)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/imports/datasets
  body: json
  auth: bearer
}

body:json {
  {
    "name": "Bruno Flow Zukunftsbundle",
    "description": "Pipelines are not supported by the import yet",
    "dataStructures": [],
    "dataSources": [],
    "pipelines": [
      { "name": "noch nicht unterstützt" }
    ]
  }
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("explicitly rejects not-yet-supported parts", function() {
    expect(res.status).to.equal(400);
    expect(res.body.detail).to.include('not yet supported');
  });
}

docs {
  Honest 400 instead of silently dropping bundle parts. Mappings graduated out
  of this test when their increment landed (see 07-10); pipelines and dataSinks
  wait for theirs. When the pipeline increment lands, this test is the reminder
  to flip the expectation again — keep it pointing at whatever is still
  unsupported rather than deleting it.
}
