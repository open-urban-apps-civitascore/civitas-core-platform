meta {
  name: Bundle with mappings → 400 (increment 1)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/imports/datasets
  body: json
  auth: bearer
}

body:json {
  {
    "name": "Bruno Flow Zukunftsbundle",
    "description": "Mappings are not part of increment 1",
    "dataStructures": [],
    "dataSources": [],
    "mappings": [
      { "name": "noch nicht unterstützt" }
    ]
  }
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("explicitly rejects not-yet-supported parts", function() {
    expect(res.status).to.equal(400);
    expect(res.body.detail).to.include('not yet supported');
  });
}

docs {
  Honest 400 instead of silently dropping bundle parts: mappings, pipelines
  and dataSinks wait for their increments. When increment 2 lands, this test
  is the reminder to flip the expectation.
}
