meta {
  name: Create Group
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/groups
  body: json
  auth: bearer
}

body:json {
  {
    "name": "Test Flow Group",
    "description": "Created by test flow"
  }
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.status === 201 || res.status === 200) {
    bru.setVar('createdGroupId', res.body.id);
  }
}

tests {
  test("should create group", function() {
    expect(res.status).to.be.oneOf([200, 201]);
    expect(res.body.id).to.be.a('string');
    expect(res.body.name).to.equal("Test Flow Group");
  });
}
