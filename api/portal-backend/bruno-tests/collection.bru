script:pre-request {
  const axios = require('axios');

  const existingToken = bru.getVar('accessToken');
  const tokenExpiry = bru.getVar('tokenExpiry');
  if (existingToken && tokenExpiry && Date.now() < tokenExpiry) {
    return;
  }

  const tokenUrl = `${bru.getEnvVar('keycloakUrl')}/realms/${bru.getEnvVar('realm')}/protocol/openid-connect/token`;

  const body = [
    `grant_type=password`,
    `client_id=${bru.getEnvVar('clientId')}`,
    `client_secret=${bru.getEnvVar('clientSecret')}`,
    `username=${bru.getEnvVar('username')}`,
    `password=${bru.getEnvVar('password')}`
  ].join('&');

  try {
    const res = await axios.post(tokenUrl, body, {
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
    });

    bru.setVar('accessToken', res.data.access_token);
    bru.setVar('tokenExpiry', Date.now() + (res.data.expires_in - 30) * 1000);
  } catch (error) {
    const status = error.response ? error.response.status : 'no response';
    const detail = error.response ? JSON.stringify(error.response.data) : error.message;
    throw new Error(`Token fetch failed (${status}): ${detail}`);
  }
}
