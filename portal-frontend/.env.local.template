# Auth.js Configuration
NEXT_AUTH_URL=http://localhost:3000
NEXT_SERVER_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-this-in-production

# Keycloak Configuration
# IMPORTANT: The KEYCLOAK_ISSUER uses the hostname "civitas-keycloak" instead of "localhost"
# so that the JWT issuer claim matches across all services (browser, APISIX, backend).
# You MUST add the following entry to your /etc/hosts file:
#
#   127.0.0.1 civitas-keycloak
#
# Without this entry, Keycloak authentication will fail.
KEYCLOAK_CLIENT_ID=portal-frontend
KEYCLOAK_CLIENT_SECRET=dev-only-portal-frontend-secret
KEYCLOAK_ISSUER=http://civitas-keycloak:8080/realms/civitas-core

# JSON Server (mock backend, will be removed)
JSON_SERVER_HOST=http://localhost
JSON_SERVER_PORT=3001
NEXT_PUBLIC_JSON_SERVER_HOST=http://localhost
NEXT_PUBLIC_JSON_SERVER_PORT=3001

# APISIX Gateway URL
# The BFF proxy (src/app/api/[...path]/route.ts) forwards API requests here.
# APISIX validates the JWT and forwards to the backend.
# Team 3: In k8s, point this to the APISIX service (e.g., http://apisix:9080)
API_BASE_URL=http://localhost
API_PORT=9080

# E2E Test User Configuration
E2E_USERNAME=
E2E_PASSWORD=
E2E_EMAIL=
E2E_FIRSTNAME=
E2E_LASTNAME=

E2E_TEST_ENV=dev