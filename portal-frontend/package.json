{
  "name": "civitas-core-v2-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:core-types": "node scripts/generate-core-types.mjs && prettier --write \"src/generated/core/**/*.ts\"",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "postinstall": "[ -f json-server/db.json ] || [ ! -f json-server/db.seed.json ] || cp json-server/db.seed.json json-server/db.json",
    "json-server": "source .env.local && npx json-server json-server/db.json -p $JSON_SERVER_PORT",
    "json-server:reset": "cp json-server/db.seed.json json-server/db.json",
    "fetch-design-tokens": "npx shadcn@latest add https://rdhlrr8yducbb6dq.public.blob.vercel-storage.com/figma-to-shadcn/v4-variables-874296775744998506-9vlyIlh2ztIwRvlO8zaz1JlkduI51J.json"
