{
  "$schema": "https://civitasconnect.digital/core/mapping/v1",
  "id": "urn:core:platform:civitas:mapping:common:dc96112c-42be-8afe-8971-c8f0c378f892:1.0.0",
  "title": "Sensor Reading to Observation",
  "description": "Maps raw sensor telemetry into the normalized observation model.",
  "source": "urn:core:platform:civitas:element:common:0062782c-5353-87ad-b8d4-c1b90ed9b00a:1.0.0",
  "target": "urn:core:platform:civitas:element:common:4560fbf9-5824-85f9-b58f-5e1049048f42:1.0.0",
  "fields": {
    "id": {
      "op": "copy",
      "input": "$.sensorId"
    },
    "observedAt": {
      "op": "copy",
      "input": "$.timestamp"
    },
    "value": {
      "op": "copy",
      "input": "$.pm25"
    },
    "unit": {
      "op": "const",
      "value": "ug/m3"
    }
  }
}
