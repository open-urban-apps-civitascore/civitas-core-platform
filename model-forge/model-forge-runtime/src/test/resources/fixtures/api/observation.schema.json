{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:core:platform:civitas:element:common:4560fbf9-5824-85f9-b58f-5e1049048f42:1.0.0",
  "title": "Observation",
  "description": "A normalized urban observation derived from raw sensor telemetry.",
  "type": "object",
  "required": ["id", "observedAt", "value", "unit", "reading"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable observation identifier."
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string"
    },
    "reading": {
      "$ref": "urn:core:platform:civitas:element:common:0062782c-5353-87ad-b8d4-c1b90ed9b00a:1.0.0",
      "description": "The raw sensor reading this observation was derived from."
    }
  }
}
