{
  "name": "@civitasconnect/core-model-forge-types",
  "version": "0.1.0-SNAPSHOT",
  "description": "Zod schemas and TypeScript types for the CIVITAS/CORE Model Forge — DataSource, DataSink, Mapping, Pipeline, DataSet, DataStructure",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "generate": "node generate.mjs",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  },
  "keywords": ["civitasconnect", "civitas-core", "zod", "core-ir", "model-forge"],
  "license": "EUPL-1.2"
}
