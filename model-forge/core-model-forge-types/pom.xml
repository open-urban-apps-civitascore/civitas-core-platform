<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.civitascore</groupId>
    <artifactId>core-model-forge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>core-model-forge-types</artifactId>
  <packaging>pom</packaging>

  <name>CIVITAS/CORE Model Forge - TypeScript / Zod types</name>
  <description>
    TypeScript / Zod artifact types generated from the CORE-IR JSON Schemas. Not a Java module:
    it wraps the npm package so `mvn` regenerates the types from the schemas on every build and
    they can never drift from their source. The npm publish itself stays in the CI publish-npm job.
  </description>

  <properties>
    <!-- No Maven artifact — this module only drives the npm generate/build via node. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <node.version>v22.11.0</node.version>
  </properties>

  <build>
    <plugins>
      <!-- No Java sources here: unbind the parent's Java-oriented build-environment enforcer
           (phase "none" is the standard trick to skip a parent-declared execution). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <!-- Regenerate the Zod/TS types from the runtime JSON Schemas as part of `mvn`, so the
           checked-in output and the published npm package always match their source schemas.
           frontend-maven-plugin downloads its own node (the Maven CI image has none), so the
           build is self-contained. Executions run in declaration order within a phase. -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.1</version>
        <configuration>
          <nodeVersion>${node.version}</nodeVersion>
          <installDirectory>target</installDirectory>
        </configuration>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
            <phase>generate-sources</phase>
          </execution>
          <execution>
            <id>npm-ci</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <arguments>ci</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-generate</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <arguments>run generate</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-build</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <phase>compile</phase>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
