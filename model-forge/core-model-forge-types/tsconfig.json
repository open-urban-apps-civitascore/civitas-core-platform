{
  "compilerOptions": {
    "target": "ES2022",
    // TypeScript 6 deprecates legacy options (e.g. a baseUrl injected by the
    // tsup dts worker); acknowledge the 6.0 deprecations until the 7.0 cleanup.
    "ignoreDeprecations": "6.0",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
