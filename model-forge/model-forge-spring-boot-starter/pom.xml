<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.civitascore</groupId>
    <artifactId>core-model-forge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>core-model-forge-spring-boot-starter</artifactId>
  <packaging>jar</packaging>

  <name>CIVITAS/CORE Model Forge - Spring Boot Starter</name>
  <description>Spring Boot auto-configuration entry point for embedded Model Forge.</description>

  <dependencies>
    <dependency>
      <groupId>de.civitascore</groupId>
      <artifactId>core-model-forge-contract</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>de.civitascore</groupId>
      <artifactId>core-model-forge-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Spring Boot 4 modularized Flyway support: FlywayAutoConfiguration (referenced in this
         starter's @AutoConfiguration ordering) lives here, no longer in spring-boot-autoconfigure. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
