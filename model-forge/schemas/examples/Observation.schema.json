{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id":     "urn:core:platform:civitas:element:common:Observation:1.0.0",
  "title":   "Observation",
  "description": "A normalised observation record stored in the database. Inspired by OGC SensorThings API. Produced by the sensor-to-observation mapping.",
  "type": "object",
  "required": ["id", "result", "phenomenonTime"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique observation ID (derived from sensorId)."
    },
    "result": {
      "type": "number",
      "description": "The measured value (temperature in degrees Celsius)."
    },
    "phenomenonTime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of the measurement."
    },
    "resultQuality": {
      "type": "string",
      "enum": ["good", "suspect", "bad", "unknown"],
      "default": "good",
      "description": "Data quality indicator."
    },
    "source": {
      "type": "string",
      "description": "Origin of the observation, e.g. 'mqtt', 'api', 'manual'."
    },
    "location": {
      "$ref": "urn:core:platform:civitas:element:common:GeoPoint:1.0.0",
      "description": "Sensor location, if available."
    }
  }
}
