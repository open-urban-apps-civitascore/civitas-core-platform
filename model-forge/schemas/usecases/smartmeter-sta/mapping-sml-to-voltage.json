{
  "$schema": "https://civitasconnect.digital/core-dataset/v1#/$defs/Mapping",
  "id":     "urn:core:platform:civitas:mapping:smartmeter:sml-to-voltage:1.0.0",
  "title":  "SMLReading Spannung → STA Observation",
  "source": "urn:core:platform:civitas:element:smartmeter:SMLReading:1.0.0",
  "target": "urn:core:platform:civitas:element:sta:STAObservation:1.0.0",
  "fields": {
    "phenomenonTime": { "op": "copy", "input": "$.timestamp" },
    "resultTime":     { "op": "copy", "input": "$.timestamp" },
    "result":         { "op": "copy", "input": "$.voltage.value" },
    "resultQuality":  { "op": "copy", "input": "$.voltage.quality" },
    "Datastream.@iot.id": { "op": "copy", "input": "$.frostDatastreamIds.voltage" }
  }
}
