{
  "$schema": "https://civitasconnect.digital/core-dataset/v1#/$defs/Pipeline",
  "id":    "urn:core:platform:civitas:pipeline:smartmeter:Smartmeter-Import:1.0.0",
  "title": "Smart Meter SML Import",
  "debug": false,
  "nodes": [
    {
      "id": "n-start", "kind": "start", "label": "Start",
      "x-ui-position": { "x": 60, "y": 300 }
    },
    {
      "id": "n-source", "kind": "source", "label": "SML MQTT",
      "sourceRef": "urn:core:platform:civitas:datasource:smartmeter:sml-mqtt:1.0.0",
      "x-ui-position": { "x": 220, "y": 300 }
    },
    {
      "id": "n-filter", "kind": "filter", "label": "Plausibilitätsfilter",
      "expression": "$.activePowerPlus.quality != 'bad' && $.voltage.value > 0",
      "x-ui-position": { "x": 400, "y": 300 }
    },
    {
      "id": "n-enrich", "kind": "enrich", "label": "Zählerstammdaten anreichern",
      "lookupSourceRef": "urn:core:platform:civitas:datasource:smartmeter:meter-db:1.0.0",
      "lookupKey": "$.meterId",
      "x-ui-position": { "x": 580, "y": 300 }
    },
    {
      "id": "n-map-p-plus", "kind": "mapping", "label": "Wirkleistung Bezug",
      "mappingRef": "urn:core:platform:civitas:mapping:smartmeter:sml-to-activepowerplus:1.0.0",
      "x-ui-position": { "x": 780, "y": 140 }
    },
    {
      "id": "n-map-p-minus", "kind": "mapping", "label": "Wirkleistung Lieferung",
      "mappingRef": "urn:core:platform:civitas:mapping:smartmeter:sml-to-activepowerminus:1.0.0",
      "x-ui-position": { "x": 780, "y": 300 }
    },
    {
      "id": "n-map-voltage", "kind": "mapping", "label": "Spannung",
      "mappingRef": "urn:core:platform:civitas:mapping:smartmeter:sml-to-voltage:1.0.0",
      "x-ui-position": { "x": 780, "y": 460 }
    },
    {
      "id": "n-sink-p-plus", "kind": "sink", "label": "FROST Wirkleistung Bezug",
      "sinkRef": "urn:core:platform:civitas:datasink:smartmeter:frost-observations:1.0.0",
      "x-ui-position": { "x": 980, "y": 140 }
    },
    {
      "id": "n-sink-p-minus", "kind": "sink", "label": "FROST Wirkleistung Lieferung",
      "sinkRef": "urn:core:platform:civitas:datasink:smartmeter:frost-observations:1.0.0",
      "x-ui-position": { "x": 980, "y": 300 }
    },
    {
      "id": "n-sink-voltage", "kind": "sink", "label": "FROST Spannung",
      "sinkRef": "urn:core:platform:civitas:datasink:smartmeter:frost-observations:1.0.0",
      "x-ui-position": { "x": 980, "y": 460 }
    },
    {
      "id": "n-end", "kind": "end", "label": "End",
      "x-ui-position": { "x": 1160, "y": 300 }
    }
  ],
  "edges": [
    { "id": "e-start-src",       "source": "n-start",      "target": "n-source",     "kind": "control" },
    { "id": "e-src-filter",      "source": "n-source",     "target": "n-filter",     "kind": "data"    },
    { "id": "e-filter-enrich",   "source": "n-filter",     "target": "n-enrich",     "kind": "data"    },
    { "id": "e-enrich-p-plus",   "source": "n-enrich",     "target": "n-map-p-plus", "kind": "data"    },
    { "id": "e-enrich-p-minus",  "source": "n-enrich",     "target": "n-map-p-minus","kind": "data"    },
    { "id": "e-enrich-voltage",  "source": "n-enrich",     "target": "n-map-voltage","kind": "data"    },
    { "id": "e-p-plus-sink",     "source": "n-map-p-plus", "target": "n-sink-p-plus","kind": "data"    },
    { "id": "e-p-minus-sink",    "source": "n-map-p-minus","target": "n-sink-p-minus","kind": "data"   },
    { "id": "e-voltage-sink",    "source": "n-map-voltage","target": "n-sink-voltage","kind": "data"   },
    { "id": "e-sink1-end",       "source": "n-sink-p-plus","target": "n-end",        "kind": "control" },
    { "id": "e-sink2-end",       "source": "n-sink-p-minus","target": "n-end",       "kind": "control" },
    { "id": "e-sink3-end",       "source": "n-sink-voltage","target": "n-end",       "kind": "control" }
  ]
}
