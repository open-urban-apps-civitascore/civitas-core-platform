{
  "$schema": "https://civitasconnect.digital/core-dataset/v1#/$defs/Pipeline",
  "id": "urn:core:platform:civitas:pipeline:taf10-grid:TAF10-Grid-Protection:1.0.0",
  "title": "TAF10 Low-Voltage Grid Protection",
  "debug": false,
  "nodes": [
    {
      "id": "n-start",
      "kind": "start",
      "label": "Start",
      "x-ui-position": { "x": 60, "y": 320 }
    },
    {
      "id": "n-source",
      "kind": "source",
      "label": "TAF10 MQTT",
      "sourceRef": "urn:core:platform:civitas:datasource:taf10-grid:taf10-mqtt:1.0.0",
      "x-ui-position": { "x": 220, "y": 320 }
    },
    {
      "id": "n-quality-filter",
      "kind": "filter",
      "label": "Plausibilitaet",
      "expression": "$.activePowerPlus.quality != 'bad' && $.activePowerMinus.quality != 'bad' && $.voltage.quality != 'bad'",
      "x-ui-position": { "x": 400, "y": 320 }
    },
    {
      "id": "n-enrich",
      "kind": "enrich",
      "label": "Grid-Node Stammdaten",
      "lookupSourceRef": "urn:core:platform:civitas:datasource:taf10-grid:gridnode-db:1.0.0",
      "lookupKey": "$.gridNodeId",
      "x-ui-position": { "x": 600, "y": 320 }
    },
    {
      "id": "n-map-p-plus",
      "kind": "mapping",
      "label": "Wirkleistung Bezug",
      "mappingRef": "urn:core:platform:civitas:mapping:taf10-grid:taf10-to-activepowerplus:1.0.0",
      "x-ui-position": { "x": 830, "y": 100 }
    },
    {
      "id": "n-map-p-minus",
      "kind": "mapping",
      "label": "Wirkleistung Einspeisung",
      "mappingRef": "urn:core:platform:civitas:mapping:taf10-grid:taf10-to-activepowerminus:1.0.0",
      "x-ui-position": { "x": 830, "y": 260 }
    },
    {
      "id": "n-map-voltage",
      "kind": "mapping",
      "label": "Spannung",
      "mappingRef": "urn:core:platform:civitas:mapping:taf10-grid:taf10-to-voltage:1.0.0",
      "x-ui-position": { "x": 830, "y": 420 }
    },
    {
      "id": "n-load-filter",
      "kind": "filter",
      "label": "Lastpeak",
      "expression": "$.activePowerPlus.value > $.maxLoadW",
      "x-ui-position": { "x": 830, "y": 580 }
    },
    {
      "id": "n-map-load-shift",
      "kind": "mapping",
      "label": "Lastverschiebung",
      "mappingRef": "urn:core:platform:civitas:mapping:taf10-grid:taf10-to-load-shift-action:1.0.0",
      "x-ui-position": { "x": 1060, "y": 580 }
    },
    {
      "id": "n-sink-load-shift",
      "kind": "sink",
      "label": "Grid Control Lastverschiebung",
      "sinkRef": "urn:core:platform:civitas:datasink:taf10-grid:grid-control-actions:1.0.0",
      "x-ui-position": { "x": 1280, "y": 580 }
    },
    {
      "id": "n-feedin-filter",
      "kind": "filter",
      "label": "Einspeisepeak",
      "expression": "$.activePowerMinus.value > $.maxFeedInW",
      "x-ui-position": { "x": 830, "y": 740 }
    },
    {
      "id": "n-map-feedin-curtail",
      "kind": "mapping",
      "label": "PV-Abregelung",
      "mappingRef": "urn:core:platform:civitas:mapping:taf10-grid:taf10-to-feedin-curtail-action:1.0.0",
      "x-ui-position": { "x": 1060, "y": 740 }
    },
    {
      "id": "n-sink-feedin-curtail",
      "kind": "sink",
      "label": "Grid Control PV-Abregelung",
      "sinkRef": "urn:core:platform:civitas:datasink:taf10-grid:grid-control-actions:1.0.0",
      "x-ui-position": { "x": 1280, "y": 740 }
    },
    {
      "id": "n-voltage-band-filter",
      "kind": "filter",
      "label": "Spannungsbandverletzung",
      "expression": "$.voltage.value < $.voltageMinV || $.voltage.value > $.voltageMaxV",
      "x-ui-position": { "x": 830, "y": 900 }
    },
    {
      "id": "n-map-voltage-notify",
      "kind": "mapping",
      "label": "Betreiberbenachrichtigung",
      "mappingRef": "urn:core:platform:civitas:mapping:taf10-grid:taf10-to-voltage-notify-action:1.0.0",
      "x-ui-position": { "x": 1060, "y": 900 }
    },
    {
      "id": "n-sink-voltage-notify",
      "kind": "sink",
      "label": "Grid Control Benachrichtigung",
      "sinkRef": "urn:core:platform:civitas:datasink:taf10-grid:grid-control-actions:1.0.0",
      "x-ui-position": { "x": 1280, "y": 900 }
    },
    {
      "id": "n-sink-p-plus",
      "kind": "sink",
      "label": "FROST Bezug",
      "sinkRef": "urn:core:platform:civitas:datasink:taf10-grid:frost-observations:1.0.0",
      "x-ui-position": { "x": 1060, "y": 100 }
    },
    {
      "id": "n-sink-p-minus",
      "kind": "sink",
      "label": "FROST Einspeisung",
      "sinkRef": "urn:core:platform:civitas:datasink:taf10-grid:frost-observations:1.0.0",
      "x-ui-position": { "x": 1060, "y": 260 }
    },
    {
      "id": "n-sink-voltage",
      "kind": "sink",
      "label": "FROST Spannung",
      "sinkRef": "urn:core:platform:civitas:datasink:taf10-grid:frost-observations:1.0.0",
      "x-ui-position": { "x": 1060, "y": 420 }
    },
    {
      "id": "n-end",
      "kind": "end",
      "label": "End",
      "x-ui-position": { "x": 1500, "y": 320 }
    }
  ],
  "edges": [
    { "id": "e-start-src", "source": "n-start", "target": "n-source", "kind": "control" },
    { "id": "e-src-quality", "source": "n-source", "target": "n-quality-filter", "kind": "data" },
    { "id": "e-quality-enrich", "source": "n-quality-filter", "target": "n-enrich", "kind": "data" },
    { "id": "e-enrich-p-plus", "source": "n-enrich", "target": "n-map-p-plus", "kind": "data" },
    { "id": "e-enrich-p-minus", "source": "n-enrich", "target": "n-map-p-minus", "kind": "data" },
    { "id": "e-enrich-voltage", "source": "n-enrich", "target": "n-map-voltage", "kind": "data" },
    { "id": "e-enrich-load", "source": "n-enrich", "target": "n-load-filter", "kind": "data" },
    { "id": "e-enrich-feedin", "source": "n-enrich", "target": "n-feedin-filter", "kind": "data" },
    { "id": "e-enrich-voltage-band", "source": "n-enrich", "target": "n-voltage-band-filter", "kind": "data" },
    { "id": "e-p-plus-sink", "source": "n-map-p-plus", "target": "n-sink-p-plus", "kind": "data" },
    { "id": "e-p-minus-sink", "source": "n-map-p-minus", "target": "n-sink-p-minus", "kind": "data" },
    { "id": "e-voltage-sink", "source": "n-map-voltage", "target": "n-sink-voltage", "kind": "data" },
    { "id": "e-load-map", "source": "n-load-filter", "target": "n-map-load-shift", "kind": "data" },
    { "id": "e-load-sink", "source": "n-map-load-shift", "target": "n-sink-load-shift", "kind": "data" },
    { "id": "e-feedin-map", "source": "n-feedin-filter", "target": "n-map-feedin-curtail", "kind": "data" },
    { "id": "e-feedin-sink", "source": "n-map-feedin-curtail", "target": "n-sink-feedin-curtail", "kind": "data" },
    { "id": "e-voltage-band-map", "source": "n-voltage-band-filter", "target": "n-map-voltage-notify", "kind": "data" },
    { "id": "e-voltage-band-sink", "source": "n-map-voltage-notify", "target": "n-sink-voltage-notify", "kind": "data" },
    { "id": "e-sink1-end", "source": "n-sink-p-plus", "target": "n-end", "kind": "control" },
    { "id": "e-sink2-end", "source": "n-sink-p-minus", "target": "n-end", "kind": "control" },
    { "id": "e-sink3-end", "source": "n-sink-voltage", "target": "n-end", "kind": "control" },
    { "id": "e-sink4-end", "source": "n-sink-load-shift", "target": "n-end", "kind": "control" },
    { "id": "e-sink5-end", "source": "n-sink-feedin-curtail", "target": "n-end", "kind": "control" },
    { "id": "e-sink6-end", "source": "n-sink-voltage-notify", "target": "n-end", "kind": "control" }
  ]
}
