{
  "$schema": "https://civitasconnect.digital/core-dataset/v1#/$defs/Mapping",
  "id": "urn:core:platform:civitas:mapping:taf10-grid:7913259f-ace7-88aa-b5ab-41acfbc3fe29:1.0.0",
  "title": "TAF10 Load Peak -> SwitchingAction (shift controllable load)",
