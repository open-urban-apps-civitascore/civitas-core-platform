{
  "$schema": "https://civitasconnect.digital/core-dataset/v1#/$defs/Mapping",
  "id": "urn:core:platform:civitas:mapping:taf10-grid:taf10-to-switching-action:1.0.0",
  "title": "TAF10 Threshold Violation -> SwitchingAction",
  "source": "urn:core:platform:civitas:element:taf10-grid:TAF10GridReading:1.0.0",
  "target": "urn:core:platform:civitas:element:taf10-grid:SwitchingAction:1.0.0",
  "fields": {
    "gridNodeId": { "op": "copy", "input": "$.gridNodeId" },
    "requestedAt": { "op": "copy", "input": "$.timestamp" },
    "actionType": { "op": "const", "value": "curtail-pv-feed-in" },
    "reason": { "op": "const", "value": "TAF10 threshold violation: load peak, feed-in peak, or voltage-band violation" },
    "priority": { "op": "const", "value": "high" },
    "measuredActivePowerPlusW": { "op": "copy", "input": "$.activePowerPlus.value" },
    "measuredActivePowerMinusW": { "op": "copy", "input": "$.activePowerMinus.value" },
    "measuredVoltageV": { "op": "copy", "input": "$.voltage.value" }
  }
}
